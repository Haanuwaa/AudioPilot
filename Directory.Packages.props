<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
    <PackageVersion Include="NAudio.Wasapi" Version="3.2.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.13" />
    <PackageVersion Include="System.Management" Version="10.0.13" />
    <!-- Use the .NET 10 Tensors primitives with NAudio.Core's minimum-version dependency. -->
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.13" />
    <PackageVersion Include="WixToolset.UI.wixext" Version="7.0.0" />
    <PackageVersion Include="WixToolset.Util.wixext" Version="7.0.0" />
    <!-- Test-tooling servicing overrides; these are not shipped with AudioPilot. -->
    <PackageVersion Include="Microsoft.DiaSymReader" Version="2.2.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
