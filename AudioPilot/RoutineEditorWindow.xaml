<Window
    x:Class="AudioPilot.RoutineEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:AudioPilot.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:models="clr-namespace:AudioPilot.Models"
    Title="Routine Editor"
    FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
    Width="604"
    Height="680"
    MinWidth="440"
    MinHeight="480"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}"
    FocusManager.FocusedElement="{Binding ElementName=RoutineNameTextBox}"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="Manual">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="OpenHelp_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="ApplicationCommands.Help" />
    </Window.InputBindings>
    <Window.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/RoutineEditorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ContextMenu x:Key="HotkeyDeleteContextMenu" Style="{DynamicResource AppContextMenuStyle}">
                <MenuItem
                    Click="ClearHotkeyText_Click"
                    Header="_Delete"
                    Icon="{StaticResource AppMenuDeleteIcon}"
                    InputGestureText="Del"
                    Style="{DynamicResource AppContextMenuItemStyle}" />
            </ContextMenu>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="RoutineEditorScrollViewer"
            Grid.Row="0"
            CanContentScroll="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <i:Interaction.Behaviors>
                <b:KeyboardFocusScrollBehavior />
            </i:Interaction.Behaviors>
            <StackPanel Margin="0,0,12,0">
                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="Routine Editor" />

                <TextBlock
                    MaxWidth="450"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource MutedTextBrush}"
                    Text="Choose audio actions, then when this routine should run."
                    TextWrapping="Wrap" />

                <StackPanel MaxWidth="450" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Routine name" />
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding RoutineNameCharactersRemainingText}" />
                    </Grid>
                    <TextBox
                        x:Name="RoutineNameTextBox"
                        MaxWidth="450"
                        Height="32"
                        AutomationProperties.Name="Routine name"
                        ContextMenu="{StaticResource EditableTextContextMenu}"
                        MaxLength="{x:Static models:AudioRoutine.MaxNameLength}"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock MaxWidth="450" Margin="0,0,0,8" FontWeight="SemiBold" Text="What changes" />
                <StackPanel MaxWidth="450" Margin="0,0,0,10">
                    <TextBlock Margin="0,0,0,4" Text="Route devices for" />
                    <ComboBox x:Name="RoutingScopeBox" Height="32" AutomationProperties.Name="Device routing scope" SelectedIndex="{Binding RoutingScopeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="System defaults" />
                        <ComboBoxItem x:Name="ApplicationRoutingOption" Content="An application" IsEnabled="{Binding CanRoutePerApp}">
                            <i:Interaction.Behaviors>
                                <b:HoverInfoPopupBehavior Text="Clear communications targets before choosing application routing." />
                            </i:Interaction.Behaviors>
                        </ComboBoxItem>
                    </ComboBox>
                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                               Text="Device routing applies to this app. Volume and mute affect the whole device."
                               Visibility="{Binding RouteToApplication, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding RouteToApplication, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Margin="0,0,0,4" Text="Target application (.exe path or AUMID)" />
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                            <TextBox Height="32" MinWidth="0" b:TextBoxPlaceholderBehavior.Text="e.g. C:\Apps\Game\Game.exe" AutomationProperties.Name="Routing target application" ContextMenu="{StaticResource EditableTextContextMenu}" Text="{Binding TargetAppPath, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Grid.Row="1" Margin="0,6,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Button Height="32" Margin="0" Padding="12,0" Tag="Action" Content="Browse" Click="BrowseExecutable_Click" AutomationProperties.Name="Browse routing target application" />
                                <Button Height="32" Margin="8,0,0,0" Padding="12,0" Tag="Action" Content="Pick App" Click="PickPackagedApp_Click" AutomationProperties.Name="Pick packaged routing target application" />
                            </StackPanel>
                            <TextBlock x:Name="ResolvedRoutingApplicationText" Grid.Row="2" Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding HasResolvedRoutingApplication, Converter={StaticResource BoolToVisibilityConverter}}"><Run Text="Resolved app: " /><Run Text="{Binding ResolvedRoutingApplicationName, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" /></TextBlock>
                        </Grid>
                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="The app must be running." TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel MaxWidth="450" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                    <TextBlock Margin="0,0,0,4" Text="Playback target" />
                    <ComboBox
                        MaxWidth="450"
                        Height="32"
                        AutomationProperties.Name="Output target"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding OutputDevices}"
                        SelectedIndex="{Binding SelectedOutputIndex, Mode=TwoWay}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource MutedTextBrush}"
                        Text="This device is unavailable. The routine will keep this target."
                        TextWrapping="Wrap"
                        Visibility="{Binding IsSelectedOutputUnavailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel MaxWidth="450" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                    <TextBlock Margin="0,0,0,4" Text="Microphone target" />
                    <ComboBox
                        MaxWidth="450"
                        Height="32"
                        AutomationProperties.Name="Input target"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding InputDevices}"
                        SelectedIndex="{Binding SelectedInputIndex, Mode=TwoWay}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource MutedTextBrush}"
                        Text="This device is unavailable. The routine will keep this target."
                        TextWrapping="Wrap"
                        Visibility="{Binding IsSelectedInputUnavailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <Expander x:Name="CommunicationsExpander" MaxWidth="450" Margin="0,0,0,10"
                          IsExpanded="{Binding IsCommunicationsExpanded, Mode=TwoWay}"
                          IsEnabled="{Binding IsSystemRouting}"
                          Style="{StaticResource AppExpanderStyle}">
                    <i:Interaction.Behaviors>
                        <b:HoverInfoPopupBehavior Text="Communications targets require System defaults routing." />
                    </i:Interaction.Behaviors>
                    <Expander.Header><StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Communications devices" />
                            <TextBlock Text="{Binding CommunicationsSummary}" Style="{StaticResource RoutineSectionSummaryStyle}">
                                <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding CommunicationsSummary}" /></i:Interaction.Behaviors>
                            </TextBlock>
                        </StackPanel></Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Margin="0,0,0,10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                   Text="Optional devices for calls. Leave unchanged to keep the current device.">
                            <i:Interaction.Behaviors>
                                <b:HoverInfoPopupBehavior Text="Applications must follow Windows communications defaults to use these devices." />
                            </i:Interaction.Behaviors>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,4" Text="Communications playback" />
                        <ComboBox x:Name="CommunicationsOutputBox" Height="32" DisplayMemberPath="Name"
                                  AutomationProperties.Name="Communications playback target"
                                  ItemsSource="{Binding CommunicationsOutputDevices}" SelectedIndex="{Binding SelectedCommunicationsOutputIndex, Mode=TwoWay}" />
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                   Text="This device is unavailable. The routine will keep this target."
                                   Visibility="{Binding IsSelectedCommunicationsOutputUnavailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Margin="0,10,0,4" Text="Communications microphone" />
                        <ComboBox x:Name="CommunicationsInputBox" Height="32" DisplayMemberPath="Name"
                                  AutomationProperties.Name="Communications microphone target"
                                  ItemsSource="{Binding CommunicationsInputDevices}" SelectedIndex="{Binding SelectedCommunicationsInputIndex, Mode=TwoWay}" />
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                   Text="This device is unavailable. The routine will keep this target."
                                   Visibility="{Binding IsSelectedCommunicationsInputUnavailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                   Text="Volume and mute below apply to the main playback/microphone targets.">
                            <i:Interaction.Behaviors>
                                <b:HoverInfoPopupBehavior Text="Communications devices require System defaults routing. They do not have separate volume or mute actions." />
                            </i:Interaction.Behaviors>
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <Expander x:Name="VolumeTargetsExpander"
                    MaxWidth="450"
                    Margin="0,0,0,10"
                    IsExpanded="{Binding IsVolumeTargetsExpanded, Mode=TwoWay}"
                    Style="{StaticResource AppExpanderStyle}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Volume and mute" />
                            <TextBlock Text="{Binding VolumeTargetsSummary}" Style="{StaticResource RoutineSectionSummaryStyle}">
                                <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding VolumeTargetsSummary}" /></i:Interaction.Behaviors>
                            </TextBlock>
                        </StackPanel>
                    </Expander.Header>

                    <StackPanel
                        MaxWidth="450"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch">
                        <TextBlock
                            Margin="0,0,0,10"
                            Foreground="{DynamicResource MutedTextBrush}"
                            Text="Device-wide volume and mute use the selected devices or current defaults. Blank levels stay unchanged."
                            TextWrapping="Wrap">
                            <i:Interaction.Behaviors>
                                <b:HoverInfoPopupBehavior Text="Volume and mute are independent. These actions affect the whole device even when routing an application." />
                            </i:Interaction.Behaviors>
                        </TextBlock>

                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Label
                                Width="150"
                                VerticalAlignment="Center"
                                Content="Master output level:" />
                            <TextBox
                                Width="80"
                                Height="32"
                                MinWidth="80"
                                AutomationProperties.Name="Master output level percent"
                                Padding="6,0"
                                VerticalContentAlignment="Center"
                                b:TextBoxPlaceholderBehavior.Text="50"
                                ContextMenu="{StaticResource EditableTextContextMenu}"
                                InputScope="Number"
                                Text="{Binding MasterVolumePercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Behaviors>
                                    <b:IntegerOnlyBehavior />
                                </i:Interaction.Behaviors>
                            </TextBox>
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="%" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Label
                                Width="150"
                                VerticalAlignment="Center"
                                Content="Microphone input level:" />
                            <TextBox
                                Width="80"
                                Height="32"
                                MinWidth="80"
                                AutomationProperties.Name="Microphone input level percent"
                                Padding="6,0"
                                VerticalContentAlignment="Center"
                                b:TextBoxPlaceholderBehavior.Text="50"
                                ContextMenu="{StaticResource EditableTextContextMenu}"
                                InputScope="Number"
                                Text="{Binding MicVolumePercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Behaviors>
                                    <b:IntegerOnlyBehavior />
                                </i:Interaction.Behaviors>
                            </TextBox>
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="%" />
                        </StackPanel>
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="Output mute:" Target="{Binding ElementName=OutputMuteActionBox}" VerticalAlignment="Center" />
                            <ComboBox x:Name="OutputMuteActionBox" Grid.Column="1" Height="32"
                                AutomationProperties.Name="Routine output mute action"
                                ItemsSource="{Binding MuteActions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                SelectedValue="{Binding OutputMuteAction, Mode=TwoWay}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="Microphone mute:" Target="{Binding ElementName=InputMuteActionBox}" VerticalAlignment="Center" />
                            <ComboBox x:Name="InputMuteActionBox" Grid.Column="1" Height="32"
                                AutomationProperties.Name="Routine microphone mute action"
                                ItemsSource="{Binding MuteActions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                SelectedValue="{Binding InputMuteAction, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                            Text="Microphone mute actions are skipped while push-to-talk or hold-to-mute owns the mic. Unmute is also blocked while deafen is on." />
                    </StackPanel>
                </Expander>

                <TextBlock MaxWidth="450" Margin="0,8,0,8" FontWeight="SemiBold" Text="When it runs" />
                <StackPanel x:Name="ManualShortcutsSection" MaxWidth="450" Margin="0,0,0,10">
                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Manual shortcuts" />
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock
                            MaxWidth="450"
                            Margin="0,0,0,8"
                            Foreground="{DynamicResource MutedTextBrush}"
                            Text="Use a hotkey, a tray entry, or both."
                            TextWrapping="Wrap" />
                        <TextBlock Margin="0,0,0,4" Text="Routine hotkey (optional)" />
                        <TextBox
                            MaxWidth="450"
                            Height="32"
                            AutomationProperties.Name="Routine hotkey"
                            ContextMenu="{StaticResource HotkeyDeleteContextMenu}"
                            Text="{Binding EditorHotkey.DisplayText, Mode=OneWay}">
                            <i:Interaction.Behaviors>
                                <b:PlaceholderExampleBehavior
                                    Identity="routine-editor-hotkey"
                                    Options="Ctrl+Alt+R|Alt+MouseX1"
                                    PreferredFamily="letter" />
                                <b:HoverInfoPopupBehavior Text="{Binding EditorHotkey.HoverText}" WarningKind="{Binding EditorHotkey.WarningKind}" />
                                <b:HotkeyCaptureBehavior Target="{Binding EditorHotkey}" />
                                <b:HotkeyWarningBorderBehavior HasWarning="{Binding EditorHotkey.HasWarning}" WarningKind="{Binding EditorHotkey.WarningKind}" />
                            </i:Interaction.Behaviors>
                        </TextBox>
                    </StackPanel>
                    <CheckBox
                        Margin="0,0,0,10"
                        Content="Show this routine in the tray menu"
                        IsChecked="{Binding ShowInTrayMenu, Mode=TwoWay}" />
                    <Expander x:Name="HotkeyCyclingExpander" Margin="0,0,0,10"
                              IsExpanded="{Binding IsHotkeyCyclingExpanded, Mode=TwoWay}" Style="{StaticResource AppExpanderStyle}">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Cycle routines with one hotkey" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HotkeyCyclingSummary}" Style="{StaticResource RoutineSectionSummaryStyle}">
                                    <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding HotkeyCyclingSummary}" /></i:Interaction.Behaviors>
                                </TextBlock>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                        <TextBlock Margin="0,0,0,4" Text="Hotkey cycle group (optional)" />
                        <TextBox Height="32" Margin="0,0,0,6" AutomationProperties.Name="Hotkey cycle group"
                                 b:TextBoxPlaceholderBehavior.Text="e.g. Desk setups" MaxLength="40"
                                 Visibility="{Binding HasHotkeyCycleGroups, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                 Text="{Binding HotkeyCycleGroup, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Height="32" Margin="0,0,0,6" IsEditable="True" IsTextSearchEnabled="False"
                                  b:TextBoxPlaceholderBehavior.Text="Type a group name or select one…"
                                  Visibility="{Binding HasHotkeyCycleGroups, Converter={StaticResource BoolToVisibilityConverter}}"
                                  AutomationProperties.Name="Hotkey cycle group" ItemsSource="{Binding HotkeyCycleGroups}"
                                  Text="{Binding HotkeyCycleGroup, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,0,0,10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                   Text="Use the same group name and hotkey on each routine to cycle between them. Changing the hotkey updates all members."
                                  >
                            <i:Interaction.Behaviors>
                                <b:HoverInfoPopupBehavior Text="Routines cycle in saved order, skipping disabled routines and unmet conditions. Editing the shared hotkey updates all members. Leave the group blank for an individual shortcut." />
                            </i:Interaction.Behaviors>
                        </TextBlock>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <Border x:Name="AutomaticTriggersSection"
                    MaxWidth="476"
                    Margin="0,0,0,10"
                    Padding="12"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel MaxWidth="450" HorizontalAlignment="Stretch">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Automatic triggers" />

                        <TextBlock
                            Margin="0,0,0,8"
                            Foreground="{DynamicResource MutedTextBrush}"
                            Text="Any trigger can start the routine. Manual shortcuts still work."
                            TextWrapping="Wrap" />
                        <ItemsControl x:Name="AutomaticTriggersItems" ItemsSource="{Binding TriggerEntries}" IsEnabled="{Binding CanSaveRoutine}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="8" BorderThickness="1" CornerRadius="4"
                                            BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource WindowBackgroundBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="Edit" Padding="8,4" Click="EditTrigger_Click" AutomationProperties.Name="Edit trigger" AutomationProperties.HelpText="{Binding Summary}" />
                                            <Button Grid.Column="2" Content="Remove" Margin="6,0,0,0" Padding="8,4" Click="RemoveTrigger_Click" AutomationProperties.Name="Remove trigger" AutomationProperties.HelpText="{Binding Summary}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,0,0,8" Text="Optional: add a trigger to run this routine automatically." TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Visibility="{Binding ShowTriggerEmptyState, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button x:Name="NewTriggerButton" Content="Add trigger" HorizontalAlignment="Left" Margin="0,0,0,10"
                                IsEnabled="{Binding CanAddAutomaticTrigger}" Padding="10,4" Click="AddTrigger_Click" />
                        <StackPanel Margin="0,0,0,10" Visibility="{Binding IsStatefulTriggerSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <CheckBox IsChecked="{Binding RestorePreviousAudioOnDeactivate, Mode=TwoWay}">
                                <TextBlock Text="Restore previous audio when this routine deactivates" TextWrapping="Wrap" />
                                <i:Interaction.Behaviors>
                                    <b:HoverInfoPopupBehavior Text="Restores affected default devices, endpoint levels, and mute states after the last active trigger ends. Application routes return to system defaults. Newer manual or routine changes take priority." />
                                </i:Interaction.Behaviors>
                            </CheckBox>
                        </StackPanel>


                    </StackPanel>
                </Border>
                <CheckBox MaxWidth="450" Margin="0,0,0,12"
                          IsChecked="{Binding NotifyOnAutomaticFailure, Mode=TwoWay}">
                    <TextBlock Text="Show Windows notification on automatic action failure" TextWrapping="Wrap" />
                    <i:Interaction.Behaviors>
                        <b:HoverInfoPopupBehavior Text="Optional Windows notification while AudioPilot is hidden, once until recovery. Failures are always recorded in Routines and Diagnostics. Skipped runs, unmet requirements, disconnected targets, and manual runs do not notify." />
                    </i:Interaction.Behaviors>
                </CheckBox>
                <Expander x:Name="ConditionsExpander" MaxWidth="450" Margin="0,0,0,12"
                          IsExpanded="{Binding IsConditionsExpanded, Mode=TwoWay}" Style="{StaticResource AppExpanderStyle}">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Only when… (all must pass)" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ConditionsSummary}" Style="{StaticResource RoutineSectionSummaryStyle}">
                                    <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding ConditionsSummary}" /></i:Interaction.Behaviors>
                                </TextBlock>
                            </StackPanel>
                        </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Margin="0,0,0,10" Foreground="{DynamicResource MutedTextBrush}" Text="Checked when the routine runs, including manual runs. All must pass. Changes to conditions do not end an active routine." TextWrapping="Wrap" />
                        <CheckBox x:Name="RequireTimeWindowBox" Margin="0,0,0,6" Content="Require day and time" IsChecked="{Binding RequireTimeWindow}" />
                        <StackPanel Margin="0,0,0,12" Visibility="{Binding RequireTimeWindow, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Margin="0,0,0,4" Text="Days (leave blank for every day)" />
                            <UniformGrid Columns="4">
                                <CheckBox Content="Sun" Margin="0,0,8,4" IsChecked="{Binding ConditionSunday}" />
                                <CheckBox Content="Mon" Margin="0,0,8,4" IsChecked="{Binding ConditionMonday}" />
                                <CheckBox Content="Tue" Margin="0,0,8,4" IsChecked="{Binding ConditionTuesday}" />
                                <CheckBox Content="Wed" Margin="0,0,8,4" IsChecked="{Binding ConditionWednesday}" />
                                <CheckBox Content="Thu" Margin="0,0,8,4" IsChecked="{Binding ConditionThursday}" />
                                <CheckBox Content="Fri" Margin="0,0,8,4" IsChecked="{Binding ConditionFriday}" />
                                <CheckBox Content="Sat" Margin="0,0,8,4" IsChecked="{Binding ConditionSaturday}" />
                                <CheckBox Content="All day" Margin="0,0,0,4" IsChecked="{Binding ConditionAllDay}">
                                    <i:Interaction.Behaviors>
                                        <b:HoverInfoPopupBehavior Text="Allow any time on the selected days." />
                                    </i:Interaction.Behaviors>
                                </CheckBox>
                            </UniformGrid>
                            <Grid Visibility="{Binding ConditionAllDay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="From (inclusive)" Margin="0,0,0,4" />
                                    <TextBox Height="32" AutomationProperties.Name="Condition start time" Text="{Binding ConditionStart, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Until (exclusive)" Margin="0,0,0,4" />
                                    <TextBox Height="32" AutomationProperties.Name="Condition end time" Text="{Binding ConditionEnd, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </Grid>
                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Use 09:00 or 9:00 AM. Overnight ranges end the next day; select the day they start." TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding ConditionTimeZone}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Margin="0,0,0,6" Content="Require audio device state" IsChecked="{Binding RequireDevice}" />
                        <ComboBox Height="32" Margin="0,0,0,10" b:TextBoxPlaceholderBehavior.Text="Select an audio device…" AutomationProperties.Name="Required audio device"
                                  ItemsSource="{Binding RoutineDeviceChoices}" DisplayMemberPath="DisplayName" IsEnabled="{Binding RequireDevice}"
                                  SelectedItem="{Binding SelectedRequiredDevice, Mode=TwoWay}">
                                <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding SelectedRequiredDevice.DisplayName}" /></i:Interaction.Behaviors>
                            </ComboBox>
                        <ComboBox Height="32" Margin="0,0,0,10" AutomationProperties.Name="Required device state"
                                  ItemsSource="{Binding DeviceRequirementStates}" SelectedIndex="{Binding RequiredDeviceStateIndex}"
                                  IsEnabled="{Binding RequireDevice}">
                            <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="Current default uses AudioPilot's Output/Input detection role from Settings." /></i:Interaction.Behaviors>
                        </ComboBox>
                        <TextBlock Margin="0,0,0,4" Text="Application state (optional)" />
                        <ComboBox Height="32" Margin="0,0,0,8" AutomationProperties.Name="Required application state"
                                  ItemsSource="{Binding ApplicationRequirementStates}" SelectedIndex="{Binding RequiredApplicationStateIndex}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                            <TextBox x:Name="RequiredApplicationTextBox" Height="32" b:TextBoxPlaceholderBehavior.Text="e.g. C:\Apps\Example\Player.exe" AutomationProperties.Name="Required application" ContextMenu="{StaticResource EditableTextContextMenu}" Text="{Binding RequiredApplicationPath, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Button Height="32" Margin="0" Padding="10,4" Content="Browse" Tag="Condition" Click="BrowseExecutable_Click" />
                                <Button Height="32" Margin="8,0,0,0" Padding="10,4" Content="Pick App" Tag="Condition" Click="PickPackagedApp_Click" />
                            </StackPanel>
                            <TextBlock x:Name="ResolvedRequiredApplicationText" Grid.Row="2" Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding HasResolvedRequiredApplication, Converter={StaticResource BoolToVisibilityConverter}}"><Run Text="Resolved app: " /><Run x:Name="ResolvedRequiredApplicationName" Text="{Binding ResolvedRequiredApplicationName, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" /></TextBlock>
                        </Grid>
                        <TextBlock Margin="0,0,0,4" Text="Network state (optional)" />
                        <ComboBox Height="32" Margin="0,0,0,8" AutomationProperties.Name="Required network state"
                                  ItemsSource="{Binding NetworkRequirementStates}" SelectedIndex="{Binding RequiredNetworkStateIndex}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="RequiredNetworkBox" b:TextBoxPlaceholderBehavior.Text="Select or type a network name" Height="32" IsEditable="True" AutomationProperties.Name="Required network"
                                      DropDownOpened="NetworkPicker_DropDownOpened"
                                      ItemsSource="{Binding AvailableNetworkNames}"
                                      SelectedItem="{Binding SelectedRequiredNetworkName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Text="{Binding RequiredNetworkName, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="Select or type a network name, such as a Wi-Fi network or VPN profile. Leave blank for no network requirement." /></i:Interaction.Behaviors>
                            </ComboBox>
                            <Button x:Name="ConditionNetworkRefreshButton" Grid.Column="1" AutomationProperties.Name="Refresh networks" Style="{StaticResource NetworkRefreshButtonStyle}">
                                <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="Refresh networks" /></i:Interaction.Behaviors>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Expander>
                <TextBlock x:Name="NetworkDiscoveryWarningText" Text="{Binding NetworkDiscoveryWarning}" TextWrapping="Wrap" MaxWidth="450" Margin="0,0,0,10" Foreground="{DynamicResource MutedTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NetworkDiscoveryWarning}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Margin="0,12,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel x:Name="EditorFooter">
                <TextBlock x:Name="RoutineSummaryText" Focusable="True" KeyboardNavigation.IsTabStop="True" FocusVisualStyle="{DynamicResource AppFocusVisualStyle}" Text="{Binding EditorSummary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="36" LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource MutedTextBrush}"
                           AutomationProperties.Name="Routine summary">
                    <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding EditorSummary}" /></i:Interaction.Behaviors>
                </TextBlock>
                <ScrollViewer x:Name="ReadinessPanel" MaxHeight="90" Margin="0,8,0,0" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="ReadinessText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="ReadinessCheckedText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" Visibility="Collapsed" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="CheckRoutineButton" Content="Check routine" Click="CheckRoutine_Click"
                            AutomationProperties.HelpText="Check current requirements and targets without saving or changing audio.">
                        <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="Check current requirements and targets without saving or changing audio." /></i:Interaction.Behaviors>
                    </Button>
                    <StackPanel x:Name="RoutineActions" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button MinWidth="80" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
                        <Button x:Name="SaveRoutineButton" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="120" Padding="12,4" Click="Save_Click" Content="{Binding PrimaryActionLabel}"
                                IsEnabled="{Binding CanSaveRoutine}" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
