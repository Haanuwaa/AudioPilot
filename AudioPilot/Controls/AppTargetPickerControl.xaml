<UserControl
    x:Class="AudioPilot.Controls.AppTargetPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:AudioPilot.Behaviors"
    xmlns:controls="clr-namespace:AudioPilot.Controls"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:loc="clr-namespace:AudioPilot.Localization"
    Focusable="False"
    IsTabStop="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBox
                x:Name="TargetTextBox"
                Height="32"
                MinWidth="0"
                VerticalContentAlignment="Center"
                b:TextBoxPlaceholderBehavior.Text="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType=controls:AppTargetPickerControl}}"
                AutomationProperties.Name="{Binding InputAutomationName, RelativeSource={RelativeSource AncestorType=controls:AppTargetPickerControl}}"
                ContextMenu="{StaticResource EditableTextContextMenu}"
                Text="{Binding TargetPath, RelativeSource={RelativeSource AncestorType=controls:AppTargetPickerControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                        <Setter Property="Padding" Value="6,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=ClearTargetButton}" Value="Visible">
                                <Setter Property="Padding" Value="6,0,26,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior Text="{Binding InputHelpText, RelativeSource={RelativeSource AncestorType=controls:AppTargetPickerControl}}" />
                </i:Interaction.Behaviors>
            </TextBox>
            <Button
                x:Name="ClearTargetButton"
                Width="20"
                Height="20"
                Margin="0,0,4,0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="{loc:Loc Ui_ClearApplicationTarget}"
                Click="ClearTargetButton_Click"
                Focusable="False"
                IsTabStop="False">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Text, ElementName=TargetTextBox}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=TargetTextBox}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=TargetTextBox}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_ClearApplicationTarget}" />
                </i:Interaction.Behaviors>
                <Path
                    Width="8"
                    Height="8"
                    Data="{x:Static controls:AppMenuGlyphs.Close}"
                    Focusable="False"
                    IsHitTestVisible="False"
                    Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.5" />
            </Button>
        </Grid>

        <WrapPanel
            x:Name="PickerButtonsPanel"
            Grid.Row="1"
            Margin="{Binding ButtonRowTopMargin, RelativeSource={RelativeSource AncestorType=controls:AppTargetPickerControl}}"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                x:Name="RunningAppsButton"
                Height="32"
                Margin="0,0,8,4"
                Padding="10,4"
                AutomationProperties.HelpText="{loc:Loc Ui_PickARunningApplication}"
                AutomationProperties.Name="{Binding RunningAppsAutomationName, RelativeSource={RelativeSource AncestorType=controls:AppTargetPickerControl}}"
                Click="RunningAppsButton_Click"
                Content="{loc:Loc Ui_RunningApps}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_PickARunningApplication}" />
                </i:Interaction.Behaviors>
            </Button>
            <Button
                x:Name="BrowseButton"
                Height="32"
                Margin="0,0,8,4"
                Padding="10,4"
                AutomationProperties.Name="{Binding BrowseAutomationName, RelativeSource={RelativeSource AncestorType=controls:AppTargetPickerControl}}"
                Click="BrowseButton_Click"
                Content="{loc:Loc Ui_Browse}" />
            <Button
                x:Name="PickAppButton"
                Height="32"
                Margin="0,0,0,4"
                Padding="10,4"
                AutomationProperties.HelpText="{loc:Loc Ui_PickAnInstalledMicrosoftStoreOrUWPApp}"
                AutomationProperties.Name="{Binding PickAppAutomationName, RelativeSource={RelativeSource AncestorType=controls:AppTargetPickerControl}}"
                Click="PickAppButton_Click"
                Content="{loc:Loc Ui_PickApp}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_PickAnInstalledMicrosoftStoreOrUWPApp}" />
                </i:Interaction.Behaviors>
            </Button>
        </WrapPanel>

        <TextBlock
            x:Name="ResolvedAppTextBlock"
            Grid.Row="2"
            Margin="0,4,0,0"
            Foreground="{DynamicResource MutedTextBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{Binding HasResolvedApp, RelativeSource={RelativeSource AncestorType=controls:AppTargetPickerControl}, Converter={StaticResource BoolToVisibilityConverter}}">
            <Run Text="{loc:Loc Ui_ResolvedApp}" /><Run
                x:Name="ResolvedAppNameRun"
                FontWeight="SemiBold"
                Foreground="{DynamicResource AccentTextBrush}"
                Text="{Binding ResolvedAppName, RelativeSource={RelativeSource AncestorType=controls:AppTargetPickerControl}, Mode=OneWay}" />
        </TextBlock>
    </Grid>
</UserControl>
