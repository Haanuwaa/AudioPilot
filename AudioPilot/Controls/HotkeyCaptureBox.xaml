<UserControl
    x:Class="AudioPilot.Controls.HotkeyCaptureBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:AudioPilot.Behaviors"
    xmlns:controls="clr-namespace:AudioPilot.Controls"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:loc="clr-namespace:AudioPilot.Localization"
    Focusable="False"
    IsTabStop="False">
    <Grid DataContext="{Binding Hotkey, RelativeSource={RelativeSource AncestorType=controls:HotkeyCaptureBox}}">
        <TextBox
            x:Name="CaptureTextBox"
            Height="{Binding FieldHeight, RelativeSource={RelativeSource AncestorType=controls:HotkeyCaptureBox}}"
            VerticalAlignment="Center"
            AutomationProperties.Name="{Binding FieldName, RelativeSource={RelativeSource AncestorType=controls:HotkeyCaptureBox}}"
            ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
            Text="{Binding DisplayText, Mode=OneWay}">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Padding" Value="4" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=ClearHotkeyButton}" Value="Visible">
                            <Setter Property="Padding" Value="4,4,24,4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
            <i:Interaction.Behaviors>
                <b:HotkeyPlaceholderBehavior />
                <b:HoverInfoPopupBehavior
                    Text="{loc:LocBinding HoverText, Message=True}"
                    WarningKind="{Binding WarningKind}" />
                <b:HotkeyCaptureBehavior Target="{Binding}" />
                <b:HotkeyWarningBorderBehavior
                    HasWarning="{Binding HasWarning}"
                    WarningKind="{Binding WarningKind}" />
            </i:Interaction.Behaviors>
        </TextBox>
        <Button
            x:Name="ClearHotkeyButton"
            Width="20"
            Height="20"
            Margin="0,0,4,0"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            AutomationProperties.Name="{loc:Loc Ui_ClearHotkey}"
            Click="ClearHotkeyButton_Click"
            Focusable="False"
            IsTabStop="False">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=controls:HotkeyCaptureBox}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=CaptureTextBox}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, ElementName=CaptureTextBox}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, ElementName=CaptureTextBox}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEnabled, ElementName=CaptureTextBox}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <i:Interaction.Behaviors>
                <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_ClearHotkey}" />
            </i:Interaction.Behaviors>
            <Path
                Width="8"
                Height="8"
                Data="{x:Static controls:AppMenuGlyphs.Close}"
                Focusable="False"
                IsHitTestVisible="False"
                Stretch="Uniform"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeThickness="1.5" />
        </Button>
    </Grid>
</UserControl>
