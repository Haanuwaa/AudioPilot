<Window x:Class="AudioPilot.UpdateLaunchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AudioPilot.Localization"
    Title="{loc:Loc Ui_AudioPilotUpdate}" Width="550" Height="480" MinWidth="480" MinHeight="440"
    FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
    ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual"
    Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{loc:Loc Ui_AudioPilotUpdate}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Update_PreparationApproval}" Margin="0,6,0,0"
                TextWrapping="Wrap" Style="{DynamicResource AppSecondaryTextStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="StatusHeading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="StatusMessage" Margin="0,6,0,0" TextWrapping="Wrap" Style="{DynamicResource AppSecondaryTextStyle}" />
            <ProgressBar x:Name="PreparationProgress" Height="6" Margin="0,16,0,0" IsIndeterminate="True"
                Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBackgroundBrush}"
                BorderThickness="0" AutomationProperties.Name="{loc:Loc Update_PreparingUpdater}" />
        </StackPanel>
        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="{loc:Loc Update_CloseButton}" Click="Close_Click" MinWidth="65" />
            <TextBlock x:Name="ManualDownloadLink" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,12,0">
                <Hyperlink Click="ManualDownload_Click"><Run Text="{loc:Loc Ui_DownloadManually}" /></Hyperlink>
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
