                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                            Margin="12,0,0,8" VerticalAlignment="Center"
                                            Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap"
                                            Text="Clear Windows' saved audio device assignments for apps." />
                                        <Button Grid.Row="2" MinHeight="30"
                                            VerticalAlignment="Center"
                                            Margin="0"
                                            Command="{Binding ResetToDefaultsCommand}"
                                            Content="Reset app settings&#x2026;"
                                            Style="{StaticResource ResetButtonStyle}"
                                            AutomationProperties.HelpText="Reset AudioPilot settings, hotkeys, routines, and startup options. Windows audio levels are kept. A confirmation is required."
                                            HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                            Margin="12,0,0,0" VerticalAlignment="Center"
                                            Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap"
                                            Text="Restore AudioPilot defaults, including hotkeys, routines, and startup options." />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </b:DeferredTabContentBehavior.Template>
                </TabItem>
            </TabControl>
            <Grid Margin="0,8,0,0" Visibility="{Binding IsSettingsTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SettingsSearchBox"
                    AutomationProperties.Name="Find a setting"
                    b:TextBoxPlaceholderBehavior.Text="Find a setting&#x2026;"
                    TextChanged="SettingsSearch_TextChanged"
                    PreviewKeyDown="SettingsSearch_PreviewKeyDown" />
                <TextBlock
                    x:Name="SettingsSearchStatus"
                    Grid.Column="1"
                    Style="{StaticResource AppSecondaryTextStyle}"
                    VerticalAlignment="Center"
                    Margin="8,0"
                    AutomationProperties.LiveSetting="Polite" />
                <Button
                    x:Name="PreviousSettingButton"
                    IsEnabled="False"
                    Grid.Column="2"
                    Width="30"
                    Padding="0"
                    Margin="0,0,4,0"
                    Click="PreviousSetting_Click"
                    AutomationProperties.Name="Previous matching setting">
                    <Path
                        Data="{x:Static controls:AppMenuGlyphs.MoveUp}"
                        Width="14"
                        Height="14"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.25"
                        Stretch="Uniform"
                        IsHitTestVisible="False" />
                </Button>
                <Button
                    x:Name="NextSettingButton"
                    IsEnabled="False"
                    Grid.Column="3"
                    Width="30"
                    Padding="0"
                    Click="NextSetting_Click"
                    AutomationProperties.Name="Next matching setting">
                    <Path
                        Data="{x:Static controls:AppMenuGlyphs.MoveDown}"
                        Width="14"
                        Height="14"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.25"
                        Stretch="Uniform"
                        IsHitTestVisible="False" />
                </Button>
            </Grid>
        </StackPanel>
        <ScrollViewer x:Name="MainContentScrollViewer" VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <i:Interaction.Behaviors>
                <b:KeyboardFocusScrollBehavior />
            </i:Interaction.Behaviors>
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Margin" Value="0,8,0,18" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsTabActive}" Value="True">
                            <Setter Property="Margin" Value="0,8,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsResettingSettings}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="0" MaxWidth="760" HorizontalAlignment="Stretch">
                <ContentPresenter
                    x:Name="MainTabContentPresenter"
                    Content="{Binding SelectedContent, ElementName=DeviceTabControl}"
                    ContentTemplate="{Binding SelectedContentTemplate, ElementName=DeviceTabControl}" />
                <WrapPanel
                    Margin="0,4,0,8"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding IsEditorTabsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RefreshDevicesButton" Margin="5" Command="{Binding RefreshDevicesCommand}" Content="Refresh"
                                AutomationProperties.HelpText="Refresh devices and check for settings changes saved outside AudioPilot.">
                            <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=RefreshDevicesButton}" /></i:Interaction.Behaviors>
                        </Button>
                        <Button Margin="5" Command="{Binding SaveSettingsCommand}" Content="Save settings" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="RunAtStartupCheckBox" Margin="5,5,0,5" Content="Run at startup" IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                                  AutomationProperties.HelpText="Applies immediately. This choice is saved independently of Save settings and auto-save.">
                            <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=RunAtStartupCheckBox}" /></i:Interaction.Behaviors>
                        </CheckBox>
                        <ComboBox
                            x:Name="ThemeSelectorComboBox"
                            Width="70"
                            Margin="9,5,0,5"
                            AutomationProperties.Name="Application theme"
                            AutomationProperties.HelpText="Preview the app theme immediately. Click Save settings to keep your choice unless auto-save is active."
                            ItemsSource="{Binding AvailableThemes}"
                            SelectedItem="{Binding Theme, Mode=TwoWay}">
                            <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=ThemeSelectorComboBox}" /></i:Interaction.Behaviors>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
                <Label
                    x:Name="VolumeMixerHeader"
                    HorizontalAlignment="Center"
                    Content="{Binding ActiveMixerHeader}"
                    FontSize="18"
                    FontWeight="Bold"
                    Visibility="{Binding IsEditorTabsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Label.Style>
                        <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="Label">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsTabIndex}" Value="1">
                                    <Setter
                                        Property="AutomationProperties.HelpText"
                                        Value="Changing a recording slider may also change the microphone level for other apps using the same device." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                    <i:Interaction.Behaviors>
                        <b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=VolumeMixerHeader}" />
                    </i:Interaction.Behaviors>
                </Label>
                <StackPanel
                    x:Name="MixerGlobalMuteControls"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding IsEditorTabsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ToggleButton x:Name="MixerMicrophoneMuteToggle" Content="Mute microphone" IsChecked="{Binding MuteMic, Mode=TwoWay}"
                                  AutomationProperties.Name="Mute microphone" AutomationProperties.HelpText="Toggle microphone mute. Deafen and held microphone controls may also keep it muted.">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource MixerGlobalMuteToggleStyle}">
                                <Setter Property="Tag" Value="{x:Static controls:AppMenuGlyphs.Input}" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter Property="Tag" Value="{x:Static controls:AppMenuGlyphs.InputMuted}" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=MixerMicrophoneMuteToggle}" /></i:Interaction.Behaviors>
                    </ToggleButton>
                    <ToggleButton x:Name="MixerDeafenToggle" Content="Deafen" IsChecked="{Binding Deafen, Mode=TwoWay}"
                                  AutomationProperties.Name="Deafen" AutomationProperties.HelpText="Toggle deafen to mute both the microphone and output.">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource MixerGlobalMuteToggleStyle}">
                                <Setter Property="Tag" Value="{x:Static controls:AppMenuGlyphs.Headphones}" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter Property="Tag" Value="{x:Static controls:AppMenuGlyphs.HeadphonesMuted}" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=MixerDeafenToggle}" /></i:Interaction.Behaviors>
                    </ToggleButton>
                    <ToggleButton x:Name="MixerOutputMuteToggle" Content="Mute output" IsChecked="{Binding MuteSound, Mode=TwoWay}"
                                  AutomationProperties.Name="Mute output" AutomationProperties.HelpText="Toggle output mute. Deafen also mutes the output.">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource MixerGlobalMuteToggleStyle}">
                                <Setter Property="Tag" Value="{x:Static controls:AppMenuGlyphs.Output}" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter Property="Tag" Value="{x:Static controls:AppMenuGlyphs.OutputMuted}" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=MixerOutputMuteToggle}" /></i:Interaction.Behaviors>
                    </ToggleButton>
                </StackPanel>
                <ListBox
                    Name="VolumeMixer"
                    AutomationProperties.Name="Volume mixer sessions"
                    Background="Transparent"
                    BorderThickness="0"
                    Focusable="False"
                    IsTabStop="False"
                    ItemsSource="{Binding ActiveMixerSessions}"
                    KeyboardNavigation.TabNavigation="Continue"
                    PreviewMouseWheel="VolumeMixer_PreviewMouseWheel"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="VolumeMixer_SelectionChanged"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    Visibility="{Binding IsEditorTabsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Stretch" Margin="8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="80" />
                                    <ColumnDefinition Width="1.5*" MinWidth="88" MaxWidth="240" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <i:Interaction.Behaviors>
                                        <b:TrimmedTextPopupBehavior />
                                    </i:Interaction.Behaviors>
                                    <TextBlock
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        FontSize="13" />
                                    <Label.Style>
                                        <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="{x:Type Label}">
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMaster}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMic}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSystemSounds}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                                <Slider
                                    Grid.Column="1"
                                    AutomationProperties.Name="{Binding DisplayName}"
                                    AutomationProperties.HelpText="Right-click the slider knob or press Space to toggle mute. Arrow keys adjust volume precisely; hold to accelerate. Page Up/Down changes volume by 5. Home/End sets minimum/maximum volume."
                                    VerticalAlignment="Center"
                                    IsMoveToPointEnabled="True"
                                    LargeChange="5"
                                    Maximum="100"
                                    SmallChange="0.1"
                                    Tag="{Binding IsMuted}"
                                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    HorizontalAlignment="Stretch">
                                    <i:Interaction.Behaviors>
                                        <b:SliderThumbRightClickBehavior
                                            Command="{Binding DataContext.ActiveMixer.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                        <b:SliderKeyboardAccelerationBehavior
                                            MuteCommand="{Binding DataContext.ActiveMixer.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            MuteCommandParameter="{Binding}" />
                                    </i:Interaction.Behaviors>
                                </Slider>
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Volume, StringFormat={}{0:0.#}%}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="4,0,6,0"
                                    Style="{StaticResource AppSecondaryTextStyle}" />
                                <Button x:Name="MixerMuteButton" Grid.Column="3" Margin="4,0,0,0"
                                        Style="{StaticResource MixerMuteButtonStyle}"
                                        Command="{Binding DataContext.ActiveMixer.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <i:Interaction.Behaviors>
                                        <b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=MixerMuteButton}" />
                                    </i:Interaction.Behaviors>
                                    <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent" StrokeThickness="1.4"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Focusable="False" IsHitTestVisible="False">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.Output}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.OutputMuted}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedSettingsTabIndex, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="1">
                                                        <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.Input}" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMuted}" Value="True" />
                                                            <Condition Binding="{Binding DataContext.SelectedSettingsTabIndex, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="1" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.InputMuted}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,8" MaxWidth="760"
            Visibility="{Binding IsSettingsTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
            <WrapPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Visibility="{Binding IsSettingsTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="Import settings&#x2026;" Command="{Binding ImportSettingsCommand}" MinWidth="96" Margin="0,0,8,0" />
                <Button Content="Export settings&#x2026;" Command="{Binding ExportSettingsCommand}" MinWidth="96" Margin="0,0,8,0" />
                <Button
                    Content="Apply settings"
                    Command="{Binding ApplySettingsCommand}"
                    MinWidth="120"
                    Style="{StaticResource AppPrimaryButtonStyle}" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
