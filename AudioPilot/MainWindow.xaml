                                            Margin="12,0,0,8" VerticalAlignment="Center"
                                            Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap"
                                            Text="Clear Windows' saved audio device assignments for apps." />
                                        <Button Grid.Row="3" MinHeight="30"
                                            VerticalAlignment="Center"
                                            Margin="0"
                                            Command="{Binding ResetToDefaultsCommand}"
                                            Content="Reset app settings&#x2026;"
                                            Style="{StaticResource ResetButtonStyle}"
                                            AutomationProperties.HelpText="Reset AudioPilot settings, hotkeys, routines, and startup options. Windows audio levels are kept. A confirmation is required."
                                            HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                            Margin="12,0,0,0" VerticalAlignment="Center"
                                            Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap"
                                            Text="Restore AudioPilot defaults, including hotkeys, routines, and startup options." />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </b:DeferredTabContentBehavior.Template>
                </TabItem>
            </TabControl>
            <Grid Margin="0,8,0,0" Visibility="{Binding IsSettingsTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SettingsSearchBox"
                    AutomationProperties.Name="Find a setting"
                    b:TextBoxPlaceholderBehavior.Text="Find a setting&#x2026;"
                    TextChanged="SettingsSearch_TextChanged"
                    PreviewKeyDown="SettingsSearch_PreviewKeyDown" />
                <TextBlock
                    x:Name="SettingsSearchStatus"
                    Grid.Column="1"
                    Style="{StaticResource AppSecondaryTextStyle}"
                    VerticalAlignment="Center"
                    Margin="8,0"
                    AutomationProperties.LiveSetting="Polite" />
                <Button
                    x:Name="PreviousSettingButton"
                    IsEnabled="False"
                    Grid.Column="2"
                    Width="30"
                    Padding="0"
                    Margin="0,0,4,0"
                    Click="PreviousSetting_Click"
                    AutomationProperties.Name="Previous matching setting">
                    <Path
                        Data="{x:Static controls:AppMenuGlyphs.MoveUp}"
                        Width="14"
                        Height="14"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.25"
                        Stretch="Uniform"
                        IsHitTestVisible="False" />
                </Button>
                <Button
                    x:Name="NextSettingButton"
                    IsEnabled="False"
                    Grid.Column="3"
                    Width="30"
                    Padding="0"
                    Click="NextSetting_Click"
                    AutomationProperties.Name="Next matching setting">
                    <Path
                        Data="{x:Static controls:AppMenuGlyphs.MoveDown}"
                        Width="14"
                        Height="14"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.25"
                        Stretch="Uniform"
                        IsHitTestVisible="False" />
                </Button>
            </Grid>
        </StackPanel>
        <ScrollViewer x:Name="MainContentScrollViewer" VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <i:Interaction.Behaviors>
                <b:KeyboardFocusScrollBehavior />
            </i:Interaction.Behaviors>
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Margin" Value="0,8,0,18" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsTabActive}" Value="True">
                            <Setter Property="Margin" Value="0,8,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsResettingSettings}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="0" MaxWidth="760" HorizontalAlignment="Stretch">
                <ContentPresenter
                    x:Name="MainTabContentPresenter"
                    Content="{Binding SelectedContent, ElementName=DeviceTabControl}"
                    ContentTemplate="{Binding SelectedContentTemplate, ElementName=DeviceTabControl}" />
                <WrapPanel
                    Margin="0,4,0,8"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding IsEditorTabsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RefreshDevicesButton" Margin="5" Command="{Binding RefreshDevicesCommand}" Content="Refresh"
                                AutomationProperties.HelpText="Refresh devices, mixer levels, and open app routing. Check for settings changes saved outside AudioPilot.">
                            <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=RefreshDevicesButton}" /></i:Interaction.Behaviors>
                        </Button>
                        <Button Margin="5" Command="{Binding SaveSettingsCommand}" Content="Save settings">
                            <i:Interaction.Behaviors><b:DeferredDisabledAppearanceBehavior /></i:Interaction.Behaviors>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="RunAtStartupCheckBox" Margin="5,5,0,5" Content="Run at startup" IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                                  AutomationProperties.HelpText="Applies immediately. This choice is saved independently of Save settings and auto-save.">
                            <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=RunAtStartupCheckBox}" /></i:Interaction.Behaviors>
                        </CheckBox>
                        <ComboBox
                            x:Name="ThemeSelectorComboBox"
                            Width="70"
                            Margin="9,5,0,5"
                            AutomationProperties.Name="Application theme"
                            AutomationProperties.HelpText="Preview the app theme immediately. Click Save settings to keep your choice unless auto-save is active."
                            ItemsSource="{Binding AvailableThemes}"
                            SelectedItem="{Binding Theme, Mode=TwoWay}">
                            <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=ThemeSelectorComboBox}" /></i:Interaction.Behaviors>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
                <Label
                    x:Name="VolumeMixerHeader"
                    HorizontalAlignment="Center"
                    Content="{Binding ActiveMixerHeader}"
                    FontSize="18"
                    FontWeight="Bold"
                    Visibility="{Binding IsEditorTabsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Label.Style>
                        <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="Label">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsTabIndex}" Value="1">
                                    <Setter
                                        Property="AutomationProperties.HelpText"
                                        Value="Changing a recording slider may also change the microphone level for other apps using the same device." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                    <i:Interaction.Behaviors>
                        <b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=VolumeMixerHeader}" />
                    </i:Interaction.Behaviors>
                </Label>

                <StackPanel
                    x:Name="MixerGlobalMuteControls"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding IsEditorTabsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ToggleButton x:Name="MixerMicrophoneMuteToggle" Content="Mute microphone" IsChecked="{Binding MuteMic, Mode=TwoWay}"
                                  AutomationProperties.Name="Mute microphone" AutomationProperties.HelpText="Toggle microphone mute. Deafen and held microphone controls may also keep it muted.">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource MixerGlobalMuteToggleStyle}">
                                <Setter Property="Tag" Value="{x:Static controls:AppMenuGlyphs.Input}" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter Property="Tag" Value="{x:Static controls:AppMenuGlyphs.InputMuted}" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=MixerMicrophoneMuteToggle}" /></i:Interaction.Behaviors>
                    </ToggleButton>
                    <ToggleButton x:Name="MixerDeafenToggle" Content="Deafen" IsChecked="{Binding Deafen, Mode=TwoWay}"
                                  AutomationProperties.Name="Deafen" AutomationProperties.HelpText="Toggle deafen to mute both the microphone and output.">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource MixerGlobalMuteToggleStyle}">
                                <Setter Property="Tag" Value="{x:Static controls:AppMenuGlyphs.Headphones}" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter Property="Tag" Value="{x:Static controls:AppMenuGlyphs.HeadphonesMuted}" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=MixerDeafenToggle}" /></i:Interaction.Behaviors>
                    </ToggleButton>
                    <ToggleButton x:Name="MixerOutputMuteToggle" Content="Mute output" IsChecked="{Binding MuteSound, Mode=TwoWay}"
                                  AutomationProperties.Name="Mute output" AutomationProperties.HelpText="Toggle output mute. Deafen also mutes the output.">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource MixerGlobalMuteToggleStyle}">
                                <Setter Property="Tag" Value="{x:Static controls:AppMenuGlyphs.Output}" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter Property="Tag" Value="{x:Static controls:AppMenuGlyphs.OutputMuted}" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=MixerOutputMuteToggle}" /></i:Interaction.Behaviors>
                    </ToggleButton>
                </StackPanel>
                <ListBox
                    Name="VolumeMixer"
                    AutomationProperties.Name="Volume mixer sessions"
                    Background="Transparent"
                    BorderThickness="0"
                    Focusable="False"
                    IsTabStop="False"
                    ItemsSource="{Binding ActiveMixer.GroupedSessions}"
                    KeyboardNavigation.TabNavigation="Continue"
                    PreviewMouseWheel="VolumeMixer_PreviewMouseWheel"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="VolumeMixer_SelectionChanged"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    Visibility="{Binding IsEditorTabsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="AutomationProperties.Name" Value="System audio" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Name}" Value="True"><Setter Property="AutomationProperties.Name" Value="Applications" /></DataTrigger></Style.Triggers>
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border x:Name="MixerApplicationSection">
                                        <Border.Style><Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Name}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style></Border.Style>
                                        <StackPanel Margin="8,8,8,4" DataContext="{Binding DataContext.ActiveMixer, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                            <Grid x:Name="MixerApplicationsHeader" HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Applications" FontWeight="SemiBold" />
                                                    <TextBlock Margin="5,0,0,0" Foreground="{DynamicResource AccentTextBrush}" Text="{Binding GroupSelectionText}"
                                                               Visibility="{Binding HasSelectedApplications, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Clear" Margin="12,0,4,0" Style="{StaticResource MixerInlineButtonStyle}" Command="{Binding ClearApplicationSelectionCommand}"
                                                        Visibility="{Binding HasSelectedApplications, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Button x:Name="MixerSelectAppsButton" Grid.Column="2" Content="{Binding SelectionModeText}" Margin="8,0,0,0" Padding="6,3"
                                                        Visibility="{Binding CanGroupApplications, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Command="{Binding ToggleApplicationSelectionModeCommand}"
                                                        AutomationProperties.HelpText="Show checkboxes to choose playback apps. Selected sliders move together, and their mute buttons control the selection. You can also Ctrl-click app names. Escape clears selection.">
                                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource MixerInlineButtonStyle}">
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsSelectingApplications}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                        </DataTrigger></Style.Triggers>
                                                    </Style></Button.Style>
                                                    <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=MixerSelectAppsButton}" /></i:Interaction.Behaviors>
                                                </Button>
                                            </Grid>
                                            <TextBlock Margin="0,3,0,2" Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                                       Text="Volume and mute changes apply to selected apps."
                                                       Visibility="{Binding IsSelectingApplications, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroupSelected}" Value="True">
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Selected for group volume and mute" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Stretch" Margin="8,2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <i:Interaction.Behaviors>
                                    <b:MixerGroupSliderBehavior Mixer="{Binding DataContext.ActiveMixer, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                </i:Interaction.Behaviors>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="80" />
                                    <ColumnDefinition Width="1.5*" MinWidth="88" MaxWidth="240" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="4" Grid.RowSpan="2" Background="{DynamicResource AccentBrush}" Opacity="0.14" CornerRadius="4" IsHitTestVisible="False"
                                        Visibility="{Binding IsGroupSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Grid Grid.Column="0" Margin="0,0,8,0" Visibility="{Binding IsApplication, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Margin="2,0,4,0" VerticalAlignment="Center" IsChecked="{Binding IsGroupSelected, Mode=OneWay}"
                                              FocusVisualStyle="{StaticResource MixerSelectionFocusVisualStyle}"
                                              Visibility="{Binding DataContext.ActiveMixer.IsSelectingApplications, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Command="{Binding DataContext.ActiveMixer.ToggleApplicationSelectionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                              AutomationProperties.Name="{Binding DisplayName, StringFormat=Select {0} for group volume and mute}" />
                                    <Button Grid.Column="1" Width="20" Height="28" Padding="1" HorizontalContentAlignment="Center" Style="{StaticResource MixerInlineButtonStyle}"
                                            Command="{Binding DataContext.ActiveMixer.ExpandApplicationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding DisplayName, StringFormat=Audio device for {0}}"
                                            AutomationProperties.HelpText="Expand to choose this app's audio device. Changes apply immediately.">
                                        <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="Expand to choose this app's audio device." /></i:Interaction.Behaviors>
                                        <Path Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.3" StrokeLineJoin="Round" Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" IsHitTestVisible="False">
                                            <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 3,1 L 7,5 3,9" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsRoutingExpanded}" Value="True"><Setter Property="Data" Value="M 1,3 L 5,7 9,3" /></DataTrigger></Style.Triggers>
                                            </Style></Path.Style>
                                        </Path>
                                    </Button>
                                    <Button Grid.Column="2" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="2,3"
                                            Style="{StaticResource MixerApplicationNameButtonStyle}"
                                            Visibility="{Binding DataContext.ActiveMixer.CanGroupApplications, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.ActiveMixer.ApplicationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            PreviewMouseLeftButtonDown="MixerApplicationName_PreviewMouseLeftButtonDown" PreviewKeyDown="MixerApplicationName_PreviewKeyDown"
                                            AutomationProperties.Name="{Binding DisplayName}"
                                            AutomationProperties.HelpText="Select this app. Ctrl-click to add or remove it from the group. Use the arrow to choose its audio device.">
                                        <i:Interaction.Behaviors><b:TrimmedTextPopupBehavior /></i:Interaction.Behaviors>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="13" />
                                    </Button>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Style.Triggers><DataTrigger Binding="{Binding DataContext.ActiveMixer.CanGroupApplications, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                        <i:Interaction.Behaviors><b:TrimmedTextPopupBehavior /></i:Interaction.Behaviors>
                                    </TextBlock>
                                </Grid>
                                <Label Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <i:Interaction.Behaviors>
                                        <b:TrimmedTextPopupBehavior />
                                    </i:Interaction.Behaviors>
                                    <TextBlock
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        FontSize="13" />
                                    <Label.Style>
                                        <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="{x:Type Label}">
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsApplication}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsMaster}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMic}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSystemSounds}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                                <Slider
                                    Grid.Column="1"
                                    AutomationProperties.Name="{Binding DisplayName}"
                                    AutomationProperties.HelpText="Right-click the slider knob or press Space to toggle mute. Arrow keys adjust volume precisely; hold to accelerate. Page Up/Down changes volume by 5. Home/End sets minimum/maximum volume."
                                    VerticalAlignment="Center"
                                    IsMoveToPointEnabled="True"
                                    LargeChange="5"
                                    Maximum="100"
                                    SmallChange="0.1"
                                    Tag="{Binding IsMuted}"
                                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    HorizontalAlignment="Stretch">
                                    <i:Interaction.Behaviors>
                                        <b:SliderThumbRightClickBehavior
                                            Command="{Binding DataContext.ActiveMixer.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                        <b:SliderKeyboardAccelerationBehavior
                                            MuteCommand="{Binding DataContext.ActiveMixer.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            MuteCommandParameter="{Binding}" />
                                    </i:Interaction.Behaviors>
                                </Slider>
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Volume, StringFormat={}{0:0.#}%}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="4,0,6,0"
                                    Style="{StaticResource AppSecondaryTextStyle}" />
                                <Button x:Name="MixerMuteButton" Grid.Column="3" Margin="4,0,0,0"
                                        Style="{StaticResource MixerMuteButtonStyle}"
                                        Command="{Binding DataContext.ActiveMixer.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <i:Interaction.Behaviors>
                                        <b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=MixerMuteButton}" />
                                    </i:Interaction.Behaviors>
                                    <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent" StrokeThickness="1.4"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Focusable="False" IsHitTestVisible="False">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.Output}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.OutputMuted}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMic}" Value="True">
                                                        <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.Input}" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMic}" Value="True" />
                                                            <Condition Binding="{Binding IsMuted}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.InputMuted}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMaster}" Value="False" />
                                                            <Condition Binding="{Binding DataContext.SelectedSettingsTabIndex, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="1" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.Input}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMuted}" Value="True" />
                                                            <Condition Binding="{Binding IsMaster}" Value="False" />
                                                            <Condition Binding="{Binding DataContext.SelectedSettingsTabIndex, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="1" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.InputMuted}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                                <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="22,3,4,8"
                                      IsVisibleChanged="MixerRoutingDetails_IsVisibleChanged"
                                      Visibility="{Binding IsRoutingExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding RoutingDetails.DeviceLabel}" Style="{StaticResource AppSecondaryTextStyle}" />
                                    <ComboBox Grid.Column="1" MinWidth="60" ItemsSource="{Binding RoutingDetails.Devices}" DisplayMemberPath="Name"
                                              IsDropDownOpen="{Binding RoutingDetails.IsChoosingDevice, Mode=TwoWay}"
                                              SelectedItem="{Binding RoutingDetails.SelectedDevice, Mode=TwoWay}" IsEnabled="{Binding RoutingDetails.CanEdit}"
                                              AutomationProperties.Name="{Binding RoutingDetails.DeviceLabel}"
                                              AutomationProperties.HelpText="Applies immediately to this application's audio roles. Windows default clears its device preference.">
                                        <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="IsEnabled" Value="{Binding IsSelectable}" /></Style></ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                    <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" Content="Retry" Margin="6,0,0,0" Padding="5,1" VerticalAlignment="Top"
                                                Style="{StaticResource MixerInlineButtonStyle}" AutomationProperties.Name="Retry reading application routing"
                                                Visibility="{Binding RoutingDetails.NeedsReadRetry, Converter={StaticResource BoolToVisibilityConverter}}"
                                                IsEnabled="{Binding RoutingDetails.CanRetry}"
                                                Command="{Binding DataContext.ActiveMixer.RetryApplicationRoutingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                        <TextBlock Text="{Binding RoutingDetails.Status}" TextWrapping="Wrap">
                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AppSecondaryTextStyle}">
                                                <Style.Triggers><DataTrigger Binding="{Binding RoutingDetails.HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DialogErrorBrush}" /></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,8" MaxWidth="760"
            Visibility="{Binding IsSettingsTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid x:Name="SettingsSaveModeNotice" Height="24" HorizontalAlignment="Center" Margin="0,0,0,4"
                AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="Apply settings to save your changes." TextAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource AppSecondaryTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAutoSaveActive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border CornerRadius="12" Padding="10,1" BorderThickness="1"
                    BorderBrush="{DynamicResource DialogSuccessBrush}" Background="{DynamicResource ControlBackgroundBrush}"
                    Visibility="{Binding IsAutoSaveActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Auto-save on" VerticalAlignment="Center" Foreground="{DynamicResource DialogSuccessBrush}" />
                </Border>
            </Grid>
            <WrapPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Visibility="{Binding IsSettingsTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="Import settings&#x2026;" Command="{Binding ImportSettingsCommand}" MinWidth="96" Margin="0,0,8,0">
                    <i:Interaction.Behaviors><b:DeferredDisabledAppearanceBehavior /></i:Interaction.Behaviors>
                </Button>
                <Button Content="Export settings&#x2026;" Command="{Binding ExportSettingsCommand}" MinWidth="96" Margin="0,0,8,0">
                    <i:Interaction.Behaviors><b:DeferredDisabledAppearanceBehavior /></i:Interaction.Behaviors>
                </Button>
                <Button
                    Content="Apply settings"
                    Command="{Binding ApplySettingsCommand}"
                    MinWidth="120"
                    Style="{StaticResource AppPrimaryButtonStyle}">
                    <i:Interaction.Behaviors><b:DeferredDisabledAppearanceBehavior /></i:Interaction.Behaviors>
                </Button>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
