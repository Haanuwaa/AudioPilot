<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:b="clr-namespace:AudioPilot.Behaviors"
    xmlns:constants="clr-namespace:AudioPilot.Constants"
    xmlns:h="clr-namespace:AudioPilot.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:views="clr-namespace:AudioPilot.Views"
    xmlns:loc="clr-namespace:AudioPilot.Localization"
    loc:LocalizationContext.Service="{Binding Localization}"
    xmlns:updates="clr-namespace:AudioPilot.Services.Updates"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="AudioPilot.MainWindow"
    Title="AudioPilot"
    Width="{x:Static constants:AppConstants+WindowLayout.DefaultWidth}"
    Height="{x:Static constants:AppConstants+WindowLayout.DefaultHeight}"
    MinWidth="{x:Static constants:AppConstants+WindowLayout.MinimumWidth}"
    MinHeight="{x:Static constants:AppConstants+WindowLayout.MinimumHeight}"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}"
    Icon="pack://application:,,,/AudioPilot;component/Images/audiopilot.ico"
    Opacity="0"
    ResizeMode="CanResizeWithGrip"
    ShowActivated="False"
    ShowInTaskbar="False"
    WindowState="Normal"
    FontFamily="Segoe UI"
    FontSize="13"
    PreviewMouseDown="SettingsFind_UserInput"
    PreviewMouseWheel="SettingsFind_UserInput"
    PreviewKeyDown="SettingsFind_UserInput"
    PreviewGotKeyboardFocus="SettingsFind_UserInput"
    UseLayoutRounding="True"
    xmlns:controls="clr-namespace:AudioPilot.Controls"
    xmlns:vm="clr-namespace:AudioPilot.ViewModels">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="OpenHelp_Executed" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="FindSettings_Executed" CanExecute="FindSettings_CanExecute" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding MinimizeCommand}" />
        <KeyBinding Key="F1" Command="ApplicationCommands.Help" />
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
        <KeyBinding Key="D1" Command="{Binding SelectSettingsTabCommand}" CommandParameter="0" Modifiers="Control" />
        <KeyBinding Key="D2" Command="{Binding SelectSettingsTabCommand}" CommandParameter="1" Modifiers="Control" />
        <KeyBinding Key="D3" Command="{Binding SelectSettingsTabCommand}" CommandParameter="2" Modifiers="Control" />
        <KeyBinding Key="D4" Command="{Binding SelectSettingsTabCommand}" CommandParameter="3" Modifiers="Control" />
        <KeyBinding Key="N" Command="{Binding AddRoutineCommand}" Modifiers="Control" />
        <KeyBinding Key="Tab" Command="{Binding NextSettingsTabCommand}" Modifiers="Control" />
        <KeyBinding Key="S" Command="{Binding SaveCurrentContextCommand}" Modifiers="Control" />
        <KeyBinding Key="F5" Command="{Binding RefreshDevicesCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <DrawingImage x:Key="TaskbarPreviousTrackImage" po:Freeze="True">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z" />
                    <GeometryDrawing Brush="White" Geometry="M3,3 H5 V13 H3 Z M13,3 L6,8 L13,13 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#303030" Thickness="0.75" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="TaskbarPlayPauseImage" po:Freeze="True">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z" />
                    <GeometryDrawing Brush="White" Geometry="M1.5,3 L7.5,8 L1.5,13 Z M9,3 H11 V13 H9 Z M13,3 H15 V13 H13 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#303030" Thickness="0.75" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="TaskbarNextTrackImage" po:Freeze="True">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z" />
                    <GeometryDrawing Brush="White" Geometry="M3,3 L10,8 L3,13 Z M11,3 H13 V13 H11 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#303030" Thickness="0.75" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <h:WindowListHeightConverter x:Key="RoutineListHeightConverter" InitialHeight="128" InitialWindowHeight="430" RowHeight="60" />
        <Style x:Key="TabSaveStatusIndicatorStyle" TargetType="ContentControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="PendingDot" Width="6" Height="6" Fill="{DynamicResource TextBrush}"
                                IsHitTestVisible="False" />
                            <Path x:Name="SavedCheck" Data="M 2,7 L 5,10 L 12,3" StrokeThickness="1.8"
                                Stroke="{DynamicResource DialogSuccessBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                StrokeLineJoin="Round" Visibility="Collapsed" IsHitTestVisible="False" />
                            <Path x:Name="NotSavedMark" Data="M 7,2 L 7,8 M 7,11 L 7,11.5" StrokeThickness="2"
                                Stroke="{DynamicResource DialogErrorBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Static vm:TabSaveState.Saved}">
                                <Setter TargetName="PendingDot" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SavedCheck" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Static vm:TabSaveState.NotSaved}">
                                <Setter TargetName="PendingDot" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NotSavedMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static vm:TabSaveState.Saved}">
                    <Setter Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:TabSaveState.Unsaved}">
                    <Setter Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:TabSaveState.NotSaved}">
                    <Setter Property="Visibility" Value="Visible" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SaveFeedbackTabHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                <ContentControl x:Name="TabSaveIndicator" Width="14" Height="14" Margin="6,0,0,0"
                    VerticalAlignment="Center" Focusable="False" IsTabStop="False"
                    Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabItem}}"
                    AutomationProperties.ItemStatus="{Binding (AutomationProperties.ItemStatus), RelativeSource={RelativeSource AncestorType=TabItem}}"
                    Style="{StaticResource TabSaveStatusIndicatorStyle}">
                    <i:Interaction.Behaviors>
                        <b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.ItemStatus), ElementName=TabSaveIndicator}" />
                    </i:Interaction.Behaviors>
                </ContentControl>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SettingsProjectLinkStyle" TargetType="{x:Type Hyperlink}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsUpdateLinkStyle" TargetType="{x:Type Hyperlink}" BasedOn="{StaticResource SettingsProjectLinkStyle}">
            <Setter Property="Foreground" Value="{DynamicResource DialogSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Updates.IsUpdateAvailable}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MixerGlobalMuteToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
            <Setter Property="IsThreeState" Value="False" />
            <Setter Property="AutomationProperties.ItemStatus" Value="Inactive" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <StackPanel Margin="{TemplateBinding Padding}" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path x:Name="MuteGlyph" Width="16" Height="16" Margin="0,0,6,0" Stretch="None" Data="{TemplateBinding Tag}"
                                      Fill="Transparent" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Focusable="False" IsHitTestVisible="False" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MuteGlyph" Property="Stroke" Value="{DynamicResource DialogErrorBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MuteGlyph" Property="Stroke" Value="{DynamicResource DialogPrimaryActionForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="AutomationProperties.ItemStatus" Value="Active" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DialogPrimaryActionForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MixerInlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MixerApplicationNameButtonStyle" TargetType="Button" BasedOn="{StaticResource MixerInlineButtonStyle}">
            <Setter Property="AutomationProperties.ItemStatus" Value="Not selected for group volume and mute" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroupSelected}" Value="True">
                    <Setter Property="AutomationProperties.ItemStatus" Value="Selected for group volume and mute" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MixerSelectionFocusVisualStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Rectangle x:Name="SelectionFocusOutline" Width="20" Height="20" Margin="-2,0,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" RadiusX="3" RadiusY="3"
                                       SnapsToDevicePixels="True" Stroke="{DynamicResource KeyboardFocusOuterBrush}"
                                       StrokeDashArray="1 2" StrokeThickness="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MixerMuteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
            <Setter Property="AutomationProperties.Name" Value="{loc:LocBinding DisplayLabel, Format=Mixer_Mute}" />
            <Setter Property="AutomationProperties.ItemStatus" Value="Unmuted" />
            <Setter Property="AutomationProperties.HelpText" Value="{loc:Loc Ui_MuteYouCanAlsoRightClickTheSlider}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DialogErrorBrush}" />
                    <Setter Property="AutomationProperties.Name" Value="{loc:LocBinding DisplayLabel, Format=Mixer_Unmute}" />
                    <Setter Property="AutomationProperties.ItemStatus" Value="Muted" />
                    <Setter Property="AutomationProperties.HelpText" Value="{loc:Loc Ui_UnmuteYouCanAlsoRightClickTheSlider}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroupSelected}" Value="True" />
                        <Condition Binding="{Binding DataContext.ActiveMixer.HasMultipleSelectedApplications, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="AutomationProperties.HelpText" Value="{loc:Loc Ui_MuteOrUnmuteAllSelectedAppsUsingThis}" />
                </MultiDataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DialogPrimaryActionForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoutineListSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSecondaryTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource AppSectionHeadingStyle}" />
        <Style x:Key="SettingsRolePillStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectionHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentSelectionHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ResetButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ResetButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ResetButtonPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoutineHotkeyWarningTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HotkeyConflictBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:HotkeyWarningKind.Reserved}">
                    <Setter Property="Foreground" Value="{DynamicResource HotkeyReservedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:HotkeyWarningKind.Fallback}">
                    <Setter Property="Foreground" Value="{DynamicResource HotkeyFallbackBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ContextMenu x:Key="HotkeyDeleteContextMenu" Style="{DynamicResource AppContextMenuStyle}">
            <MenuItem
                Click="ClearHotkeyText_Click"
                Header="{loc:Loc Ui_Delete}"
                Icon="{StaticResource AppMenuDeleteIcon}"
                InputGestureText="Del"
                Style="{DynamicResource AppContextMenuItemStyle}" />
        </ContextMenu>
        <DataTemplate x:Key="MixerRoutingDetailsTemplate">
            <Grid h:AppHelp.Topic="ApplicationRouting" Margin="22,3,4,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="{loc:LocBinding RoutingDetails.DeviceLabelText}" Style="{StaticResource AppSecondaryTextStyle}" />
                <ComboBox Grid.Column="1" MinWidth="60" ItemsSource="{Binding RoutingDetails.Devices}"
                          IsDropDownOpen="{Binding RoutingDetails.IsChoosingDevice, Mode=TwoWay}"
                          SelectedItem="{Binding RoutingDetails.SelectedDevice, Mode=TwoWay}" IsEnabled="{Binding RoutingDetails.CanEdit}"
                          AutomationProperties.Name="{loc:LocBinding RoutingDetails.DeviceLabelText}"
                          AutomationProperties.HelpText="{loc:Loc Ui_AppliesImmediatelyToThisApplicationSAudioRoles}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{loc:LocBinding LabelText}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="IsEnabled" Value="{Binding IsSelectable}" /></Style></ComboBox.ItemContainerStyle>
                </ComboBox>
                <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="{loc:Loc Ui_Retry}" Margin="6,0,0,0" Padding="5,1" VerticalAlignment="Top"
                            Style="{StaticResource MixerInlineButtonStyle}" AutomationProperties.Name="{loc:Loc Ui_RetryReadingApplicationRouting}"
                            Visibility="{Binding RoutingDetails.NeedsReadRetry, Converter={StaticResource BoolToVisibilityConverter}}"
                            IsEnabled="{Binding RoutingDetails.CanRetry}"
                            Command="{Binding DataContext.ActiveMixer.RetryApplicationRoutingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <TextBlock Text="{loc:LocBinding RoutingDetails.StatusText}" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AppSecondaryTextStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding RoutingDetails.HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DialogErrorBrush}" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo>
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo
                    Command="{Binding TaskbarMediaCommand}"
                    CommandParameter="{x:Static MediaCommands.PreviousTrack}"
                    Description="Previous track"
                    DismissWhenClicked="False"
                    ImageSource="{StaticResource TaskbarPreviousTrackImage}" />
                <ThumbButtonInfo
                    Command="{Binding TaskbarMediaCommand}"
                    CommandParameter="{x:Static MediaCommands.TogglePlayPause}"
                    Description="Play/pause"
                    DismissWhenClicked="False"
                    ImageSource="{StaticResource TaskbarPlayPauseImage}" />
                <ThumbButtonInfo
                    Command="{Binding TaskbarMediaCommand}"
                    CommandParameter="{x:Static MediaCommands.NextTrack}"
                    Description="Next track"
                    DismissWhenClicked="False"
                    ImageSource="{StaticResource TaskbarNextTrackImage}" />
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <Grid Background="Transparent" PreviewMouseDown="RootGrid_PreviewMouseDown" KeyDown="MixerGroup_KeyDown"
        PreviewGotKeyboardFocus="RootGrid_PreviewGotKeyboardFocus" Margin="8,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" MaxWidth="760">
            <Grid>
                <Label
                    HorizontalAlignment="Center"
                    Content="{loc:Loc Ui_AudioControls}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Visibility="{Binding IsEditorTabsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Label
                    HorizontalAlignment="Center"
                    Content="{loc:Loc Common_Routines}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Visibility="{Binding IsRoutinesTabActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Label
                    HorizontalAlignment="Center"
                    Content="{loc:Loc Common_Settings}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Visibility="{Binding IsSettingsTabActive, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
            <TabControl
                x:Name="DeviceTabControl"
                Margin="0,6,0,0"
                Background="Transparent"
                BorderThickness="0"
                SelectedIndex="{Binding SelectedSettingsTabIndex, Mode=TwoWay}"
                SelectionChanged="DeviceTabControl_SelectionChanged"
                HorizontalAlignment="Stretch">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <TabPanel IsItemsHost="True" HorizontalAlignment="Center" KeyboardNavigation.TabNavigation="Once" />
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabPanel">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                    </Style>
                </TabControl.Resources>
                <TabItem AutomationProperties.AutomationId="OutputTab" Header="{loc:Loc Common_Output}" Tag="{Binding OutputTabSaveState}"
                    HeaderTemplate="{StaticResource SaveFeedbackTabHeaderTemplate}"
                    AutomationProperties.ItemStatus="{loc:LocBinding OutputTabFeedbackPresentation}">
                    <views:OutputDevicePanel x:Name="OutputDevicePanel" />
                </TabItem>
                <TabItem AutomationProperties.AutomationId="InputTab" Header="{loc:Loc Common_Input}" Tag="{Binding InputTabSaveState}"
                    HeaderTemplate="{StaticResource SaveFeedbackTabHeaderTemplate}"
                    AutomationProperties.ItemStatus="{loc:LocBinding InputTabFeedbackPresentation}">
                    <b:DeferredTabContentBehavior.Template>
                        <DataTemplate>
                            <views:InputDevicePanel />
                        </DataTemplate>
                    </b:DeferredTabContentBehavior.Template>
                </TabItem>
                <TabItem AutomationProperties.AutomationId="RoutinesTab" Header="{loc:Loc Common_Routines}" Tag="{Binding RoutinesTabSaveState}"
                    HeaderTemplate="{StaticResource SaveFeedbackTabHeaderTemplate}"
                    AutomationProperties.ItemStatus="{loc:LocBinding RoutinesTabFeedbackPresentation}">
                    <b:DeferredTabContentBehavior.Template>
                        <DataTemplate>
                            <StackPanel Margin="10">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="10"
                                    CornerRadius="6"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding AutomaticRoutinesPaused, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <DockPanel>
                                        <Button
                                            DockPanel.Dock="Right"
                                            Content="{loc:Loc Ui_Resume}"
                                            Command="{Binding ResumeAutomaticRoutinesCommand}"
                                            Margin="8,0,0,0" />
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Ui_AutomaticRoutinesPaused}" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{loc:Loc Ui_ManualRunsRemainAvailable}"
                                                Style="{StaticResource AppSecondaryTextStyle}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Text="{loc:Loc Ui_ApplyAudioSettingsWithShortcutsOrAutomaticTriggers}"
                                    TextWrapping="Wrap" />
                                <StackPanel b:ListBoxSelectedItemsBehavior.SelectionContext="{Binding SelectedRoutines}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock x:Name="SavedRoutinesTitle" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="{loc:LocBinding Routines.Count, Format=Routine_Count}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Routines.Count}" Value="0">
                                                            <Setter Property="Text" Value="{loc:Loc Ui_SavedRoutines}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Style="{StaticResource OpenFullListButtonStyle}" Command="{Binding ManageListCommand}" CommandParameter="Routines"
                                                AutomationProperties.Name="{loc:Loc Ui_OpenFullRoutineList}"
                                                Visibility="{Binding HasRoutines, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <i:Interaction.Behaviors>
                                                <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_OpenFullList}" />
                                            </i:Interaction.Behaviors>
                                        </Button>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ListBox
                                            x:Name="SavedRoutinesListBox"
                                            b:NestedListScrollBehavior.IsEnabled="True"
                                            AutomationProperties.Name="{loc:Loc Ui_SavedRoutines}"
                                            AutomationProperties.HelpText="{loc:Loc Ui_DragSelectedRoutinesToReorderOrUseAlt}"
                                            Grid.Column="0"
                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource RoutineListHeightConverter}}"
                                            Padding="3"
                                            ItemsSource="{Binding Routines}"
                                            PreviewMouseRightButtonDown="SavedRoutinesListBox_PreviewMouseRightButtonDown"
                                            MouseDoubleClick="SavedRoutinesListBox_MouseDoubleClick"
                                            ScrollViewer.CanContentScroll="True"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            SelectedIndex="{Binding SelectedRoutineIndex, Mode=TwoWay}"
                                            SelectionMode="Extended"
                                            VirtualizingPanel.IsVirtualizing="True"
                                            VirtualizingPanel.ScrollUnit="Item"
                                            VirtualizingPanel.VirtualizationMode="Recycling">
                                            <i:Interaction.Behaviors>
                                                <b:ListBoxSelectedItemsBehavior SelectedItems="{Binding SelectedRoutines}" />
                                                <b:ListBoxReorderBehavior ReorderCommand="{Binding ReorderRoutinesCommand}" />
                                            </i:Interaction.Behaviors>
                                            <ListBox.ContextMenu>
                                                <ContextMenu
                                                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                    Style="{DynamicResource AppContextMenuStyle}">
                                                    <MenuItem
                                                        Command="{Binding DuplicateRoutineCommand}"
                                                        Header="{loc:Loc Ui_Duplicate}"
                                                        Icon="{StaticResource AppMenuDuplicateIcon}"
                                                        Style="{DynamicResource AppContextMenuItemStyle}" />
                                                    <MenuItem
                                                        Command="{Binding CopyRoutineCommand}"
                                                        Header="{loc:Loc Ui_Copy}"
                                                        Icon="{StaticResource AppMenuCopyIcon}"
                                                        Style="{DynamicResource AppContextMenuItemStyle}" />
                                                    <Separator Style="{DynamicResource AppContextMenuSeparatorStyle}" />
                                                    <MenuItem Header="{loc:Loc Ui_OpenFullListText}" Command="{Binding ManageListCommand}" CommandParameter="Routines"
                                                              Icon="{StaticResource AppMenuExpandIcon}" Style="{DynamicResource AppContextMenuItemStyle}" />
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                            <ListBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding EditRoutineCommand}" />
                                                <KeyBinding Key="W" Command="{Binding RemoveRoutineCommand}" Modifiers="Control" />
                                                <KeyBinding Key="Up" Command="{Binding MoveRoutineUpCommand}" Modifiers="Alt" />
                                                <KeyBinding Key="Down" Command="{Binding MoveRoutineDownCommand}" Modifiers="Alt" />
                                            </ListBox.InputBindings>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                    <Setter Property="Height" Value="60" />
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                                    <Setter Property="AutomationProperties.ItemStatus" Value="{loc:LocBinding ListItemStatus, Message=True}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,0"
                                                                    Background="{DynamicResource ControlHoverBrush}" CornerRadius="7">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{loc:Loc Ui_Disabled}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                                <i:Interaction.Behaviors><b:TrimmedTextPopupBehavior /></i:Interaction.Behaviors>
                                                            </TextBlock>
                                                        </DockPanel>
                                                        <TextBlock Style="{StaticResource RoutineListSecondaryTextStyle}" Text="{loc:LocBinding TriggerPresentation, Observe=TriggerSummary}" TextTrimming="CharacterEllipsis">
                                                            <i:Interaction.Behaviors><b:TrimmedTextPopupBehavior /></i:Interaction.Behaviors>
                                                        </TextBlock>
                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RoutineListSecondaryTextStyle}">
                                                                    <Setter Property="Text" Value="{loc:LocBinding LastRunPresentation, Observe=LastRunStatusText}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasHotkeyWarning}" Value="True">
                                                                            <Setter Property="Text" Value="{loc:LocBinding HotkeyWarningSummary, Message=True}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource DialogWarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                                            <Setter Property="Text" Value="{loc:LocBinding ConflictSummary, Message=True}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource DialogWarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <i:Interaction.Behaviors><b:TrimmedTextPopupBehavior /></i:Interaction.Behaviors>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Button
                                                Height="30"
                                                Margin="0,0,0,4"
                                                Command="{Binding MoveRoutineUpCommand}"
                                                AutomationProperties.Name="{loc:Loc Ui_MoveUpText}">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Data="{x:Static controls:AppMenuGlyphs.MoveUp}"
                                                    Stretch="Uniform"
                                                    StrokeThickness="1.25"
                                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    Focusable="False"
                                                    IsHitTestVisible="False" />
                                                <i:Interaction.Behaviors>
                                                    <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_MoveUpText}" />
                                                </i:Interaction.Behaviors>
                                            </Button>
                                            <Button
                                                Height="30"
                                                Margin="0,0,0,4"
                                                Command="{Binding MoveRoutineDownCommand}"
                                                AutomationProperties.Name="{loc:Loc Ui_MoveDownText}">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Data="{x:Static controls:AppMenuGlyphs.MoveDown}"
                                                    Stretch="Uniform"
                                                    StrokeThickness="1.25"
                                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    Focusable="False"
                                                    IsHitTestVisible="False" />
                                                <i:Interaction.Behaviors>
                                                    <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_MoveDownText}" />
                                                </i:Interaction.Behaviors>
                                            </Button>
                                            <Button Height="30" Command="{Binding RemoveRoutineCommand}" Content="{loc:Loc Ui_RemoveText}" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,6,0,10" HorizontalAlignment="Center">
                                        <Button MinWidth="50" Margin="0,0,6,0" Command="{Binding AddRoutineCommand}" Content="{loc:Loc Ui_AddText}" />
                                        <Button MinWidth="50" Margin="0,0,6,0" Command="{Binding EditRoutineCommand}" Content="{loc:Loc Ui_EditText}" />
                                        <Button
                                            MinWidth="60"
                                            Margin="0,0,6,0"
                                            Command="{Binding EnableSelectedRoutinesCommand}"
                                            Content="{loc:Loc Ui_EnableText}" />
                                        <Button
                                            MinWidth="60"
                                            Margin="0,0,6,0"
                                            Command="{Binding DisableSelectedRoutinesCommand}"
                                            Content="{loc:Loc Ui_Disable}" />
                                        <Button MinWidth="112" Command="{Binding SaveRoutinesCommand}" Content="{loc:Loc Ui_SaveRoutines}">
                                            <i:Interaction.Behaviors><b:DeferredDisabledAppearanceBehavior /></i:Interaction.Behaviors>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                                <TextBlock
                                    x:Name="UnsavedRoutineChangesText"
                                    Margin="0,0,0,8"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    TextWrapping="Wrap"
                                    Text="{loc:Loc Ui_UnsavedChangesRunNowIncludesEditsSaveTo}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasUnsavedRoutineChanges}" Value="True" />
                                                        <Condition Binding="{Binding IsAutoSaveActive}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border
                                    Padding="10"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{Binding HasNoRoutines, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                        Foreground="{DynamicResource MutedTextBrush}"
                                        Text="{loc:Loc Ui_NoRoutinesYetClickAddToCreateOne}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Border>
                                <Border
                                    Padding="10"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{Binding HasNoSelectedRoutine, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                        Foreground="{DynamicResource MutedTextBrush}"
                                        Text="{loc:Loc Ui_SelectARoutineToViewItsDetails}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Border>
                                <Border
                                    Padding="8"
                                    b:ListBoxSelectedItemsBehavior.SelectionContext="{Binding SelectedRoutines}"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{Binding HasSelectedRoutine, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Loc Ui_RoutineDetails}" />
                                            <Button
                                                x:Name="RunSelectedRoutineButton"
                                                Grid.Column="1"
                                                Padding="10,4"
                                                Content="{loc:Loc Ui_RunNow}"
                                                Command="{Binding RunSelectedRoutineCommand}"
                                                AutomationProperties.HelpText="{loc:Loc Ui_RunThisRoutineOnceIncludingUnsavedEditsConditions}">
                                                <i:Interaction.Behaviors>
                                                    <b:HoverInfoPopupBehavior
                                                        Text="{loc:Loc Ui_RunThisRoutineOnceIncludingUnsavedEditsConditions}" />
                                                </i:Interaction.Behaviors>
                                            </Button>
                                        </Grid>
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Text="{Binding SelectedRoutine.Name}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,2,0,6"
                                            Foreground="{DynamicResource MutedTextBrush}"
                                            Text="{loc:LocBinding SelectedRoutine.StatusPresentation, Observe=SelectedRoutine.StatusLabel}" />
                                        <TextBlock FontWeight="SemiBold" Text="{loc:Loc Ui_Actions}" />
                                        <TextBlock
                                            Margin="0,2,0,6"
                                            Text="{loc:LocBinding SelectedRoutine.TargetPresentation, Observe=SelectedRoutine.RoutineDetailsTargetSummary}"
                                            TextWrapping="Wrap" />
                                        <StackPanel
                                            Margin="0,0,0,6"
                                            Visibility="{Binding SelectedRoutine.HasConditions, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock FontWeight="SemiBold" Text="{loc:Loc Ui_ConditionsAll}" />
                                            <TextBlock Text="{loc:LocBinding SelectedRoutine.ConditionsPresentation, Observe=SelectedRoutine.ConditionsSummary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{loc:Loc Ui_Triggers}" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Text="{loc:LocBinding SelectedRoutine.TriggerDetailsPresentation, Observe=SelectedRoutine.RoutineDetailsTriggerSummary}"
                                            TextWrapping="Wrap" />
                                        <TextBlock x:Name="RoutineNextTriggerPreview" Margin="0,6,0,0" Text="{loc:LocBinding SelectedRoutineSchedulePreview, Message=True}"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontWeight="SemiBold"
                                            Text="{loc:Loc Ui_Options}"
                                            Visibility="{Binding SelectedRoutine.HasRoutineDetailsOptions, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Text="{loc:LocBinding SelectedRoutine.OptionsPresentation, Observe=SelectedRoutine.RoutineDetailsOptionsSummary}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding SelectedRoutine.HasRoutineDetailsOptions, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource HotkeyConflictBrush}"
                                            Text="{loc:Loc Ui_ConflictWarning}"
                                            Visibility="{Binding SelectedRoutine.HasConflict, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Foreground="{DynamicResource HotkeyConflictBrush}"
                                            Text="{loc:LocBinding SelectedRoutine.ConflictSummary, Message=True}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding SelectedRoutine.HasConflict, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource RoutineHotkeyWarningTextStyle}"
                                            Tag="{Binding SelectedRoutine.HotkeyWarningKind}"
                                            Text="{loc:Loc Ui_HotkeyWarning}"
                                            Visibility="{Binding SelectedRoutine.HasHotkeyWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource RoutineHotkeyWarningTextStyle}"
                                            Tag="{Binding SelectedRoutine.HotkeyWarningKind}"
                                            Text="{loc:LocBinding SelectedRoutine.HotkeyWarningSummary, Message=True}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding SelectedRoutine.HasHotkeyWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontWeight="SemiBold"
                                            Text="{loc:Loc Ui_ApplicationRoutingTarget}"
                                            Visibility="{Binding SelectedRoutine.RouteToApplication, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Text="{Binding SelectedRoutine.TargetAppPath}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding SelectedRoutine.RouteToApplication, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </b:DeferredTabContentBehavior.Template>
                </TabItem>
                <TabItem AutomationProperties.AutomationId="SettingsTab" Header="{loc:Loc Common_Settings}" Tag="{Binding SettingsTabSaveState}"
                    HeaderTemplate="{StaticResource SaveFeedbackTabHeaderTemplate}"
                    AutomationProperties.ItemStatus="{loc:LocBinding SettingsTabFeedbackPresentation}">
                    <b:DeferredTabContentBehavior.Template>
                        <DataTemplate>
                            <StackPanel Margin="8,10,8,10">
                                <TextBlock Margin="0,0,0,10" TextAlignment="Center">
                                    <Hyperlink NavigateUri="{Binding Source={x:Static constants:AppConstants+Links.WebsiteUrl}, Mode=OneTime}"
                                        AutomationProperties.HelpText="{loc:Loc Ui_OpensTheAudioPilotWebsiteWithDownloadsScreenshotsAnd}"
                                        PreviewKeyDown="ProjectLink_PreviewKeyDown"
                                        RequestNavigate="ProjectLink_RequestNavigate"
                                        Style="{StaticResource SettingsProjectLinkStyle}"><Run Text="{loc:Loc Common_Website}" /></Hyperlink>
                                </TextBlock>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Label Content="{loc:Loc Settings_Language}" VerticalAlignment="Center" Target="{Binding ElementName=LanguageSelector}" Margin="0,0,12,0" />
                                    <ComboBox x:Name="LanguageSelector" Grid.Column="1" MinWidth="150" HorizontalAlignment="Left"
                                        ItemsSource="{x:Static loc:LocalizationService.Languages}" SelectedValuePath="Code"
                                        SelectedValue="{Binding SettingsLanguageDraft, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_ChangeName}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:LocBinding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                        <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{loc:Loc Settings_LanguageHelp}" /></i:Interaction.Behaviors>
                                    </ComboBox>
                                </Grid>
                                <views:SettingsDeviceSwitchingPanel />
                                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{loc:Loc Ui_GlobalHotkeys}" />
                                <TextBlock
                                    Margin="0,0,0,10"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Text="{loc:Loc Ui_LeaveAShortcutBlankToDisableIt}" />
                                <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="{loc:Loc Ui_App}" />
                                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                    <Label Width="150" VerticalAlignment="Center" Content="{loc:Loc Ui_ShowHideApp}" />
                                    <TextBox
                                        Width="{DynamicResource SettingsFieldWidth}"
                                        AutomationProperties.Name="{loc:Loc Ui_ShowOrHideAppHotkey}"
                                        ContextMenu="{StaticResource HotkeyDeleteContextMenu}"
                                        Text="{Binding SettingsToggleAppVisibilityHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                                        <i:Interaction.Behaviors>
                                            <b:HotkeyPlaceholderBehavior />
                                            <b:HoverInfoPopupBehavior
                                                Text="{loc:LocBinding SettingsToggleAppVisibilityHotkeyDraftCapture.HoverText, Message=True}"
                                                WarningKind="{Binding SettingsToggleAppVisibilityHotkeyDraftCapture.WarningKind}" />
                                            <b:HotkeyCaptureBehavior Target="{Binding SettingsToggleAppVisibilityHotkeyDraftCapture}" />
                                            <b:HotkeyWarningBorderBehavior
                                                HasWarning="{Binding SettingsToggleAppVisibilityHotkeyDraftCapture.HasWarning}"
                                                WarningKind="{Binding SettingsToggleAppVisibilityHotkeyDraftCapture.WarningKind}" />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                    <Label Width="150" VerticalAlignment="Center" Content="{loc:Loc Ui_ShowAudioStatus}" />
                                    <TextBox
                                        Width="{DynamicResource SettingsFieldWidth}"
                                        AutomationProperties.Name="{loc:Loc Ui_ShowAudioStatusHotkey}"
                                        ContextMenu="{StaticResource HotkeyDeleteContextMenu}"
                                        Text="{Binding SettingsShowAudioStatusHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                                        <i:Interaction.Behaviors>
                                            <b:HotkeyPlaceholderBehavior />
                                            <b:HoverInfoPopupBehavior
                                                Text="{loc:LocBinding SettingsShowAudioStatusHotkeyDraftCapture.HoverText, Message=True}"
                                                WarningKind="{Binding SettingsShowAudioStatusHotkeyDraftCapture.WarningKind}" />
                                            <b:HotkeyCaptureBehavior Target="{Binding SettingsShowAudioStatusHotkeyDraftCapture}" />
                                            <b:HotkeyWarningBorderBehavior
                                                HasWarning="{Binding SettingsShowAudioStatusHotkeyDraftCapture.HasWarning}"
                                                WarningKind="{Binding SettingsShowAudioStatusHotkeyDraftCapture.WarningKind}" />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                    <Label Width="150" VerticalAlignment="Center" Content="{loc:Loc Ui_DevicePicker}" />
                                    <TextBox
                                        Width="{DynamicResource SettingsFieldWidth}"
                                        AutomationProperties.Name="{loc:Loc Ui_QuickDevicePickerHotkey}"
                                        ContextMenu="{StaticResource HotkeyDeleteContextMenu}"
                                        Text="{Binding SettingsQuickDevicePickerHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                                        <i:Interaction.Behaviors>
                                            <b:HotkeyPlaceholderBehavior />
                                            <b:HoverInfoPopupBehavior
                                                Text="{loc:LocBinding SettingsQuickDevicePickerHotkeyDraftCapture.HoverText, Message=True}"
                                                WarningKind="{Binding SettingsQuickDevicePickerHotkeyDraftCapture.WarningKind}" />
                                            <b:HotkeyCaptureBehavior Target="{Binding SettingsQuickDevicePickerHotkeyDraftCapture}" />
                                            <b:HotkeyWarningBorderBehavior
                                                HasWarning="{Binding SettingsQuickDevicePickerHotkeyDraftCapture.HasWarning}"
                                                WarningKind="{Binding SettingsQuickDevicePickerHotkeyDraftCapture.WarningKind}" />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                </StackPanel>
                                <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="{loc:Loc Ui_Media}" />
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <Label Width="150" VerticalAlignment="Center" Content="{loc:Loc Ui_ShowCurrentTrack}" />
                                    <TextBox
                                        Width="{DynamicResource SettingsFieldWidth}"
                                        AutomationProperties.Name="{loc:Loc Ui_ShowCurrentTrackHotkey}"
                                        ContextMenu="{StaticResource HotkeyDeleteContextMenu}"
                                        Text="{Binding SettingsShowCurrentTrackHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                                        <i:Interaction.Behaviors>
                                            <b:HotkeyPlaceholderBehavior />
                                            <b:HoverInfoPopupBehavior
                                                Text="{loc:LocBinding SettingsShowCurrentTrackHotkeyDraftCapture.HoverText, Message=True}"
                                                WarningKind="{Binding SettingsShowCurrentTrackHotkeyDraftCapture.WarningKind}" />
                                            <b:HotkeyCaptureBehavior Target="{Binding SettingsShowCurrentTrackHotkeyDraftCapture}" />
                                            <b:HotkeyWarningBorderBehavior
                                                HasWarning="{Binding SettingsShowCurrentTrackHotkeyDraftCapture.HasWarning}"
                                                WarningKind="{Binding SettingsShowCurrentTrackHotkeyDraftCapture.WarningKind}" />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                </StackPanel>
