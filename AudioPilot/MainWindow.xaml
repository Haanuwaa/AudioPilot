                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <Label Width="150" VerticalAlignment="Center" Content="Play/pause:" />
                                    <TextBox
                                        Width="170"
                                        AutomationProperties.Name="Play or pause hotkey"
                                        ContextMenu="{StaticResource HotkeyDeleteContextMenu}"
                                        Text="{Binding SettingsPlayPauseHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                                        <i:Interaction.Behaviors>
                                            <b:PlaceholderExampleBehavior
                                                Identity="play-pause-hotkey"
                                                Options="Ctrl+Alt+P|Alt+MouseMiddle"
                                                PreferredFamily="mouse-middle" />
                                            <b:HoverInfoPopupBehavior
                                                Text="{Binding SettingsPlayPauseHotkeyDraftCapture.HoverText}"
                                                WarningKind="{Binding SettingsPlayPauseHotkeyDraftCapture.WarningKind}" />
                                            <b:HotkeyCaptureBehavior Target="{Binding SettingsPlayPauseHotkeyDraftCapture}" />
                                            <b:HotkeyWarningBorderBehavior
                                                HasWarning="{Binding SettingsPlayPauseHotkeyDraftCapture.HasWarning}"
                                                WarningKind="{Binding SettingsPlayPauseHotkeyDraftCapture.WarningKind}" />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <Label Width="150" VerticalAlignment="Center" Content="Next track:" />
                                    <TextBox
                                        Width="170"
                                        AutomationProperties.Name="Next track hotkey"
                                        ContextMenu="{StaticResource HotkeyDeleteContextMenu}"
                                        Text="{Binding SettingsNextTrackHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                                        <i:Interaction.Behaviors>
                                            <b:PlaceholderExampleBehavior
                                                Identity="next-track-hotkey"
                                                Options="Ctrl+Alt+Right|Alt+MouseX2"
