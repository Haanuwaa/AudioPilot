                                            <TextBlock Text="{loc:LocBinding EndpointLabel}" FontSize="11" FontWeight="Normal"
                                                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsEndpoint, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                        <Label.Style>
                                            <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="{x:Type Label}">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApplication}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMaster}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMic}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSystemSounds}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>
                                    <Slider
                                        Grid.Column="1"
                                        AutomationProperties.Name="{loc:LocBinding DisplayLabel}"
                                        AutomationProperties.HelpText="{loc:Loc Ui_RightClickTheSliderKnobOrPressSpace}"
                                        VerticalAlignment="Center"
                                        IsMoveToPointEnabled="True"
                                        LargeChange="5"
                                        Maximum="100"
                                        SmallChange="0.1"
                                        Tag="{Binding IsMuted}"
                                        Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalAlignment="Stretch">
                                        <i:Interaction.Behaviors>
                                            <b:SliderThumbRightClickBehavior
                                                Command="{Binding DataContext.ActiveMixer.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                            <b:SliderKeyboardAccelerationBehavior
                                                MuteCommand="{Binding DataContext.ActiveMixer.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                MuteCommandParameter="{Binding}" />
                                        </i:Interaction.Behaviors>
                                    </Slider>
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding Volume, StringFormat={}{0:0.#}%}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Margin="4,0,6,0"
                                        Style="{StaticResource AppSecondaryTextStyle}" />
                                    <Button x:Name="MixerMuteButton" Grid.Column="3" Margin="4,0,0,0"
                                            Style="{StaticResource MixerMuteButtonStyle}"
                                            Command="{Binding DataContext.ActiveMixer.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <i:Interaction.Behaviors>
                                            <b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.HelpText), ElementName=MixerMuteButton}" />
                                        </i:Interaction.Behaviors>
                                        <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent" StrokeThickness="1.4"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Focusable="False" IsHitTestVisible="False">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.Output}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.OutputMuted}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMic}" Value="True">
                                                            <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.Input}" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsMic}" Value="True" />
                                                                <Condition Binding="{Binding IsMuted}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.InputMuted}" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsApplication}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.SelectedSettingsTabIndex, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="1" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.Input}" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsMuted}" Value="True" />
                                                                <Condition Binding="{Binding IsApplication}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.SelectedSettingsTabIndex, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="1" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Data" Value="{x:Static controls:AppMenuGlyphs.InputMuted}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>
                                    <ContentControl Grid.Row="1" Grid.ColumnSpan="4" Focusable="False">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRoutingExpanded}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Content" Value="{Binding}" />
                                                        <Setter Property="ContentTemplate" Value="{StaticResource MixerRoutingDetailsTemplate}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </controls:MixerListBox>
                </controls:VirtualizedMixerViewport>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,8" MaxWidth="760"
            Visibility="{Binding IsSettingsTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid x:Name="SettingsSaveModeNotice" Height="24" HorizontalAlignment="Center" Margin="0,0,0,4"
                AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="{loc:Loc Ui_ApplySettingsToSaveYourChanges}" TextAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource AppSecondaryTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAutoSaveActive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border CornerRadius="12" Padding="10,1" BorderThickness="1"
                    BorderBrush="{DynamicResource DialogSuccessBrush}" Background="{DynamicResource ControlBackgroundBrush}"
                    Visibility="{Binding IsAutoSaveActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{loc:Loc Common_AutoSave}" VerticalAlignment="Center" Foreground="{DynamicResource DialogSuccessBrush}" />
                </Border>
            </Grid>
            <WrapPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Visibility="{Binding IsSettingsTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="{loc:Loc Common_Import}" Command="{Binding ImportSettingsCommand}" MinWidth="96" Margin="0,0,8,0">
                    <i:Interaction.Behaviors><b:DeferredDisabledAppearanceBehavior /></i:Interaction.Behaviors>
                </Button>
                <Button Content="{loc:Loc Common_Export}" Command="{Binding ExportSettingsCommand}" MinWidth="96" Margin="0,0,8,0">
                    <i:Interaction.Behaviors><b:DeferredDisabledAppearanceBehavior /></i:Interaction.Behaviors>
                </Button>
                <Button
                    Content="{loc:Loc Common_Apply}"
                    Command="{Binding ApplySettingsCommand}"
                    MinWidth="120"
                    Style="{StaticResource AppPrimaryButtonStyle}">
                    <i:Interaction.Behaviors><b:DeferredDisabledAppearanceBehavior /></i:Interaction.Behaviors>
                </Button>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
