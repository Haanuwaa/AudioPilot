<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <PublishProtocol>FileSystem</PublishProtocol>
    <AudioPilotPortableProfile>true</AudioPilotPortableProfile>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildProjectDirectory)\..\artifacts\portable\FrameworkDependent\win-arm64\AudioPilot\</PublishDir>
    <AudioPilotPayloadDir>$(MSBuildProjectDirectory)\..\artifacts\publish\FrameworkDependent\win-arm64\</AudioPilotPayloadDir>
  </PropertyGroup>
</Project>