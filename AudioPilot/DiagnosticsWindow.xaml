<Window x:Class="AudioPilot.DiagnosticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AudioPilot.Localization"
    Title="{loc:Loc Ui_AudioPilotDiagnostics}" Width="680" Height="600" MinWidth="480" MinHeight="480" FontFamily="Segoe UI" FontSize="13"
    UseLayoutRounding="True" SnapsToDevicePixels="True" ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="Manual" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Help" Executed="OpenAbout_Click" /></Window.CommandBindings>
    <Window.InputBindings><KeyBinding Key="F1" Command="ApplicationCommands.Help" /></Window.InputBindings>
    <Grid Margin="20" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="HealthRowTemplate">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    <TextBox x:Name="DiagnosticValue" Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{DynamicResource AppSelectableTextStyle}" AutomationProperties.Name="{Binding Key}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="OperationTemplate">
                <Grid Margin="3,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LocalTime}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{loc:LocBinding HeadingPresentation}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Context}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="AdviceTemplate">
                <StackPanel Margin="0,6,0,8">
                    <TextBlock Text="{loc:LocBinding Summary, Message=True}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:LocBinding NextStep, Message=True}" Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Button x:Name="ReviewAdviceButton" Content="{loc:Loc Ui_ReviewSetting}" Click="ReviewSetting_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding CanReview}" Value="True"><Setter TargetName="ReviewAdviceButton" Property="Visibility" Value="Visible" /></DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="{loc:Loc Ui_Refresh}" Click="Refresh_Click" Margin="8,0,0,0" VerticalAlignment="Bottom"
                    AutomationProperties.HelpText="{loc:Loc Ui_UpdatesThisSnapshotUsingTheLatestRecordedInformation}" />
            <StackPanel>
                <TextBlock Text="{loc:Loc Ui_Diagnostics}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="BuildSummary" Style="{StaticResource AppSecondaryTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer x:Name="HealthScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="{loc:Loc Ui_DiagnosticsOverviewRecentOperationsAndDetails}">
            <StackPanel Margin="0,0,8,0">
                <Border Padding="10" Margin="0,0,0,12" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Ui_Overview}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ItemsControl x:Name="HealthRows" ItemTemplate="{StaticResource HealthRowTemplate}" />
                        <TextBlock x:Name="NoAdvice" Text="{loc:Loc Ui_NoActionsSuggestedByThisSnapshot}" Style="{StaticResource AppSecondaryTextStyle}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <Expander x:Name="GuidanceDetails" Header="{loc:Loc Ui_WhatToCheck}" Style="{StaticResource AppExpanderStyle}" IsExpanded="False" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Ui_SuggestionsForTheRecordedSnapshotReviewSettingNavigates}"
                                   Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,6" />
                        <ItemsControl x:Name="AdviceRows" ItemTemplate="{StaticResource AdviceTemplate}" />
                    </StackPanel>
                </Expander>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Ui_RecentOperations}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox x:Name="HistoryFilter" Grid.Column="1" SelectedIndex="0" MinWidth="90" SelectionChanged="HistoryFilter_SelectionChanged" AutomationProperties.Name="{loc:Loc Ui_FilterRecentOperations}" Visibility="Collapsed">
                        <ComboBoxItem Content="{loc:Loc Ui_All}" /><ComboBoxItem Content="{loc:Loc Ui_Issues}" />
                    </ComboBox>
                </Grid>
                <TextBlock x:Name="OperationsHint" Text="{loc:Loc Ui_UpTo30RecentOperationsFromThisSession}" Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                <TextBlock x:Name="EmptyOperations" Text="{loc:Loc Ui_NoSnapshotAvailable}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <ListBox x:Name="OperationsList" ItemTemplate="{StaticResource OperationTemplate}" MaxHeight="230" MinHeight="80" HorizontalContentAlignment="Stretch" Margin="0,0,0,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OperationsList_SelectionChanged" AutomationProperties.Name="{loc:Loc Ui_RecentOperations}"
                         PreviewKeyDown="OperationsList_PreviewKeyDown" Visibility="Collapsed"
                         AutomationProperties.HelpText="{loc:Loc Ui_SelectAnOperationAndPressEnterToInspect}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{loc:LocBinding AccessibleHeading}" />
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Context}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <Expander x:Name="OperationDetails" Header="{loc:Loc Ui_OperationDetails}" Style="{StaticResource AppExpanderStyle}" IsExpanded="False" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <Button x:Name="CopyOperationButton" Content="{loc:Loc Ui_CopyOperation}" Click="CopyOperation_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,6,0,8"
                                AutomationProperties.HelpText="{loc:Loc Ui_CopiesOnlyTheSelectedRedactedOperationIncludingIts}" />
                        <TextBox x:Name="Report" Style="{DynamicResource AppSelectableTextStyle}" MinHeight="70" MaxHeight="180" Padding="10" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Loc Ui_RedactedOperationDetails}" />
                        <ContentControl x:Name="OperationAdvice" ContentTemplate="{StaticResource AdviceTemplate}" />
                    </StackPanel>
                </Expander>
                <Expander x:Name="HotkeyDetails" Style="{StaticResource AppExpanderStyle}" Header="{loc:Loc Ui_HotkeyRegistration}" IsExpanded="False" Margin="0,0,0,8">
                    <StackPanel>
                        <ItemsControl x:Name="DetailRows" ItemTemplate="{StaticResource HealthRowTemplate}" Margin="0,6,0,0" />
                        <TextBlock Text="{loc:Loc Ui_LastRegistrationAttemptsShortcutDeliveryIsNotTested}" Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>
                <Expander x:Name="ProcessMonitorDetails" Style="{StaticResource AppExpanderStyle}" Header="{loc:Loc Ui_AutomationAndProcessMonitor}" IsExpanded="False" Margin="0,0,0,8">
                    <StackPanel>
                        <ItemsControl x:Name="AutomationRows" ItemTemplate="{StaticResource HealthRowTemplate}" Margin="0,6,0,0" />
                        <TextBlock Text="{loc:Loc Ui_ComponentsStartOnlyWhenNeededInactiveMonitoringCan}"
                                   Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,10" />
                        <Button x:Name="TestProcessMonitorButton" Content="{loc:Loc Ui_TestProcessMonitor}" Click="TestProcessMonitor_Click" HorizontalAlignment="Left" />
                        <TextBox x:Name="ProcessMonitorReport" Text="{loc:Loc Ui_NotTestedInThisWindow}" Style="{DynamicResource AppSelectableTextStyle}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{loc:Loc Ui_AutomationAndProcessMonitor}" />
                    </StackPanel>
                </Expander>
                <Expander x:Name="EnvironmentDetails" Style="{StaticResource AppExpanderStyle}" Header="{loc:Loc Ui_AudioAndAppHealth}" IsExpanded="False" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Ui_AudioDefaults}" FontWeight="SemiBold" Margin="0,6,0,4" />
                        <ItemsControl x:Name="AudioRows" ItemTemplate="{StaticResource HealthRowTemplate}" />
                        <TextBlock Text="{loc:Loc Ui_TheSnapshotShowsCachedWindowsDefaultsDifferentDefaults}" Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,8" />
                        <Button x:Name="CheckAudioDefaultsButton" Content="{loc:Loc Ui_CheckAudioDefaults}" Click="CheckAudioDefaults_Click" HorizontalAlignment="Left" Margin="0,0,0,8"
                                AutomationProperties.HelpText="{loc:Loc Ui_ReadsTheCurrentWindowsDefaultsForAudioPilotS}" />
                        <TextBox x:Name="AudioDefaultsCheckStatus" Style="{DynamicResource AppSelectableTextStyle}" Margin="0,0,0,10" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{loc:Loc Ui_AudioDefaults}" />
                        <TextBlock Text="{loc:Loc Common_Settings}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ItemsControl x:Name="SettingsRows" ItemTemplate="{StaticResource HealthRowTemplate}" />
                        <Button x:Name="SettingsFolderButton" Content="{loc:Loc Ui_OpenSettingsFolder}" Click="OpenFolder_Click" HorizontalAlignment="Left" Margin="0,6,0,0"
                                AutomationProperties.HelpText="{loc:Loc Ui_OpenTheActiveSettingsFolderIncludingItsSettings}" />
                        <TextBlock Text="{loc:Loc Ui_Logging}" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <ItemsControl x:Name="LoggingRows" ItemTemplate="{StaticResource HealthRowTemplate}" />
                        <Button x:Name="LogsFolderButton" Content="{loc:Loc Ui_OpenLogsFolder}" Click="OpenFolder_Click" HorizontalAlignment="Left" Margin="0,6,0,0"
                                AutomationProperties.HelpText="{loc:Loc Ui_OpenTheLoggerSActualFolderIncludingIts}" />
                        <TextBlock Text="{loc:Loc Ui_SleepResumeRecovery}" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <ItemsControl x:Name="RecoveryRows" ItemTemplate="{StaticResource HealthRowTemplate}" />
                    </StackPanel>
                </Expander>
                <Expander x:Name="ProcessDetails" Style="{StaticResource AppExpanderStyle}" Header="{loc:Loc Ui_AppResources}" IsExpanded="False" Margin="0,0,0,8">
                    <StackPanel>
                        <ItemsControl x:Name="ProcessRows" ItemTemplate="{StaticResource HealthRowTemplate}" Margin="0,6,0,0" />
                        <TextBlock x:Name="ResourceComparison" Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{loc:Loc Ui_SampledOnOpenAndRefreshWithoutPollingOr}"
                                   Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>
                <Expander x:Name="BuildDetails" Style="{StaticResource AppExpanderStyle}" Header="{loc:Loc Ui_AppAndBuild}" IsExpanded="False" Margin="0,0,0,4">
                    <StackPanel>
                        <ItemsControl x:Name="BuildRows" ItemTemplate="{StaticResource HealthRowTemplate}" Margin="0,6,0,0" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="CopyBuildInfoButton" Content="{loc:Loc Ui_CopyBuildInfo}" Click="CopyBuildInfo_Click" Margin="0,0,8,4" />
                            <Button x:Name="OpenAboutButton" Content="{loc:Loc Ui_OpenABOUTTxt}" Click="OpenAbout_Click" Margin="0,0,8,4" AutomationProperties.HelpText="{loc:Loc Ui_OpensThePackagedReferenceDocumentOrTheOnline}" />
                            <Button Content="{loc:Loc Ui_ProjectRepository}" Click="OpenRepository_Click" Margin="0,0,0,4" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="Status" Grid.Row="2" Margin="0,10" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button x:Name="CopyDiagnosticsButton" Content="{loc:Loc Ui_CopyDiagnostics}" Click="CopyDiagnostics_Click" IsEnabled="False" Margin="0,0,8,4"
                    AutomationProperties.HelpText="{loc:Loc Ui_CopiesTheCompleteRedactedSnapshotIncludingCollapsedDetails}" />
            <Button x:Name="ExportButton" Content="{loc:Loc Ui_SaveSupportBundle}" Click="Export_Click" Margin="0,0,8,4" />
            <Button Content="{loc:Loc Ui_Close}" IsCancel="True" Margin="0,0,0,4" />
        </WrapPanel>
    </Grid>
</Window>
