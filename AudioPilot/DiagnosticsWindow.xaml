<Window x:Class="AudioPilot.DiagnosticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AudioPilot Diagnostics" Width="680" Height="600" MinWidth="480" MinHeight="480" FontFamily="Segoe UI" FontSize="13"
    UseLayoutRounding="True" SnapsToDevicePixels="True" ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="Manual" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Help" Executed="OpenAbout_Click" /></Window.CommandBindings>
    <Window.InputBindings><KeyBinding Key="F1" Command="ApplicationCommands.Help" /></Window.InputBindings>
    <Grid Margin="20" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="HealthRowTemplate">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="OperationTemplate">
                <Grid Margin="3,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LocalTime}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Context}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="AdviceTemplate">
                <StackPanel Margin="0,6,0,8">
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NextStep}" Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Button x:Name="ReviewAdviceButton" Content="Review setting" Click="ReviewSetting_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding CanReview}" Value="True"><Setter TargetName="ReviewAdviceButton" Property="Visibility" Value="Visible" /></DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Margin="8,0,0,0" VerticalAlignment="Bottom"
                    AutomationProperties.HelpText="Updates this snapshot using the latest recorded information." />
            <StackPanel>
                <TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="BuildSummary" Style="{StaticResource AppSecondaryTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer x:Name="HealthScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="Diagnostics overview, recent operations, and details">
            <StackPanel Margin="0,0,8,0">
                <Border Padding="10" Margin="0,0,0,12" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Overview" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ItemsControl x:Name="HealthRows" ItemTemplate="{StaticResource HealthRowTemplate}" />
                        <TextBlock x:Name="NoAdvice" Text="No actions suggested by this snapshot." Style="{StaticResource AppSecondaryTextStyle}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <Expander x:Name="GuidanceDetails" Header="What to check" Style="{StaticResource AppExpanderStyle}" IsExpanded="False" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Suggestions for the recorded snapshot. Review setting navigates without applying changes."
                                   Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,6" />
                        <ItemsControl x:Name="AdviceRows" ItemTemplate="{StaticResource AdviceTemplate}" />
                    </StackPanel>
                </Expander>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Recent operations" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox x:Name="HistoryFilter" Grid.Column="1" SelectedIndex="0" MinWidth="90" SelectionChanged="HistoryFilter_SelectionChanged" AutomationProperties.Name="Filter recent operations" Visibility="Collapsed">
                        <ComboBoxItem Content="All" /><ComboBoxItem Content="Issues" />
                    </ComboBox>
                </Grid>
                <TextBlock x:Name="OperationsHint" Text="Up to 30 recent operations from this session. Refresh to update." Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                <TextBlock x:Name="EmptyOperations" Text="No snapshot available." TextWrapping="Wrap" Margin="0,0,0,12" />
                <ListBox x:Name="OperationsList" ItemTemplate="{StaticResource OperationTemplate}" MaxHeight="230" MinHeight="80" HorizontalContentAlignment="Stretch" Margin="0,0,0,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OperationsList_SelectionChanged" AutomationProperties.Name="Recent operations"
                         PreviewKeyDown="OperationsList_PreviewKeyDown" Visibility="Collapsed"
                         AutomationProperties.HelpText="Select an operation and press Enter to inspect its redacted details.">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name">
                                <Setter.Value>
                                    <MultiBinding StringFormat="{}{0}, {1}">
                                        <Binding Path="LocalTime" /><Binding Path="Heading" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Context}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <Expander x:Name="OperationDetails" Header="Operation details" Style="{StaticResource AppExpanderStyle}" IsExpanded="False" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <Button x:Name="CopyOperationButton" Content="Copy operation" Click="CopyOperation_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,6,0,8"
                                AutomationProperties.HelpText="Copies only the selected redacted operation, including its log trace ID when recorded." />
                        <TextBox x:Name="Report" IsReadOnly="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="180" Padding="10" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Redacted operation details" />
                        <ContentControl x:Name="OperationAdvice" ContentTemplate="{StaticResource AdviceTemplate}" />
                    </StackPanel>
                </Expander>
                <Expander x:Name="HotkeyDetails" Style="{StaticResource AppExpanderStyle}" Header="Hotkey registration" IsExpanded="False" Margin="0,0,0,8">
                    <StackPanel>
                        <ItemsControl x:Name="DetailRows" ItemTemplate="{StaticResource HealthRowTemplate}" Margin="0,6,0,0" />
                        <TextBlock Text="Last registration attempts; shortcut delivery is not tested." Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>
                <Expander x:Name="ProcessMonitorDetails" Style="{StaticResource AppExpanderStyle}" Header="Automation and process monitor" IsExpanded="False" Margin="0,0,0,8">
                    <StackPanel>
                        <ItemsControl x:Name="AutomationRows" ItemTemplate="{StaticResource HealthRowTemplate}" Margin="0,6,0,0" />
                        <TextBlock Text="Components start only when needed. Inactive monitoring can be normal. The test below creates a temporary process to check WMI start and stop events; monitoring settings stay unchanged."
                                   Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,10" />
                        <Button x:Name="TestProcessMonitorButton" Content="Test process monitor" Click="TestProcessMonitor_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="ProcessMonitorReport" Text="Not tested in this window." TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Expander>
                <Expander x:Name="EnvironmentDetails" Style="{StaticResource AppExpanderStyle}" Header="Audio and app health" IsExpanded="False" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Audio defaults" FontWeight="SemiBold" Margin="0,6,0,4" />
                        <ItemsControl x:Name="AudioRows" ItemTemplate="{StaticResource HealthRowTemplate}" />
                        <TextBlock Text="The snapshot shows cached Windows defaults. Different defaults across roles can be intentional." Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,8" />
                        <Button x:Name="CheckAudioDefaultsButton" Content="Check audio defaults" Click="CheckAudioDefaults_Click" HorizontalAlignment="Left" Margin="0,0,0,8"
                                AutomationProperties.HelpText="Reads the current Windows defaults for AudioPilot's output and input roles without changing devices." />
                        <TextBlock x:Name="AudioDefaultsCheckStatus" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Settings" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ItemsControl x:Name="SettingsRows" ItemTemplate="{StaticResource HealthRowTemplate}" />
                        <Button x:Name="SettingsFolderButton" Content="Open settings folder" Click="OpenFolder_Click" HorizontalAlignment="Left" Margin="0,6,0,0"
                                AutomationProperties.HelpText="Open the active settings folder, including its settings backups." />
                        <TextBlock Text="Logging" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <ItemsControl x:Name="LoggingRows" ItemTemplate="{StaticResource HealthRowTemplate}" />
                        <Button x:Name="LogsFolderButton" Content="Open logs folder" Click="OpenFolder_Click" HorizontalAlignment="Left" Margin="0,6,0,0"
                                AutomationProperties.HelpText="Open the logger's actual folder, including its log backups." />
                        <TextBlock Text="Sleep/resume recovery" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <ItemsControl x:Name="RecoveryRows" ItemTemplate="{StaticResource HealthRowTemplate}" />
                    </StackPanel>
                </Expander>
                <Expander x:Name="ProcessDetails" Style="{StaticResource AppExpanderStyle}" Header="App resources" IsExpanded="False" Margin="0,0,0,8">
                    <StackPanel>
                        <ItemsControl x:Name="ProcessRows" ItemTemplate="{StaticResource HealthRowTemplate}" Margin="0,6,0,0" />
                        <TextBlock x:Name="ResourceComparison" Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="Sampled on open and Refresh, without polling or forced garbage collection. Allocated since start is cumulative allocation, not retained memory; an increase alone does not establish a leak. Copy diagnostics includes precise byte counts."
                                   Style="{StaticResource AppSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>
                <Expander x:Name="BuildDetails" Style="{StaticResource AppExpanderStyle}" Header="App and build" IsExpanded="False" Margin="0,0,0,4">
                    <StackPanel>
                        <ItemsControl x:Name="BuildRows" ItemTemplate="{StaticResource HealthRowTemplate}" Margin="0,6,0,0" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="CopyBuildInfoButton" Content="Copy build info" Click="CopyBuildInfo_Click" Margin="0,0,8,4" />
                            <Button x:Name="OpenAboutButton" Content="Open ABOUT.txt" Click="OpenAbout_Click" Margin="0,0,8,4" AutomationProperties.HelpText="Opens the packaged reference document, or the online user guide if unavailable. F1 also opens this reference." />
                            <Button Content="Project repository" Click="OpenRepository_Click" Margin="0,0,0,4" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="Status" Grid.Row="2" Margin="0,10" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button x:Name="CopyDiagnosticsButton" Content="Copy diagnostics" Click="CopyDiagnostics_Click" IsEnabled="False" Margin="0,0,8,4"
                    AutomationProperties.HelpText="Copies the complete redacted snapshot, including collapsed details and operations hidden by the filter." />
            <Button x:Name="ExportButton" Content="Save support bundle…" Click="Export_Click" Margin="0,0,8,4" />
            <Button Content="Close" IsCancel="True" Margin="0,0,0,4" />
        </WrapPanel>
    </Grid>
</Window>
