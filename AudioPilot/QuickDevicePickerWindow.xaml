<Window x:Class="AudioPilot.QuickDevicePickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:b="clr-namespace:AudioPilot.Behaviors"
    xmlns:loc="clr-namespace:AudioPilot.Localization"
    Title="{loc:Loc Picker_Title}" Width="460" Height="440" WindowStyle="None" ResizeMode="NoResize"
    ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
    AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextBrush}"
    PreviewKeyDown="OnPreviewKeyDown" PreviewTextInput="OnPreviewTextInput" Deactivated="OnDeactivated">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
    </Window.InputBindings>
    <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="✕" Width="28" Padding="0" Click="OnCloseClick" AutomationProperties.Name="{loc:Loc Picker_Close}" />
                <TextBlock Text="{loc:Loc Picker_Heading}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <Grid x:Name="DeviceHeaderGrid" Grid.Row="1" Margin="0,0,0,10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TabControl x:Name="DeviceTabs" SelectionChanged="OnTabChanged" IsEnabled="{Binding CanBrowse}" VerticalAlignment="Center">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" />
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem Header="{loc:Loc Common_Output}" />
                    <TabItem Header="{loc:Loc Common_Input}" />
                </TabControl>
                <CheckBox x:Name="ShowAllDevicesCheckBox" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                    AutomationProperties.Name="{loc:Loc Picker_ShowAll}"
                    IsChecked="{Binding ShowAllDevices, Mode=TwoWay}" IsEnabled="{Binding CanBrowse}"
                    Checked="OnShowAllDevicesChanged" Unchecked="OnShowAllDevicesChanged">
                    <TextBlock Text="{loc:Loc Picker_ShowAll}" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" />
                    <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{loc:Loc Picker_ShowAllHelp}" /></i:Interaction.Behaviors>
                </CheckBox>
                <Border x:Name="TabDivider" Grid.Row="1" Grid.ColumnSpan="2" Height="1" Margin="0,4,0,0" Background="{Binding BorderBrush, ElementName=DeviceTabs}" />
            </Grid>
            <TextBox x:Name="SearchBox" Grid.Row="2" Margin="0,0,0,10"
                Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBrowse}"
                b:TextBoxPlaceholderBehavior.Text="{loc:Loc Picker_Search}"
                AutomationProperties.Name="{loc:Loc Picker_SearchName}" Padding="9,7" />
            <ListBox x:Name="DeviceList" Grid.Row="3" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                Focusable="{Binding HasItems, RelativeSource={RelativeSource Self}}" IsTabStop="{Binding HasItems, RelativeSource={RelativeSource Self}}" FocusVisualStyle="{x:Null}"
                IsEnabled="{Binding CanBrowse}" AutomationProperties.Name="{loc:Loc Picker_ListName}" BorderThickness="0" Background="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                VirtualizingPanel.ScrollUnit="Pixel"
                PreviewMouseLeftButtonUp="OnDeviceClick" SelectionChanged="OnSelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Margin" Value="0,1,6,1" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{loc:LocBinding HelpMessage}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Style>
                            </Grid.Resources>
                            <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{loc:LocBinding HoverMessage}" /></i:Interaction.Behaviors>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:LocBinding StatusText}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="4" Text="{loc:LocBinding MessageText}" TextWrapping="Wrap" Margin="0,8,0,4" AutomationProperties.LiveSetting="Polite" />
            <DockPanel Grid.Row="5" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="{loc:Loc Picker_Switch}" IsEnabled="{Binding CanSwitch}" Click="OnSwitchClick" Padding="14,5" />
                <TextBlock Text="{loc:Loc Picker_Keys}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}">
                    <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{loc:Loc Picker_TabsHelp}" /></i:Interaction.Behaviors>
                </TextBlock>
            </DockPanel>
        </Grid>
    </Border>
</Window>
