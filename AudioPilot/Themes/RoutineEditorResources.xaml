<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="NetworkRefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Command" Value="{Binding RefreshNetworksCommand}" />
        <Setter Property="AutomationProperties.HelpText" Value="Scans for currently available network names." />
        <Setter Property="Content" Value="Refresh" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Width="16" Height="16">
                        <Path x:Name="RefreshArrow" Data="M 13.5,5 A 6,6 0 1 0 13.5,11 M 13.5,1.5 L 13.5,5 L 10,5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock x:Name="ScanningText" Text="&#x2026;" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsScanningNetworks, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <Setter TargetName="RefreshArrow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ScanningText" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsScanningNetworks}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <ContextMenu x:Key="EditableTextContextMenu" Style="{DynamicResource AppContextMenuStyle}">
        <MenuItem
            Command="ApplicationCommands.Undo"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="_Undo"
            Icon="{StaticResource AppMenuUndoIcon}"
            Style="{DynamicResource AppContextMenuItemStyle}" />
        <MenuItem
            Command="ApplicationCommands.Redo"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="_Redo"
            Icon="{StaticResource AppMenuRedoIcon}"
            Style="{DynamicResource AppContextMenuItemStyle}" />
        <Separator Style="{DynamicResource AppContextMenuSeparatorStyle}" />
        <MenuItem
            Command="ApplicationCommands.Cut"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="Cu_t"
            Icon="{StaticResource AppMenuCutIcon}"
            Style="{DynamicResource AppContextMenuItemStyle}" />
        <MenuItem
            Command="ApplicationCommands.Copy"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="_Copy"
            Icon="{StaticResource AppMenuCopyIcon}"
            Style="{DynamicResource AppContextMenuItemStyle}" />
        <MenuItem
            Command="ApplicationCommands.Paste"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="_Paste"
            Icon="{StaticResource AppMenuPasteIcon}"
            Style="{DynamicResource AppContextMenuItemStyle}" />
        <MenuItem
            Command="EditingCommands.Delete"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="_Delete"
            Icon="{StaticResource AppMenuDeleteIcon}"
            InputGestureText="Del"
            Style="{DynamicResource AppContextMenuItemStyle}" />
        <Separator Style="{DynamicResource AppContextMenuSeparatorStyle}" />
        <MenuItem
            Command="ApplicationCommands.SelectAll"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="Select _All"
            Icon="{StaticResource AppMenuSelectAllIcon}"
            Style="{DynamicResource AppContextMenuItemStyle}" />
    </ContextMenu>
    <Style x:Key="RoutineSectionSummaryStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
