<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:AudioPilot.Controls"
    xmlns:b="clr-namespace:AudioPilot.Behaviors"
    xmlns:h="clr-namespace:AudioPilot.Helpers"
    xmlns:loc="clr-namespace:AudioPilot.Localization">
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="AppBodyFontSize">13</sys:Double>
    <sys:Double x:Key="AppSecondaryFontSize">12</sys:Double>
    <sys:Double x:Key="AppSingleLineControlMinHeight">30</sys:Double>
    <sys:Double x:Key="SettingsFieldWidth">190</sys:Double>
    <sys:Double x:Key="SettingsLabelWidth">150</sys:Double>
    <!-- Match the expander's border and content inset so fields share one column. -->
    <Thickness x:Key="SettingsFormRowMargin">11,0,0,8</Thickness>
    <Style x:Key="SettingsFormRowStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="{DynamicResource SettingsFormRowMargin}" />
    </Style>
    <Thickness x:Key="AppControlPadding">10,5</Thickness>
    <Path x:Key="AppMenuCheckIcon" x:Shared="False" Width="11" Height="9" Stretch="Fill" Data="M1,5 L4,8 L10,1"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" StrokeThickness="1.5">
        <Path.Style>
            <Style TargetType="Path">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Path.Style>
    </Path>
    <Style x:Key="FlyoutPinButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" /><Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="AutomationProperties.HelpText" Value="{loc:Loc Flyout_KeepOpenHelp}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Path Data="{x:Static controls:AppMenuGlyphs.Pin}" Width="15" Height="15" Stretch="Uniform"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="AutomationProperties.HelpText" Value="{loc:Loc Flyout_KeptOpenHelp}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Each field owns its menu so a shared PlacementTarget cannot retain closed windows. -->
    <ContextMenu x:Key="EditableTextContextMenu" x:Shared="False" Style="{DynamicResource AppContextMenuStyle}">
        <MenuItem
            Command="ApplicationCommands.Undo"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="{loc:Loc Ui_Undo}"
            Icon="{DynamicResource AppMenuUndoIcon}"
            Style="{DynamicResource AppContextMenuItemStyle}" />
        <MenuItem
            Command="ApplicationCommands.Redo"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="{loc:Loc Ui_Redo}"
            Icon="{DynamicResource AppMenuRedoIcon}"
            Style="{DynamicResource AppContextMenuItemStyle}" />
        <Separator Style="{DynamicResource AppContextMenuSeparatorStyle}" />
        <MenuItem
            Command="ApplicationCommands.Cut"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="{loc:Loc Ui_CuT}"
            Icon="{DynamicResource AppMenuCutIcon}"
            Style="{DynamicResource AppContextMenuItemStyle}" />
        <MenuItem
            Command="ApplicationCommands.Copy"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="{loc:Loc Ui_Copy}"
            Icon="{DynamicResource AppMenuCopyIcon}"
            Style="{DynamicResource AppContextMenuItemStyle}" />
        <MenuItem
            Command="ApplicationCommands.Paste"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="{loc:Loc Ui_Paste}"
            Icon="{DynamicResource AppMenuPasteIcon}"
            Style="{DynamicResource AppContextMenuItemStyle}" />
        <MenuItem
            Command="EditingCommands.Delete"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="{loc:Loc Ui_Delete}"
            Icon="{DynamicResource AppMenuDeleteIcon}"
            InputGestureText="Del"
            Style="{DynamicResource AppContextMenuItemStyle}" />
        <Separator Style="{DynamicResource AppContextMenuSeparatorStyle}" />
        <MenuItem
            Command="ApplicationCommands.SelectAll"
            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Header="{loc:Loc Ui_SelectAll}"
            Icon="{DynamicResource AppMenuSelectAllIcon}"
            Style="{DynamicResource AppContextMenuItemStyle}" />
    </ContextMenu>
    <Style x:Key="AppSelectableTextStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="b:TextContextMenuBehavior.IsDisabled" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Background="{TemplateBinding Background}" Margin="{TemplateBinding Padding}" Focusable="False"
                                  HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AppSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppSecondaryFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style x:Key="AppSectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="AppPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DialogPrimaryActionForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource AppControlPadding}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimaryActionHoverBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentSelectionHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OpenFullListButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <Path Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="{x:Static controls:AppMenuGlyphs.Expand}"
                              Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppExpanderStyle" TargetType="Expander">
        <Setter Property="b:ExpanderScrollBehavior.RevealOnToggle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <DockPanel>
                            <ToggleButton
                                x:Name="HeaderToggle"
                                AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                                AutomationProperties.ItemStatus="{Binding (AutomationProperties.ItemStatus), RelativeSource={RelativeSource TemplatedParent}}"
                                AutomationProperties.HelpText="{Binding (AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}"
                                Background="Transparent"
                                BorderThickness="0"
                                Content="{TemplateBinding Header}"
                                DockPanel.Dock="Top"
                                FocusVisualStyle="{DynamicResource AppFocusVisualStyle}"
                                Focusable="True"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Padding="10,8" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path
                                                    x:Name="ArrowGlyph"
                                                    Grid.Column="0"
                                                    Width="10"
                                                    Height="10"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Data="M 0 0 L 10 0 L 5 6 Z"
                                                    Fill="{DynamicResource TextBrush}" />
                                                <ContentPresenter
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    ContentSource="Content"
                                                    RecognizesAccessKey="True" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ArrowGlyph" Property="Data" Value="M 0 6 L 10 6 L 5 0 Z" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ArrowGlyph" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Margin="10,0,10,10" Focusable="False" Visibility="Collapsed" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsExpanderStyle" TargetType="Expander" BasedOn="{StaticResource AppExpanderStyle}">
        <Style.Resources>
            <Thickness x:Key="SettingsFormRowMargin">0,0,0,8</Thickness>
        </Style.Resources>
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="MixerGlobalMuteToggleStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="IsThreeState" Value="False" />
        <Setter Property="AutomationProperties.ItemStatus" Value="Inactive" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <StackPanel Margin="{TemplateBinding Padding}" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path x:Name="MuteGlyph" Width="16" Height="16" Margin="0,0,6,0" Stretch="None" Data="{TemplateBinding Tag}"
                                  Fill="Transparent" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Focusable="False" IsHitTestVisible="False" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False"><Setter TargetName="MuteGlyph" Property="Margin" Value="0" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="MuteGlyph" Property="Stroke" Value="{DynamicResource DialogErrorBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MuteGlyph" Property="Stroke" Value="{DynamicResource DialogPrimaryActionForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="AutomationProperties.ItemStatus" Value="Active" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DialogPrimaryActionForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MixerInlineButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="MixerRoutingDetailsTemplate">
        <DataTemplate.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" /></DataTemplate.Resources>
        <Grid h:AppHelp.Topic="ApplicationRouting" Margin="22,3,4,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="{loc:LocBinding RoutingDetails.DeviceLabelText}" Style="{StaticResource AppSecondaryTextStyle}" />
            <controls:RoutingDeviceComboBox Grid.Column="1" MinWidth="60" Devices="{Binding RoutingDetails.Devices}"
                                            Style="{DynamicResource {x:Type ComboBox}}" ItemContainerStyle="{DynamicResource MixerRoutingChoiceStyle}"
                                            IsDropDownOpen="{Binding RoutingDetails.IsChoosingDevice, Mode=TwoWay}"
                                            SelectedValue="{Binding RoutingDetails.SelectedDevice, Mode=TwoWay}" IsEnabled="{Binding RoutingDetails.CanEdit}"
                                            AutomationProperties.Name="{loc:LocBinding RoutingDetails.DeviceLabelText}"
                                            AutomationProperties.HelpText="{loc:Loc Ui_AppliesImmediatelyToThisApplicationSAudioRoles}">
                <controls:RoutingDeviceComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{loc:LocBinding Device.LabelText}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                </controls:RoutingDeviceComboBox.ItemTemplate>
            </controls:RoutingDeviceComboBox>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                       Text="{loc:LocBinding RoutingDetails.ActiveDeviceText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource AppSecondaryTextStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RoutingDetails.ActiveDeviceText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="{loc:Loc Ui_Retry}" Margin="6,0,0,0" Padding="5,1" VerticalAlignment="Top"
                        Style="{StaticResource MixerInlineButtonStyle}" AutomationProperties.Name="{loc:Loc Ui_RetryReadingApplicationRouting}"
                        Visibility="{Binding RoutingDetails.NeedsReadRetry, Converter={StaticResource BoolToVisibilityConverter}}"
                        IsEnabled="{Binding RoutingDetails.CanRetry}"
                        Command="{Binding RoutingDetails.RetryCommand}" />
                <TextBlock Text="{loc:LocBinding RoutingDetails.StatusText}" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AppSecondaryTextStyle}">
                        <Style.Triggers><DataTrigger Binding="{Binding RoutingDetails.HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DialogErrorBrush}" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Grid>
    </DataTemplate>

    <!-- Quick Mixer row resources are shared across flyout instances. -->
    <Style x:Key="QuickMixerGlyphStyle" TargetType="Path">
        <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" /><Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource TextBrush}" /><Setter Property="StrokeThickness" Value="1.25" />
        <Setter Property="Focusable" Value="False" /><Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="QuickMixerSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="QuickMixerItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,3" /><Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="AutomationProperties.Name" Value="{loc:LocBinding Source.DisplayLabel}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="RowBorder" Padding="{TemplateBinding Padding}" CornerRadius="4" BorderThickness="1"
                            Background="Transparent" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsGroupSelected}" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPinnedApp}" Value="True">
                <Setter Property="AutomationProperties.ItemStatus" Value="{loc:Loc QuickMixer_AppPinned}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="QuickMixerGroupCheckTemplate">
        <CheckBox Margin="0,0,4,0" VerticalAlignment="Center"
                  AutomationProperties.Name="{loc:LocBinding Source.DisplayLabel, Format=Mixer_GroupSelect}"
                  IsChecked="{Binding IsGroupSelected, Mode=OneWay}" Command="{Binding ToggleApplicationSelectionCommand}" />
    </DataTemplate>

    <DataTemplate x:Key="QuickMixerApplicationHeaderTemplate">
        <DataTemplate.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" /></DataTemplate.Resources>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsSelectingApplications, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Content" Value="{Binding}" />
                                <Setter Property="ContentTemplate" Value="{StaticResource QuickMixerGroupCheckTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <Button x:Name="RoutingButton" Grid.Column="1" Width="22" Height="20" Padding="1" Margin="0,0,3,0"
                    Style="{StaticResource MixerInlineButtonStyle}" Command="{Binding ToggleRoutingCommand}"
                    AutomationProperties.Name="{loc:LocBinding Source.DisplayLabel, Format=Mixer_AppDevice}"
                    AutomationProperties.HelpText="{loc:Loc Ui_ExpandToChooseThisAppSAudioDevice}">
                <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{loc:Loc Ui_ExpandToChooseThisAppSAudioDeviceText}" /></i:Interaction.Behaviors>
                <Path Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.3" StrokeLineJoin="Round" Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" IsHitTestVisible="False">
                    <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 3,1 L 7,5 3,9" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsRoutingExpanded}" Value="True"><Setter Property="Data" Value="M 1,3 L 5,7 9,3" /></DataTrigger></Style.Triggers>
                    </Style></Path.Style>
                </Path>
            </Button>
            <Button x:Name="ApplicationNameButton" Grid.Column="2" Padding="2,1" HorizontalContentAlignment="Left"
                    Style="{StaticResource MixerInlineButtonStyle}" Command="{Binding SelectApplicationCommand}"
                    Visibility="{Binding CanGroupApplications, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.Name="{loc:LocBinding Source.DisplayLabel}"
                    AutomationProperties.HelpText="{loc:Loc Ui_SelectThisAppCtrlClickToAddOr}">
                <i:Interaction.Behaviors><b:TrimmedTextPopupBehavior /></i:Interaction.Behaviors>
                <TextBlock Text="{loc:LocBinding Source.DisplayLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </Button>
            <TextBlock x:Name="RecordingAppName" Grid.Column="2" Text="{loc:LocBinding Source.DisplayLabel}" VerticalAlignment="Center"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers><DataTrigger Binding="{Binding CanGroupApplications}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding Text, ElementName=RecordingAppName}" ShowOnlyWhenClipped="True" /></i:Interaction.Behaviors>
            </TextBlock>
            <Path Grid.Column="3" Data="{x:Static controls:AppMenuGlyphs.Pin}" Width="12" Height="12" Margin="5,0,1,0" IsHitTestVisible="False"
                  Style="{StaticResource QuickMixerGlyphStyle}" Visibility="{Binding IsPinnedApp, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="QuickMixerFixedHeaderTemplate">
        <DataTemplate.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" /></DataTemplate.Resources>
        <StackPanel>
            <TextBlock x:Name="SessionName" Text="{loc:LocBinding Source.DisplayLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding Text, ElementName=SessionName}" ShowOnlyWhenClipped="True" /></i:Interaction.Behaviors>
            </TextBlock>
            <TextBlock x:Name="DeviceName" Text="{loc:LocBinding Source.EndpointLabel}" FontSize="11" Style="{StaticResource QuickMixerSecondaryTextStyle}"
                       TextTrimming="CharacterEllipsis" Visibility="{Binding Source.IsEndpoint, Converter={StaticResource BoolToVisibilityConverter}}">
                <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding Text, ElementName=DeviceName}" ShowOnlyWhenClipped="True" /></i:Interaction.Behaviors>
            </TextBlock>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="QuickMixerItemTemplate">
        <DataTemplate.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <h:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        </DataTemplate.Resources>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <i:Interaction.Behaviors><b:MixerGroupSliderBehavior /></i:Interaction.Behaviors>
            <Grid Grid.RowSpan="2" Margin="0,0,8,0" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="24" Height="24" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Path Data="{Binding FallbackGlyph}" Style="{StaticResource QuickMixerGlyphStyle}" Width="22" Height="22"
                      Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            </Grid>
            <ContentControl Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,1" Focusable="False" Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource QuickMixerFixedHeaderTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source.IsApplication}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource QuickMixerApplicationHeaderTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="0.1" LargeChange="5" IsMoveToPointEnabled="True"
                    Tag="{Binding Source.IsMuted}"
                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="{loc:LocBinding Source.DisplayLabel}"
                    AutomationProperties.HelpText="{loc:Loc Ui_RightClickTheSliderKnobOrPressSpace}">
                <i:Interaction.Behaviors>
                    <b:SliderThumbRightClickBehavior Command="{Binding ToggleMuteCommand}" CommandParameter="{Binding}" />
                    <b:SliderKeyboardAccelerationBehavior MuteCommand="{Binding ToggleMuteCommand}" MuteCommandParameter="{Binding}" />
                </i:Interaction.Behaviors>
            </Slider>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Source.Volume, StringFormat={}{0:0.#}%}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button x:Name="MuteButton" Grid.Row="1" Grid.Column="3" Height="24" MinHeight="24" Command="{Binding ToggleMuteCommand}" Padding="5,3" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="{loc:LocBinding MuteLabel}">
                <Path Data="{Binding MuteGlyph}" Style="{StaticResource QuickMixerGlyphStyle}" />
                <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{Binding (AutomationProperties.Name), ElementName=MuteButton}" /></i:Interaction.Behaviors>
            </Button>
            <controls:AudioLevelMeter Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="12" Margin="0,0,4,0" IsTabStop="False"
                Level="{Binding Level}" Peak="{Binding Peak}" SegmentCount="32" SegmentGap="1" CornerRadius="0" BorderThickness="0"
                Background="Transparent" InactiveBrush="{DynamicResource AudioMeterInactiveBrush}"
                LowLevelBrush="{DynamicResource AudioMeterLowBrush}" MidLevelBrush="{DynamicResource AudioMeterMidBrush}"
                HighLevelBrush="{DynamicResource AudioMeterHighBrush}" PeakBrush="{DynamicResource AudioMeterPeakBrush}"
                Visibility="{Binding MeterAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                AutomationProperties.Name="{loc:Loc QuickMixer_Activity}">
                <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{loc:Loc QuickMixer_MeterHelp}" /></i:Interaction.Behaviors>
            </controls:AudioLevelMeter>
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" FontSize="10" Text="{loc:Loc QuickMixer_MeterUnavailable}"
                       Style="{StaticResource QuickMixerSecondaryTextStyle}" Visibility="{Binding MeterAvailable, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <ContentControl Grid.Row="3" Grid.ColumnSpan="4" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoutingExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Content" Value="{Binding}" />
                                <Setter Property="ContentTemplate" Value="{StaticResource MixerRoutingDetailsTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
