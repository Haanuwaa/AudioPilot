<Window x:Class="AudioPilot.PauseDurationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AudioPilot.Localization"
    Title="{loc:Loc Ui_PauseAutomaticRoutines}" Width="420" MinWidth="360" SizeToContent="Height"
    ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
    FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
    Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20" FocusManager.FocusedElement="{Binding ElementName=Minutes}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:Loc Ui_PauseAutomaticRoutinesText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBlock Grid.Row="1" Text="{loc:Loc Ui_ManualControlsKeepWorkingAutomaticRoutinesResumeWhen}"
                   TextWrapping="Wrap" Margin="0,0,0,16" />
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Label Content="{loc:Loc Ui_PauseFor}" Target="{Binding ElementName=Minutes}" VerticalAlignment="Center" Padding="0,0,10,0" />
            <TextBox x:Name="Minutes" Width="80" MaxLength="8" TextChanged="Minutes_TextChanged" AutomationProperties.Name="{loc:Loc Ui_PauseDurationInMinutes}" />
            <TextBlock Text="{loc:Loc Ui_Minutes}" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="DurationHelp" Grid.Row="3" Margin="0,8,0,18" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PauseButton" Content="{loc:Loc Ui_Pause}" IsDefault="True" Click="Pause_Click" MinWidth="80" Margin="0,0,8,0" />
            <Button Content="{loc:Loc Ui_Cancel}" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>
