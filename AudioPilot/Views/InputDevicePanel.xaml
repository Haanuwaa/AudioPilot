<UserControl
    x:Class="AudioPilot.Views.InputDevicePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:AudioPilot.Behaviors"
    xmlns:c="clr-namespace:AudioPilot.Controls"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    AutomationProperties.Name="Input device configuration"
    Foreground="{DynamicResource TextBrush}">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding AudioTesting.StopCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="10">
        <StackPanel x:Name="ConfigurationPanel">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AudioTesting.IsInputTestPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Label Content="Available Input Devices:" />
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    AutomationProperties.Name="Available input devices"
                    Width="300"
                    ItemsSource="{Binding AvailableInputDeviceNames}"
                    SelectedIndex="{Binding SelectedAvailableInputIndex, Mode=TwoWay}" />
                <Button
                    Width="62"
                    AutomationProperties.Name="Add selected input device"
                    Margin="8,0,0,0"
                    Command="{Binding AddInputCycleDeviceCommand}"
                    Content="Add" />
            </StackPanel>

            <Label Content="Input Switch Order:" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <ListBox
                    x:Name="SwitchOrderListBox"
                    AutomationProperties.Name="Input switch order"
                    AutomationProperties.HelpText="Drag selected devices to reorder, or use Alt+Up and Alt+Down for one device."
                    Grid.Column="0"
                    Height="104"
                    Padding="3"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding InputCycleDevices}"
                    SelectedIndex="{Binding SelectedInputCycleIndex, Mode=TwoWay}"
                    SelectionMode="Extended">
                    <ListBox.InputBindings>
                        <KeyBinding Key="W" Command="{Binding RemoveInputCycleDeviceCommand}" Modifiers="Control" />
                        <KeyBinding Key="Up" Command="{Binding MoveInputCycleDeviceUpCommand}" Modifiers="Alt" />
                        <KeyBinding Key="Down" Command="{Binding MoveInputCycleDeviceDownCommand}" Modifiers="Alt" />
                    </ListBox.InputBindings>
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource CycleDeviceListBoxItemStyle}" TargetType="ListBoxItem">
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu
                                        AutomationProperties.Name="Input device actions"
                                        DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}"
                                        Style="{DynamicResource AppContextMenuStyle}">
                                        <MenuItem
                                            AutomationProperties.Name="Test microphone"
                                            Command="{Binding Tag.AudioTesting.TestInputCommand}"
                                            CommandParameter="{Binding DataContext}"
                                            Header="_Test microphone…"
                                            Icon="{StaticResource AppMenuInputIcon}"
                                            Style="{DynamicResource AppContextMenuItemStyle}" />
                                        <MenuItem
                                            AutomationProperties.Name="Set as default input"
                                            Command="{Binding Tag.SetDefaultInputDeviceCommand}"
                                            CommandParameter="{Binding DataContext}"
                                            Header="Set as _default input"
                                            Icon="{StaticResource AppMenuSetDefaultIcon}"
                                            Style="{DynamicResource AppContextMenuItemStyle}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <i:Interaction.Behaviors>
                        <b:ListBoxSelectedItemsBehavior SelectedItems="{Binding SelectedInputCycleDevices}" />
                        <b:ListBoxReorderBehavior ReorderCommand="{Binding ReorderInputCycleDevicesCommand}" />
                    </i:Interaction.Behaviors>
                </ListBox>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button Height="30" Margin="0,0,0,4" Command="{Binding MoveInputCycleDeviceUpCommand}" AutomationProperties.Name="Move up">
                        <Path Width="14" Height="14" Data="{x:Static c:AppMenuGlyphs.MoveUp}" Stretch="Uniform" StrokeThickness="1.25" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Focusable="False" IsHitTestVisible="False" />
                        <i:Interaction.Behaviors>
                            <b:HoverInfoPopupBehavior Text="Move up" />
                        </i:Interaction.Behaviors>
                    </Button>
                    <Button Height="30" Margin="0,0,0,4" Command="{Binding MoveInputCycleDeviceDownCommand}" AutomationProperties.Name="Move down">
                        <Path Width="14" Height="14" Data="{x:Static c:AppMenuGlyphs.MoveDown}" Stretch="Uniform" StrokeThickness="1.25" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Focusable="False" IsHitTestVisible="False" />
                        <i:Interaction.Behaviors>
                            <b:HoverInfoPopupBehavior Text="Move down" />
                        </i:Interaction.Behaviors>
                    </Button>
                    <Button Height="30" Command="{Binding RemoveInputCycleDeviceCommand}" Content="Remove" />
                </StackPanel>
            </Grid>

            <Label Content="Hotkey:" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    AutomationProperties.Name="Input switching hotkey"
                    Grid.Column="0"
                    ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                    IsEnabled="{Binding InputHotkeysEnabled, Mode=TwoWay}"
                    Text="{Binding InputHotkey.DisplayText, Mode=OneWay}">
                    <i:Interaction.Behaviors>
                        <b:PlaceholderExampleBehavior Identity="input-hotkey" Options="Ctrl+Alt+I|Alt+Comma|Ctrl+Alt+Left" PreferredFamily="letter" />
                        <b:HoverInfoPopupBehavior Text="{Binding InputHotkey.HoverText}" WarningKind="{Binding InputHotkey.WarningKind}" />
                        <b:HotkeyCaptureBehavior Target="{Binding InputHotkey}" />
                        <b:HotkeyWarningBorderBehavior HasWarning="{Binding InputHotkey.HasWarning}" WarningKind="{Binding InputHotkey.WarningKind}" />
                    </i:Interaction.Behaviors>
                </TextBox>
                <CheckBox
                    Grid.Column="1"
                    AutomationProperties.Name="Enable input switching hotkey"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Content="Enabled"
                    IsChecked="{Binding InputHotkeysEnabled, Mode=TwoWay}" />
            </Grid>
        </StackPanel>

        <Border
            x:Name="MicrophoneTestPanel"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Microphone test panel"
            Padding="12"
            Background="{DynamicResource ControlBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="5"
            IsVisibleChanged="MicrophoneTestPanel_IsVisibleChanged"
            Visibility="{Binding AudioTesting.IsInputTestPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button
                        x:Name="StopMicrophoneTestButton"
                        AutomationProperties.Name="Stop or dismiss microphone test"
                        DockPanel.Dock="Right"
                        MinWidth="70"
                        Command="{Binding AudioTesting.StopCommand}"
                        Content="{Binding AudioTesting.ActionText}" />
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Microphone Test" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding AudioTesting.EndpointName}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="Microphone test status"
                    Margin="0,0,0,8"
                    Text="{Binding AudioTesting.Status}"
                    TextWrapping="Wrap" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:AudioLevelMeter
                        AutomationProperties.Name="Microphone level"
                        AutomationProperties.HelpText="Current microphone level with a held peak marker, from zero to one hundred percent"
                        Height="22"
                        Background="{DynamicResource AudioMeterTrackBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        HighLevelBrush="{DynamicResource AudioMeterHighBrush}"
                        InactiveBrush="{DynamicResource AudioMeterInactiveBrush}"
                        Level="{Binding AudioTesting.LevelPercent, Mode=OneWay}"
                        LowLevelBrush="{DynamicResource AudioMeterLowBrush}"
                        MidLevelBrush="{DynamicResource AudioMeterMidBrush}"
                        Peak="{Binding AudioTesting.PeakPercent, Mode=OneWay}"
                        PeakBrush="{DynamicResource AudioMeterPeakBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        MinWidth="38"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding AudioTesting.LevelText}" />
                </Grid>

                <TextBlock Margin="0,0,0,10" Text="{Binding AudioTesting.Elapsed, StringFormat=Elapsed: {0}}" />
                <CheckBox
                    AutomationProperties.Name="Hear microphone through output"
                    AutomationProperties.HelpText="Plays the microphone through the selected monitor output. Start a microphone test to enable this option."
                    Content="Hear myself"
                    IsEnabled="{Binding AudioTesting.IsInputTestRunning}"
                    IsChecked="{Binding AudioTesting.HearMyself, Mode=TwoWay}">
                    <i:Interaction.Behaviors>
                        <b:HoverInfoPopupBehavior Text="Plays the microphone through the selected monitor output. Start a microphone test to enable this option." />
                    </i:Interaction.Behaviors>
                </CheckBox>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label VerticalAlignment="Center" Content="Monitor output:" />
                    <ComboBox
                        AutomationProperties.Name="Microphone test monitor output"
                        AutomationProperties.HelpText="Chooses where you hear the microphone during a test. Start a microphone test to change this setting."
                        Grid.Column="1"
                        DisplayMemberPath="Name"
                        IsEnabled="{Binding AudioTesting.IsInputTestRunning}"
                        ItemsSource="{Binding AudioTesting.MonitorOutputDevices}"
                        SelectedValue="{Binding AudioTesting.SelectedMonitorOutputId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Id">
                        <i:Interaction.Behaviors>
                            <b:HoverInfoPopupBehavior Text="Chooses where you hear the microphone during a test. Start a microphone test to change this setting." />
                        </i:Interaction.Behaviors>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,6,0,0" IsEnabled="{Binding AudioTesting.HearMyself}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Label VerticalAlignment="Center" Content="Monitor volume:" />
                    <Slider
                        AutomationProperties.Name="Microphone test monitor volume"
                        AutomationProperties.HelpText="Adjusts how loudly you hear the microphone during a test. Enable Hear myself to change this setting."
                        Grid.Column="1"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="1"
                        Value="{Binding AudioTesting.MonitorVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Behaviors>
                            <b:HoverInfoPopupBehavior Text="Adjusts how loudly you hear the microphone during a test. Enable Hear myself to change this setting." />
                        </i:Interaction.Behaviors>
                    </Slider>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding AudioTesting.MonitorVolumeText}" />
                </Grid>

                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource MutedTextBrush}"
                    Text="{Binding AudioTesting.MonitorFallbackNotice}"
                    TextWrapping="Wrap"
                    Visibility="{Binding AudioTesting.HasMonitorFallbackNotice, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Margin="0,10,0,0"
                    Foreground="{DynamicResource MutedTextBrush}"
                    Text="Captured locally; nothing is saved. Use headphones before enabling Hear myself to avoid feedback. Bluetooth microphones may add delay or switch headset profiles."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
