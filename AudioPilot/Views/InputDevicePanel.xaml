<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:b="clr-namespace:AudioPilot.Behaviors"
    xmlns:controls="clr-namespace:AudioPilot.Controls"
    xmlns:h="clr-namespace:AudioPilot.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AudioPilot.Localization"
    x:Class="AudioPilot.Views.InputDevicePanel"
    AutomationProperties.Name="{loc:Loc Ui_InputDeviceConfiguration}"
    Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <h:WindowListHeightConverter x:Key="DeviceListHeightConverter" InitialHeight="104" InitialWindowHeight="440" RowHeight="24" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding AudioTesting.StopCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="10">
        <StackPanel x:Name="ConfigurationPanel">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AudioTesting.IsInputTestPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Label Content="{loc:Loc Ui_AvailableInputDevices}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="AvailableDevicesComboBox"
                    AutomationProperties.Name="{loc:Loc Ui_AvailableInputDevicesText}"
                    MinWidth="140"
                    ItemsSource="{Binding AvailableInputDeviceNames}"
                    SelectedIndex="{Binding SelectedAvailableInputIndex, Mode=TwoWay}" />
                <TextBlock Text="{loc:Loc Ui_SelectAnInputDevice}" Foreground="{DynamicResource MutedTextBrush}"
                           Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=AvailableDevicesComboBox}" Value="-1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button
                    Width="62"
                    AutomationProperties.Name="{loc:Loc Ui_AddSelectedInputDevice}"
                    Margin="8,0,0,0"
                    Command="{Binding AddInputCycleDeviceCommand}"
                    Content="{loc:Loc Ui_AddText}"
                    Grid.Column="1" />
            </Grid>
            <StackPanel Orientation="Horizontal">
                <Label VerticalAlignment="Center">
                    <TextBlock x:Name="SwitchOrderTitle">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Text" Value="{loc:LocBinding InputCycleDevices.Count, Format=Device_InputCount}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InputCycleDevices.Count}" Value="0">
                                        <Setter Property="Text" Value="{loc:Loc Ui_InputSwitchOrder}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Label>
                <Button Command="{Binding ManageListCommand}" CommandParameter="Input"
                        AutomationProperties.Name="{loc:Loc Ui_OpenFullInputSwitchOrderList}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OpenFullListButtonStyle}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding InputCycleDevices.Count}" Value="0" />
                                        <Condition Binding="{Binding IsInputDeviceInventoryKnownEmpty}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <i:Interaction.Behaviors>
                        <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_OpenFullList}" />
                    </i:Interaction.Behaviors>
                </Button>
            </StackPanel>
            <Grid b:ListBoxSelectedItemsBehavior.SelectionContext="{Binding SelectedInputCycleDevices}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox
                    x:Name="SwitchOrderListBox"
                    b:NestedListScrollBehavior.IsEnabled="True"
                    AutomationProperties.Name="{loc:Loc Ui_InputSwitchOrder}"
                    AutomationProperties.HelpText="{loc:Loc Ui_DoubleClickADeviceToOpenItIn}"
                    Grid.Column="0"
                    MinHeight="104"
                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource DeviceListHeightConverter}}"
                    Padding="3"
                    VirtualizingPanel.ScrollUnit="Item"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding InputCycleDevices}"
                    SelectedIndex="{Binding SelectedInputCycleIndex, Mode=TwoWay}"
                    SelectionMode="Extended"
                    MouseDoubleClick="SwitchOrderListBox_MouseDoubleClick">
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Style="{DynamicResource AppContextMenuStyle}">
                            <MenuItem Header="{loc:Loc Ui_OpenFullListText}" Command="{Binding ManageListCommand}" CommandParameter="Input"
                                      Icon="{StaticResource AppMenuExpandIcon}" Style="{DynamicResource AppContextMenuItemStyle}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.InputBindings>
                        <KeyBinding Key="W" Command="{Binding RemoveInputCycleDeviceCommand}" Modifiers="Control" />
                        <KeyBinding Key="Up" Command="{Binding MoveInputCycleDeviceUpCommand}" Modifiers="Alt" />
                        <KeyBinding Key="Down" Command="{Binding MoveInputCycleDeviceDownCommand}" Modifiers="Alt" />
                    </ListBox.InputBindings>
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource CycleDeviceListBoxItemStyle}" TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu
                                        AutomationProperties.Name="{loc:Loc Ui_InputDeviceActions}"
                                        DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}"
                                        Style="{DynamicResource AppContextMenuStyle}">
                                        <MenuItem
                                            AutomationProperties.Name="{loc:Loc Ui_TestMicrophone}"
                                            Command="{Binding Tag.AudioTesting.TestInputCommand}"
                                            CommandParameter="{Binding DataContext}"
                                            Header="{loc:Loc Ui_TestMicrophoneText}"
                                            Icon="{StaticResource AppMenuInputIcon}"
                                            Style="{DynamicResource AppContextMenuItemStyle}" />
                                        <MenuItem
                                            AutomationProperties.Name="{loc:Loc Ui_SetAsDefaultInput}"
                                            Command="{Binding Tag.SetDefaultInputDeviceCommand}"
                                            CommandParameter="{Binding DataContext}"
                                            Header="{loc:Loc Ui_SetAsDefaultInputText}"
                                            Icon="{StaticResource AppMenuSetDefaultIcon}"
                                            Style="{DynamicResource AppContextMenuItemStyle}" />
                                        <MenuItem
                                            Header="{loc:Loc Ui_OpenWindowsDeviceSettings}"
                                            Command="{Binding Tag.OpenWindowsDeviceSettingsCommand}"
                                            CommandParameter="{Binding DataContext}"
                                            Icon="{StaticResource AppMenuSettingsIcon}"
                                            Style="{DynamicResource AppContextMenuItemStyle}" />
                                        <Separator Style="{DynamicResource AppContextMenuSeparatorStyle}" />
                                        <MenuItem Header="{loc:Loc Ui_OpenFullListText}" Command="{Binding Tag.ManageListCommand}" CommandParameter="Input"
                                                  Icon="{StaticResource AppMenuExpandIcon}" Style="{DynamicResource AppContextMenuItemStyle}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <i:Interaction.Behaviors>
                        <b:ListBoxSelectedItemsBehavior SelectedItems="{Binding SelectedInputCycleDevices}" />
                        <b:ListBoxReorderBehavior ReorderCommand="{Binding ReorderInputCycleDevicesCommand}" />
                    </i:Interaction.Behaviors>
                </ListBox>
                <TextBlock Text="{loc:Loc Ui_ChooseADeviceAboveThenClickAdd}" TextWrapping="Wrap"
                           Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False" Focusable="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=SwitchOrderListBox}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button
                        Height="30"
                        Margin="0,0,0,4"
                        Command="{Binding MoveInputCycleDeviceUpCommand}"
                        AutomationProperties.Name="{loc:Loc Ui_MoveUpText}">
                        <Path
                            Width="14"
                            Height="14"
                            Data="{x:Static controls:AppMenuGlyphs.MoveUp}"
                            Stretch="Uniform"
                            StrokeThickness="1.25"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Focusable="False"
                            IsHitTestVisible="False" />
                        <i:Interaction.Behaviors>
                            <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_MoveUpText}" />
                        </i:Interaction.Behaviors>
                    </Button>
                    <Button
                        Height="30"
                        Margin="0,0,0,4"
                        Command="{Binding MoveInputCycleDeviceDownCommand}"
                        AutomationProperties.Name="{loc:Loc Ui_MoveDownText}">
                        <Path
                            Width="14"
                            Height="14"
                            Data="{x:Static controls:AppMenuGlyphs.MoveDown}"
                            Stretch="Uniform"
                            StrokeThickness="1.25"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Focusable="False"
                            IsHitTestVisible="False" />
                        <i:Interaction.Behaviors>
                            <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_MoveDownText}" />
                        </i:Interaction.Behaviors>
                    </Button>
                    <Button Height="30" Command="{Binding RemoveInputCycleDeviceCommand}" Content="{loc:Loc Ui_RemoveText}" />
                </StackPanel>
            </Grid>
            <Label Content="{loc:Loc Ui_Hotkey}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    AutomationProperties.Name="{loc:Loc Ui_InputSwitchingHotkey}"
                    Grid.Column="0"
                    ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                    IsEnabled="{Binding InputHotkeysEnabled, Mode=TwoWay}"
                    Text="{Binding InputHotkey.DisplayText, Mode=OneWay}">
                    <i:Interaction.Behaviors>
                        <b:HotkeyPlaceholderBehavior />
                        <b:HoverInfoPopupBehavior Text="{loc:LocBinding InputHotkey.HoverText, Message=True}" WarningKind="{Binding InputHotkey.WarningKind}" />
                        <b:HotkeyCaptureBehavior Target="{Binding InputHotkey}" />
                        <b:HotkeyWarningBorderBehavior
                            HasWarning="{Binding InputHotkey.HasWarning}"
                            WarningKind="{Binding InputHotkey.WarningKind}" />
                    </i:Interaction.Behaviors>
                </TextBox>
                <CheckBox
                    Grid.Column="1"
                    AutomationProperties.Name="{loc:Loc Ui_EnableInputSwitchingHotkey}"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Content="{loc:Loc Ui_Enabled}"
                    IsChecked="{Binding InputHotkeysEnabled, Mode=TwoWay}">
                    <i:Interaction.Behaviors>
                        <b:HoverInfoPopupBehavior
                            Text="{loc:Loc Ui_EnableOrDisableSavedForwardAndReverseInput}" />
                    </i:Interaction.Behaviors>
                </CheckBox>
            </Grid>
        </StackPanel>
        <Border
            x:Name="MicrophoneTestPanel"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{loc:Loc Ui_MicrophoneTestPanel}"
            Padding="12"
            Background="{DynamicResource ControlBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="5"
            IsVisibleChanged="MicrophoneTestPanel_IsVisibleChanged"
            Visibility="{Binding AudioTesting.IsInputTestPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button
                        x:Name="StopMicrophoneTestButton"
                        AutomationProperties.Name="{loc:Loc Ui_StopOrDismissMicrophoneTest}"
                        DockPanel.Dock="Right"
                        MinWidth="70"
                        Command="{Binding AudioTesting.StopCommand}"
                        Content="{loc:LocBinding AudioTesting.ActionText, Choice=True}" />
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{loc:Loc Ui_MicrophoneTest}" />
                        <TextBlock
                            Foreground="{DynamicResource MutedTextBrush}"
                            Text="{Binding AudioTesting.EndpointName}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{loc:Loc Ui_MicrophoneTestStatus}"
                    Margin="0,0,0,8"
                    Text="{loc:LocBinding AudioTesting.Status, Message=True}"
                    TextWrapping="Wrap" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:AudioLevelMeter
                        AutomationProperties.Name="{loc:Loc Ui_MicrophoneLevel}"
                        AutomationProperties.HelpText="{loc:Loc Ui_CurrentMicrophoneLevelWithAHeldPeakMarker}"
                        Height="22"
                        Background="{DynamicResource AudioMeterTrackBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        HighLevelBrush="{DynamicResource AudioMeterHighBrush}"
                        InactiveBrush="{DynamicResource AudioMeterInactiveBrush}"
                        Level="{Binding AudioTesting.LevelPercent, Mode=OneWay}"
                        LowLevelBrush="{DynamicResource AudioMeterLowBrush}"
                        MidLevelBrush="{DynamicResource AudioMeterMidBrush}"
                        Peak="{Binding AudioTesting.PeakPercent, Mode=OneWay}"
                        PeakBrush="{DynamicResource AudioMeterPeakBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        MinWidth="38"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding AudioTesting.LevelText}" />
                </Grid>
                <TextBlock Margin="0,0,0,10" Text="{loc:LocBinding AudioTesting.Elapsed, Format=Device_TestElapsed}" />
                <CheckBox
                    AutomationProperties.Name="{loc:Loc Ui_HearMicrophoneThroughOutput}"
                    AutomationProperties.HelpText="{loc:Loc Ui_PlaysTheMicrophoneThroughTheSelectedMonitorOutput}"
                    Content="{loc:Loc Ui_HearMyself}"
                    IsEnabled="{Binding AudioTesting.IsInputTestRunning}"
                    IsChecked="{Binding AudioTesting.HearMyself, Mode=TwoWay}">
                    <i:Interaction.Behaviors>
                        <b:HoverInfoPopupBehavior
                            Text="{loc:Loc Ui_PlaysTheMicrophoneThroughTheSelectedMonitorOutput}" />
                    </i:Interaction.Behaviors>
                </CheckBox>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label VerticalAlignment="Center" Content="{loc:Loc Ui_MonitorOutput}" />
                    <ComboBox
                        AutomationProperties.Name="{loc:Loc Ui_MicrophoneTestMonitorOutput}"
                        AutomationProperties.HelpText="{loc:Loc Ui_ChoosesWhereYouHearTheMicrophoneDuringA}"
                        Grid.Column="1"
                        IsEnabled="{Binding AudioTesting.IsInputTestRunning}"
                        ItemsSource="{Binding AudioTesting.MonitorOutputDevices}"
                        SelectedItem="{Binding AudioTesting.SelectedMonitorOutput, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:LocBinding ChoiceLabel}" /></DataTemplate></ComboBox.ItemTemplate>
                        <i:Interaction.Behaviors>
                            <b:HoverInfoPopupBehavior
                                Text="{loc:Loc Ui_ChoosesWhereYouHearTheMicrophoneDuringA}" />
                        </i:Interaction.Behaviors>
                    </ComboBox>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="IsEnabled" Value="False" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding AudioTesting.IsInputTestRunning}" Value="True" />
                                        <Condition Binding="{Binding AudioTesting.HearMyself}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="True" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Label VerticalAlignment="Center" Content="{loc:Loc Ui_MonitorVolume}" />
                    <Slider
                        AutomationProperties.Name="{loc:Loc Ui_MicrophoneTestMonitorVolume}"
                        AutomationProperties.HelpText="{loc:Loc Ui_AdjustsHowLoudlyYouHearTheMicrophoneDuring}"
                        Grid.Column="1"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="1"
                        Value="{Binding AudioTesting.MonitorVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Behaviors>
                            <b:HoverInfoPopupBehavior
                                Text="{loc:Loc Ui_AdjustsHowLoudlyYouHearTheMicrophoneDuring}" />
                        </i:Interaction.Behaviors>
                    </Slider>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding AudioTesting.MonitorVolumeText}" />
                </Grid>
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource MutedTextBrush}"
                    Text="{loc:LocBinding AudioTesting.MonitorFallbackNotice, Choice=True}"
                    TextWrapping="Wrap"
                    Visibility="{Binding AudioTesting.HasMonitorFallbackNotice, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Margin="0,10,0,0"
                    Foreground="{DynamicResource MutedTextBrush}"
                    Text="{loc:Loc Ui_AudioStaysOnThisPCAndIsNot}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
