<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:b="clr-namespace:AudioPilot.Behaviors"
    xmlns:h="clr-namespace:AudioPilot.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="AudioPilot.Views.SettingsGeneralPanel"
    AutomationProperties.Name="Overlay and miscellaneous settings panel"
    xmlns:logging="clr-namespace:AudioPilot.Logging">
    <UserControl.Resources>
        <h:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{DynamicResource SettingsSectionHeaderStyle}" Text="Overlay" />
        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
            <CheckBox IsChecked="{Binding SettingsOverlayEnabledDraft, Mode=TwoWay}" AutomationProperties.Name="Enable overlays">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior Text="Shows on-screen overlays for media, mute, and device switching actions." />
                </i:Interaction.Behaviors>
                <TextBlock Text="Enable overlays" TextWrapping="Wrap" />
            </CheckBox>
        </StackPanel>
        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
            <Label Width="150" VerticalAlignment="Center" Content="Overlay position:" />
            <ComboBox
                Width="170"
                AutomationProperties.Name="Overlay position"
                IsEnabled="{Binding SettingsOverlayEnabledDraft, Mode=OneWay}"
                ItemsSource="{Binding AvailableOverlayPositions}"
                SelectedItem="{Binding SettingsOverlayPositionDraft, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior Text="Chooses where overlays appear on screen. Enable overlays to change this setting." />
                </i:Interaction.Behaviors>
            </ComboBox>
        </StackPanel>
        <StackPanel Margin="0,0,0,22" Orientation="Horizontal">
            <Label Width="150" VerticalAlignment="Center" Content="Overlay duration (s):" />
            <TextBox
                Width="80"
                AutomationProperties.Name="Overlay duration in seconds"
                b:TextBoxPlaceholderBehavior.Text="3.0"
                ContextMenu="{DynamicResource EditableTextContextMenu}"
                InputScope="Number"
                IsEnabled="{Binding SettingsOverlayEnabledDraft, Mode=OneWay}"
                Text="{Binding SettingsOverlayDurationSecondsDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="How long the overlay stays visible in seconds (0.5 to 10). Enable overlays to change this setting." />
                    <b:NumericOnlyBehavior />
                </i:Interaction.Behaviors>
            </TextBox>
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="(0.5 to 10)" />
        </StackPanel>
        <TextBlock Style="{DynamicResource SettingsSectionHeaderStyle}" Text="Miscellaneous" />
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox
                Grid.Row="0"
                Grid.Column="0"
                AutomationProperties.HelpText="Checks GitHub for newer stable releases. Off by default. Shows an update link in Settings; never downloads or installs updates."
                IsChecked="{Binding SettingsCheckForUpdatesDraft, Mode=TwoWay}"
                AutomationProperties.Name="Check for updates">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="Checks GitHub after startup and once a day while AudioPilot is running. A newer version appears below the project link in Settings. Updates are downloaded and installed manually." />
                </i:Interaction.Behaviors>
                <TextBlock Text="Check for updates" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Grid.Row="0"
                Grid.Column="1"
                IsChecked="{Binding SettingsAutoScrollToMixerOnRestoreDraft, Mode=TwoWay}"
                AutomationProperties.Name="Auto-scroll to mixer on restore">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="Scrolls to the mixer when restoring the app window with Output or Input selected." />
                </i:Interaction.Behaviors>
                <TextBlock Text="Auto-scroll to mixer on restore" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,8,0,0"
                AutomationProperties.HelpText="Play sounds for AudioPilot dialogs and tray notifications."
                AutomationProperties.Name="Play app sounds"
                IsChecked="{Binding SettingsPlayAppSoundsDraft, Mode=TwoWay}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="Plays sounds for AudioPilot dialogs and tray notifications. Turn off to keep both silent. Sounds follow Windows sound and notification settings." />
                </i:Interaction.Behaviors>
                <TextBlock Text="Play app sounds" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,8,0,0"
                IsChecked="{Binding SettingsAutoSaveEnabledDraft, Mode=TwoWay}"
                AutomationProperties.Name="Enable auto-save">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="Automatically saves device, hotkey, routine, and settings changes. Click Apply Settings to turn auto-save on or off." />
                </i:Interaction.Behaviors>
                <TextBlock Text="Enable auto-save" TextWrapping="Wrap" />
            </CheckBox>
        </Grid>
        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
            <Label Width="150" VerticalAlignment="Center" Content="Device reference:" />
            <ComboBox
                Width="170"
                AutomationProperties.Name="Device reference file mode"
                ItemsSource="{Binding AvailableDeviceReferenceFileModes}"
                SelectedItem="{Binding SettingsDeviceReferenceFileModeDraft, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="Controls what DEVICES.txt contains: Off disables file generation, Plaintext includes device names, endpoint IDs and available stable IDs, and Hashed hashes both types of ID while keeping device names." />
                </i:Interaction.Behaviors>
            </ComboBox>
        </StackPanel>
        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
            <Label Width="150" VerticalAlignment="Center" Content="Log level:" />
            <ComboBox
                Width="170"
                AutomationProperties.Name="Log level"
                ItemsSource="{Binding AvailableLogLevels}"
                SelectedItem="{Binding SettingsLogLevelDraft, Mode=TwoWay}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="Choose how detailed logs are.&#10;None disables logging and removes&#10;existing log files when applied." />
                </i:Interaction.Behaviors>
            </ComboBox>
        </StackPanel>
        <TextBlock
            Text="None clears existing log files when applied."
            TextWrapping="Wrap"
            Margin="150,0,0,12"
            Foreground="{DynamicResource DialogWarningBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SettingsLogLevelDraft}" Value="{x:Static logging:LogLevel.None}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <WrapPanel Margin="0,0,0,14">
            <CheckBox
                Margin="0,0,12,8"
                AutomationProperties.HelpText="May make AudioPilot and its hotkeys available sooner after sign-in. Requires Run at startup. This preference is remembered while startup is off."
                IsChecked="{Binding SettingsUseScheduledStartupDraft, Mode=TwoWay}"
                IsEnabled="{Binding RunAtStartup}"
                AutomationProperties.Name="Task Scheduler for startup">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="May make AudioPilot and its hotkeys available sooner after sign-in. Requires Run at startup. This preference is remembered while startup is off." />
                </i:Interaction.Behaviors>
                <TextBlock Text="Task Scheduler for startup" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Margin="0,0,0,8"
                IsChecked="{Binding SettingsRedactLogContentDraft, Mode=TwoWay}"
                AutomationProperties.Name="Redact sensitive log content">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="When applied, redacts known sensitive fields in new log entries, including device names, paths, and IDs. Existing log files are not rewritten." />
                </i:Interaction.Behaviors>
                <TextBlock Text="Redact sensitive log content" TextWrapping="Wrap" />
            </CheckBox>
        </WrapPanel>
    </StackPanel>
</UserControl>
