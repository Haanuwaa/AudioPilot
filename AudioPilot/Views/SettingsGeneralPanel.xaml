<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:b="clr-namespace:AudioPilot.Behaviors"
    xmlns:loc="clr-namespace:AudioPilot.Localization"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="AudioPilot.Views.SettingsGeneralPanel"
    AutomationProperties.Name="{loc:Loc Settings_PanelName}"
    xmlns:logging="clr-namespace:AudioPilot.Logging">

    <StackPanel>
        <TextBlock Style="{DynamicResource SettingsSectionHeaderStyle}" Text="{loc:Loc Settings_Overlay}" />
        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
            <CheckBox IsChecked="{Binding SettingsOverlayEnabledDraft, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_EnableOverlay}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior Text="{loc:Loc Settings_OverlayHelp}" />
                </i:Interaction.Behaviors>
                <TextBlock Text="{loc:Loc Settings_EnableOverlay}" TextWrapping="Wrap" />
            </CheckBox>
        </StackPanel>
        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
            <Label Width="150" VerticalAlignment="Center" Content="{loc:Loc Settings_PositionLabel}" />
            <ComboBox
                Width="{DynamicResource SettingsFieldWidth}"
                AutomationProperties.Name="{loc:Loc Settings_PositionName}"
                IsEnabled="{Binding SettingsOverlayEnabledDraft, Mode=OneWay}"
                ItemsSource="{Binding AvailableOverlayPositions}"
                SelectedItem="{Binding SettingsOverlayPositionDraft, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{loc:LocBinding .}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior Text="{loc:Loc Settings_PositionHelp}" />
                </i:Interaction.Behaviors>
            </ComboBox>
        </StackPanel>
        <StackPanel Margin="0,0,0,22" Orientation="Horizontal">
            <Label Width="150" VerticalAlignment="Center" Content="{loc:Loc Settings_DurationLabel}" />
            <TextBox
                Width="80"
                AutomationProperties.Name="{loc:Loc Settings_DurationName}"
                b:TextBoxPlaceholderBehavior.Text="3.0"
                ContextMenu="{DynamicResource EditableTextContextMenu}"
                InputScope="Number"
                IsEnabled="{Binding SettingsOverlayEnabledDraft, Mode=OneWay}"
                Text="{Binding SettingsOverlayDurationSecondsDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                                                        Text="{loc:LocBinding SettingsFieldGuidance[SettingsOverlayDurationSecondsDraft]}" />
                    <b:NumericOnlyBehavior />
                </i:Interaction.Behaviors>
            </TextBox>
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="{loc:Loc Settings_DurationRange}" />
        </StackPanel>
        <TextBlock Style="{DynamicResource SettingsSectionHeaderStyle}" Text="{loc:Loc Settings_Miscellaneous}" />
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox
                Margin="0,0,8,0"
                VerticalAlignment="Top"
                IsChecked="{Binding SettingsAutoScrollToMixerOnRestoreDraft, Mode=TwoWay}"
                AutomationProperties.Name="{loc:Loc Settings_AutoScroll}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior Text="{loc:Loc Settings_AutoScrollHelp}" />
                </i:Interaction.Behaviors>
                <TextBlock Text="{loc:Loc Settings_AutoScroll}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                x:Name="SuppressDeviceStartupWarningsCheckBox"
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Top"
                IsChecked="{Binding SettingsSuppressDeviceStartupWarningsDraft, Mode=TwoWay}"
                AutomationProperties.Name="{loc:Loc Settings_SuppressDeviceStartupWarnings}"
                AutomationProperties.HelpText="{loc:Loc Settings_SuppressDeviceStartupWarningsHelp}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior Text="{loc:Loc Settings_SuppressDeviceStartupWarningsHelp}" />
                </i:Interaction.Behaviors>
                <TextBlock Text="{loc:Loc Settings_SuppressDeviceStartupWarnings}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,8,8,0"
                AutomationProperties.HelpText="{loc:Loc Settings_SoundsAccessibleHelp}"
                AutomationProperties.Name="{loc:Loc Settings_Sounds}"
                IsChecked="{Binding SettingsPlayAppSoundsDraft, Mode=TwoWay}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="{loc:Loc Settings_SoundsHelp}" />
                </i:Interaction.Behaviors>
                <TextBlock Text="{loc:Loc Settings_Sounds}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="8,8,0,0"
                IsChecked="{Binding SettingsAutoSaveEnabledDraft, Mode=TwoWay}"
                AutomationProperties.Name="{loc:Loc Settings_AutoSave}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="{loc:Loc Settings_AutoSaveHelp}" />
                </i:Interaction.Behaviors>
                <TextBlock Text="{loc:Loc Settings_AutoSave}" TextWrapping="Wrap" />
            </CheckBox>
        </Grid>
        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
            <Label Width="150" VerticalAlignment="Center" Content="{loc:Loc Settings_ReferenceLabel}" />
            <ComboBox
                Width="{DynamicResource SettingsFieldWidth}"
                AutomationProperties.Name="{loc:Loc Settings_ReferenceName}"
                ItemsSource="{Binding AvailableDeviceReferenceFileModes}"
                SelectedItem="{Binding SettingsDeviceReferenceFileModeDraft, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{loc:LocBinding .}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="{loc:Loc Settings_ReferenceHelp}" />
                </i:Interaction.Behaviors>
            </ComboBox>
        </StackPanel>
        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
            <Label Width="150" VerticalAlignment="Center" Content="{loc:Loc Settings_LogLabel}" />
            <ComboBox
                Width="{DynamicResource SettingsFieldWidth}"
                AutomationProperties.Name="{loc:Loc Settings_LogName}"
                ItemsSource="{Binding AvailableLogLevels}"
                SelectedItem="{Binding SettingsLogLevelDraft, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:LocBinding .}" /></DataTemplate></ComboBox.ItemTemplate>
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="{loc:Loc Settings_LogHelp}" />
                </i:Interaction.Behaviors>
            </ComboBox>
        </StackPanel>
        <TextBlock
            Text="{loc:Loc Settings_LogWarning}"
            TextWrapping="Wrap"
            Margin="150,0,0,12"
            Foreground="{DynamicResource DialogWarningBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SettingsLogLevelDraft}" Value="{x:Static logging:LogLevel.None}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <WrapPanel Margin="0,0,0,14">
            <CheckBox
                Margin="0,0,12,8"
                AutomationProperties.HelpText="{loc:Loc Settings_SchedulerHelp}"
                IsChecked="{Binding SettingsUseScheduledStartupDraft, Mode=TwoWay}"
                IsEnabled="{Binding RunAtStartup}"
                AutomationProperties.Name="{loc:Loc Settings_Scheduler}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="{loc:Loc Settings_SchedulerHelp}" />
                </i:Interaction.Behaviors>
                <TextBlock Text="{loc:Loc Settings_Scheduler}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Margin="0,0,0,8"
                IsChecked="{Binding SettingsRedactLogContentDraft, Mode=TwoWay}"
                AutomationProperties.Name="{loc:Loc Settings_Redaction}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="{loc:Loc Settings_RedactionHelp}" />
                </i:Interaction.Behaviors>
                <TextBlock Text="{loc:Loc Settings_Redaction}" TextWrapping="Wrap" />
            </CheckBox>
        </WrapPanel>
    </StackPanel>
</UserControl>
