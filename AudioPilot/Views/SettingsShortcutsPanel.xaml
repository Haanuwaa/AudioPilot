                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsMicVolumeUpHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsMicVolumeUpHotkeyDraftCapture.WarningKind}" />
