                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsHoldToMuteHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsHoldToMuteHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsHoldToMuteHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsHoldToMuteHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsHoldToMuteHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsHoldToMuteHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
            </StackPanel>
        </Expander>
        <Expander
            AutomationProperties.Name="{loc:Loc Ui_OutputVolume}"
            IsExpanded="{Binding SettingsMasterVolumeControlsExpanded, Mode=TwoWay}"
            Style="{DynamicResource SettingsExpanderStyle}">
            <Expander.Header>
                <TextBlock FontWeight="SemiBold" Text="{loc:Loc Ui_OutputVolume}" />
            </Expander.Header>
            <StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_OutputVolumeUp}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
