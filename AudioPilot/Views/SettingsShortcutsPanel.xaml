<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:b="clr-namespace:AudioPilot.Behaviors"
    xmlns:h="clr-namespace:AudioPilot.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:loc="clr-namespace:AudioPilot.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="AudioPilot.Views.SettingsShortcutsPanel"
    AutomationProperties.Name="{loc:Loc Ui_GlobalHotkeys}">
    <StackPanel>
        <TextBlock Style="{DynamicResource SettingsSectionHeaderStyle}" Text="{loc:Loc Ui_GlobalHotkeys}" />
        <TextBlock
            Margin="0,0,0,10"
            Foreground="{DynamicResource MutedTextBrush}"
            Text="{loc:Loc Ui_LeaveAShortcutBlankToDisableIt}" />
        <Expander x:Name="AppShortcutsExpander" AutomationProperties.Name="{loc:Loc Ui_App}" IsExpanded="{Binding SettingsAppShortcutsExpanded, Mode=TwoWay}" Style="{DynamicResource SettingsExpanderStyle}">
            <Expander.Header><TextBlock FontWeight="SemiBold" Text="{loc:Loc Ui_App}" /></Expander.Header>
            <StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_ShowHideApp}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_ShowOrHideAppHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsToggleAppVisibilityHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsToggleAppVisibilityHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsToggleAppVisibilityHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsToggleAppVisibilityHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsToggleAppVisibilityHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsToggleAppVisibilityHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_ShowAudioStatus}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_ShowAudioStatusHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsShowAudioStatusHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsShowAudioStatusHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsShowAudioStatusHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsShowAudioStatusHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsShowAudioStatusHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsShowAudioStatusHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_DevicePicker}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_QuickDevicePickerHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsQuickDevicePickerHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsQuickDevicePickerHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsQuickDevicePickerHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsQuickDevicePickerHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsQuickDevicePickerHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsQuickDevicePickerHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_QuickMixerLabel}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_VolumeMixerHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsVolumeMixerHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsVolumeMixerHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsVolumeMixerHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsVolumeMixerHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsVolumeMixerHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsVolumeMixerHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
            </StackPanel>
        </Expander>
        <Expander x:Name="MediaShortcutsExpander" AutomationProperties.Name="{loc:Loc Ui_Media}" IsExpanded="{Binding SettingsMediaShortcutsExpanded, Mode=TwoWay}" Style="{DynamicResource SettingsExpanderStyle}">
