                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_SeekBackward}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_SeekBackwardHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsSeekBackwardHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsSeekBackwardHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsSeekBackwardHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsSeekBackwardHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsSeekBackwardHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsSeekBackwardHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_SeekStep}" />
                    <TextBox VerticalAlignment="Center"
                        Width="110"
                        AutomationProperties.Name="{loc:Loc Ui_MediaSeekStepDuration}"
                        ContextMenu="{DynamicResource EditableTextContextMenu}"
                        Text="{Binding SettingsSeekStepSecondsDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}">
                        <i:Interaction.Behaviors>
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsFieldGuidance[SettingsSeekStepSecondsDraft]}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
            </StackPanel>
        </Expander>
        <Expander x:Name="MuteShortcutsExpander" AutomationProperties.Name="{loc:Loc Ui_MuteControls}" IsExpanded="{Binding SettingsMuteShortcutsExpanded, Mode=TwoWay}" Style="{DynamicResource SettingsExpanderStyle}">
            <Expander.Header><TextBlock FontWeight="SemiBold" Text="{loc:Loc Ui_MuteControls}" /></Expander.Header>
            <StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_MicrophoneMute}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_ToggleMicrophoneMuteHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsMuteMicHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsMuteMicHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsMuteMicHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsMuteMicHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsMuteMicHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsMuteMicHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_OutputMute}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_ToggleSoundMuteHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsMuteSoundHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsMuteSoundHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsMuteSoundHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsMuteSoundHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsMuteSoundHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsMuteSoundHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_Deafen}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_ToggleDeafenHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsDeafenHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsDeafenHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsDeafenHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsDeafenHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsDeafenHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsDeafenHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
            </StackPanel>
        </Expander>
        <Expander
            AutomationProperties.Name="{loc:Loc Ui_WhileHoldingAKey}"
            IsExpanded="{Binding SettingsMicrophoneHoldControlsExpanded, Mode=TwoWay}"
            h:AppHelp.Topic="MicrophoneHolds"
            Style="{DynamicResource SettingsExpanderStyle}">
            <Expander.Header>
                <TextBlock FontWeight="SemiBold" Text="{loc:Loc Ui_WhileHoldingAKey}" />
            </Expander.Header>
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,10"
                    Foreground="{DynamicResource MutedTextBrush}"
                    TextWrapping="Wrap"
                    Text="{loc:Loc Ui_PushToTalkKeepsYourMicrophoneMutedExcept}" />
                <CheckBox
                    Margin="0,0,0,8"
                    Content="{loc:Loc Ui_EnablePushToTalk}"
                    IsChecked="{Binding SettingsPushToTalkEnabledDraft}"
                    AutomationProperties.Name="{loc:Loc Ui_EnablePushToTalk}">
                    <i:Interaction.Behaviors>
                        <b:HoverInfoPopupBehavior
                            Text="{loc:Loc Ui_KeepsTheDefaultMicrophonesMutedExceptWhileYou}" />
                    </i:Interaction.Behaviors>
                </CheckBox>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_PushToTalk}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_PushToTalkHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsPushToTalkHotkeyDraftCapture.DisplayText, Mode=OneWay}">
