                            <b:HotkeyCaptureBehavior Target="{Binding SettingsPushToTalkHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsPushToTalkHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsPushToTalkHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
