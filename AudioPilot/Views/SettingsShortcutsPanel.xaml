                                WarningKind="{Binding SettingsPreviousTrackHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsPreviousTrackHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsPreviousTrackHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsPreviousTrackHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
            </StackPanel>
        </Expander>
        <Expander
            AutomationProperties.Name="{loc:Loc Ui_SeekControls}"
            IsExpanded="{Binding SettingsSeekControlsExpanded, Mode=TwoWay}"
            Style="{DynamicResource SettingsExpanderStyle}">
            <Expander.Header>
                <TextBlock FontWeight="SemiBold" Text="{loc:Loc Ui_Seek}" />
            </Expander.Header>
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,10"
                    Foreground="{DynamicResource MutedTextBrush}"
                    TextWrapping="Wrap"
                    Text="{loc:Loc Ui_SkipForwardOrBackwardByTheChosenDuration}" />
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_SeekForward}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_SeekForwardHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsSeekForwardHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsSeekForwardHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsSeekForwardHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsSeekForwardHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
