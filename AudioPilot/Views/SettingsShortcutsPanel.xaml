                    <TextBox VerticalAlignment="Center"
                        Width="80"
                        AutomationProperties.Name="{loc:Loc Ui_MicrophoneVolumeStepPercent}"
                        b:TextBoxPlaceholderBehavior.Text="5"
                        ContextMenu="{DynamicResource EditableTextContextMenu}"
                        InputScope="Number"
                        Text="{Binding SettingsMicVolumeStepPercentDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}">
                        <i:Interaction.Behaviors>
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsFieldGuidance[SettingsMicVolumeStepPercentDraft]}" />
                            <b:IntegerOnlyBehavior />
                        </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MutedTextBrush}"
                        Text="{loc:Loc Ui_VolumeStepRange}" />
                </StackPanel>
            </StackPanel>
        </Expander>
        <Expander
            AutomationProperties.Name="{loc:Loc Ui_ForegroundApp}"
            h:AppHelp.Topic="ForegroundAudio"
            IsExpanded="{Binding SettingsForegroundVolumeControlsExpanded, Mode=TwoWay}"
            Style="{DynamicResource SettingsExpanderStyle}">
            <Expander.Header>
                <TextBlock FontWeight="SemiBold" Text="{loc:Loc Ui_ForegroundApp}" />
            </Expander.Header>
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,10"
                    Foreground="{DynamicResource MutedTextBrush}"
                    TextWrapping="Wrap"
                    Text="{loc:Loc Ui_ControlsTheAppYouReUsingBrowsersMay}" />
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_VolumeUp}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_ForegroundAppVolumeUpHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsForegroundVolumeUpHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsForegroundVolumeUpHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsForegroundVolumeUpHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior
                                Target="{Binding SettingsForegroundVolumeUpHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsForegroundVolumeUpHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsForegroundVolumeUpHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_VolumeDown}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_ForegroundAppVolumeDownHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsForegroundVolumeDownHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsForegroundVolumeDownHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsForegroundVolumeDownHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior
                                Target="{Binding SettingsForegroundVolumeDownHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsForegroundVolumeDownHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsForegroundVolumeDownHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_ToggleMute}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_ForegroundAppMuteHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsForegroundMuteHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsForegroundMuteHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsForegroundMuteHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior
                                Target="{Binding SettingsForegroundMuteHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsForegroundMuteHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsForegroundMuteHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_Step}" />
                    <TextBox VerticalAlignment="Center"
                        Width="80"
                        AutomationProperties.Name="{loc:Loc Ui_ForegroundAppVolumeStepPercent}"
                        b:TextBoxPlaceholderBehavior.Text="5"
                        ContextMenu="{DynamicResource EditableTextContextMenu}"
                        InputScope="Number"
                        Text="{Binding SettingsForegroundVolumeStepPercentDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}">
                        <i:Interaction.Behaviors>
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsFieldGuidance[SettingsForegroundVolumeStepPercentDraft]}" />
                            <b:IntegerOnlyBehavior />
                        </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MutedTextBrush}"
                        Text="{loc:Loc Ui_VolumeStepRange}" />
                </StackPanel>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
