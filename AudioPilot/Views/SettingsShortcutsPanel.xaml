                                WarningKind="{Binding SettingsShowCurrentTrackHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsShowCurrentTrackHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsShowCurrentTrackHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsShowCurrentTrackHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_PlayPause}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_PlayOrPauseHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsPlayPauseHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsPlayPauseHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsPlayPauseHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsPlayPauseHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsPlayPauseHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsPlayPauseHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_NextTrack}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_NextTrackHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsNextTrackHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <b:HotkeyPlaceholderBehavior />
                            <b:HoverInfoPopupBehavior
                                Text="{loc:LocBinding SettingsNextTrackHotkeyDraftCapture.HoverText, Message=True}"
                                WarningKind="{Binding SettingsNextTrackHotkeyDraftCapture.WarningKind}" />
                            <b:HotkeyCaptureBehavior Target="{Binding SettingsNextTrackHotkeyDraftCapture}" />
                            <b:HotkeyWarningBorderBehavior
                                HasWarning="{Binding SettingsNextTrackHotkeyDraftCapture.HasWarning}"
                                WarningKind="{Binding SettingsNextTrackHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
