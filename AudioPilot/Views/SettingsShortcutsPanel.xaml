                                WarningKind="{Binding SettingsMasterVolumeUpHotkeyDraftCapture.WarningKind}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Style="{DynamicResource SettingsFormRowStyle}">
                    <Label Style="{DynamicResource SettingsFormLabelStyle}" Content="{loc:Loc Ui_OutputVolumeDown}" />
                    <TextBox VerticalAlignment="Center"
                        Width="{DynamicResource SettingsFieldWidth}"
                        AutomationProperties.Name="{loc:Loc Ui_MasterVolumeDownHotkey}"
                        ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                        Text="{Binding SettingsMasterVolumeDownHotkeyDraftCapture.DisplayText, Mode=OneWay}">
                        <i:Interaction.Behaviors>
