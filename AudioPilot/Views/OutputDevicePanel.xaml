<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:b="clr-namespace:AudioPilot.Behaviors"
    xmlns:h="clr-namespace:AudioPilot.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="AudioPilot.Views.OutputDevicePanel"
    AutomationProperties.Name="Output device configuration"
    Foreground="{DynamicResource TextBrush}"
    xmlns:controls="clr-namespace:AudioPilot.Controls">
    <UserControl.Resources>
        <h:WindowListHeightConverter x:Key="DeviceListHeightConverter" InitialHeight="104" InitialWindowHeight="440" RowHeight="24" />
    </UserControl.Resources>
    <StackPanel Margin="10">
        <Label Content="Available output devices:" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="AvailableDevicesComboBox"
                AutomationProperties.Name="Available output devices"
                MinWidth="140"
                ItemsSource="{Binding AvailableOutputDeviceNames}"
                SelectedIndex="{Binding SelectedAvailableOutputIndex, Mode=TwoWay}" />
            <TextBlock Text="Select an output device…" Foreground="{DynamicResource MutedTextBrush}"
                       Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=AvailableDevicesComboBox}" Value="-1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button
                Width="62"
                AutomationProperties.Name="Add selected output device"
                Margin="8,0,0,0"
                Command="{Binding AddOutputCycleDeviceCommand}"
                Content="Add"
                Grid.Column="1" />
        </Grid>
        <Label Content="Output switch order:" />
        <Grid b:ListBoxSelectedItemsBehavior.SelectionContext="{Binding SelectedOutputCycleDevices}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox
                x:Name="SwitchOrderListBox"
                AutomationProperties.Name="Output switch order"
                AutomationProperties.HelpText="Drag selected devices to reorder, or use Alt+Up and Alt+Down for one device."
                Grid.Column="0"
                MinHeight="104"
                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource DeviceListHeightConverter}}"
                Padding="3"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding OutputCycleDevices}"
                SelectedIndex="{Binding SelectedOutputCycleIndex, Mode=TwoWay}"
                SelectionMode="Extended">
                <ListBox.InputBindings>
                    <KeyBinding Key="W" Command="{Binding RemoveOutputCycleDeviceCommand}" Modifiers="Control" />
                    <KeyBinding Key="Up" Command="{Binding MoveOutputCycleDeviceUpCommand}" Modifiers="Alt" />
                    <KeyBinding Key="Down" Command="{Binding MoveOutputCycleDeviceDownCommand}" Modifiers="Alt" />
                </ListBox.InputBindings>
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource CycleDeviceListBoxItemStyle}" TargetType="ListBoxItem">
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu
                                    AutomationProperties.Name="Output device actions"
                                    DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}"
                                    Style="{DynamicResource AppContextMenuStyle}">
                                    <MenuItem
                                        AutomationProperties.Name="Test output"
                                        Command="{Binding Tag.AudioTesting.TestOutputCommand}"
                                        CommandParameter="{Binding DataContext}"
                                        Header="_Test output"
                                        Icon="{StaticResource AppMenuOutputIcon}"
                                        Style="{DynamicResource AppContextMenuItemStyle}"
                                        Visibility="{Binding Tag.AudioTesting.IsOutputTestRunning, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <MenuItem
                                        AutomationProperties.Name="Stop output test"
                                        Command="{Binding Tag.AudioTesting.StopCommand}"
                                        Header="_Stop test"
                                        Icon="{StaticResource AppMenuStopIcon}"
                                        Style="{DynamicResource AppContextMenuItemStyle}"
                                        Visibility="{Binding Tag.AudioTesting.IsOutputTestRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuItem
                                        AutomationProperties.Name="Set as default output"
                                        Command="{Binding Tag.SetDefaultOutputDeviceCommand}"
                                        CommandParameter="{Binding DataContext}"
                                        Header="Set as _default output"
                                        Icon="{StaticResource AppMenuSetDefaultIcon}"
                                        Style="{DynamicResource AppContextMenuItemStyle}" />
                                    <MenuItem
                                        Header="Open _Windows device settings"
                                        Command="{Binding Tag.OpenWindowsDeviceSettingsCommand}"
                                        CommandParameter="{Binding DataContext}"
                                        Icon="{StaticResource AppMenuSettingsIcon}"
                                        Style="{DynamicResource AppContextMenuItemStyle}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <i:Interaction.Behaviors>
                    <b:ListBoxSelectedItemsBehavior SelectedItems="{Binding SelectedOutputCycleDevices}" />
                    <b:ListBoxReorderBehavior ReorderCommand="{Binding ReorderOutputCycleDevicesCommand}" />
                </i:Interaction.Behaviors>
            </ListBox>
            <TextBlock Text="Choose a device above, then click Add." TextWrapping="Wrap"
                       Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False" Focusable="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=SwitchOrderListBox}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button Height="30" Margin="0,0,0,4" Command="{Binding MoveOutputCycleDeviceUpCommand}" AutomationProperties.Name="Move up">
                    <Path
                        Width="14"
                        Height="14"
                        Data="{x:Static controls:AppMenuGlyphs.MoveUp}"
                        Stretch="Uniform"
                        StrokeThickness="1.25"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Focusable="False"
                        IsHitTestVisible="False" />
                    <i:Interaction.Behaviors>
                        <b:HoverInfoPopupBehavior Text="Move up" />
                    </i:Interaction.Behaviors>
                </Button>
                <Button
                    Height="30"
                    Margin="0,0,0,4"
                    Command="{Binding MoveOutputCycleDeviceDownCommand}"
                    AutomationProperties.Name="Move down">
                    <Path
                        Width="14"
                        Height="14"
                        Data="{x:Static controls:AppMenuGlyphs.MoveDown}"
                        Stretch="Uniform"
                        StrokeThickness="1.25"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Focusable="False"
                        IsHitTestVisible="False" />
                    <i:Interaction.Behaviors>
                        <b:HoverInfoPopupBehavior Text="Move down" />
                    </i:Interaction.Behaviors>
                </Button>
                <Button Height="30" Command="{Binding RemoveOutputCycleDeviceCommand}" Content="Remove" />
            </StackPanel>
        </Grid>
        <Border
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Output test status"
            Margin="0,8,0,0"
            Padding="8"
            Background="{DynamicResource ControlBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="{Binding AudioTesting.IsOutputTestStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel LastChildFill="True">
                <Button
                    AutomationProperties.Name="Stop or dismiss output test"
                    DockPanel.Dock="Right"
                    MinWidth="62"
                    Margin="8,0,0,0"
                    Command="{Binding AudioTesting.StopCommand}"
                    Content="{Binding AudioTesting.ActionText}" />
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding AudioTesting.EndpointName}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding AudioTesting.Status}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Label Content="Hotkey:" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                AutomationProperties.Name="Output switching hotkey"
                Grid.Column="0"
                ContextMenu="{DynamicResource HotkeyDeleteContextMenu}"
                IsEnabled="{Binding OutputHotkeysEnabled, Mode=TwoWay}"
                Text="{Binding Hotkey.DisplayText, Mode=OneWay}">
                <i:Interaction.Behaviors>
                    <b:PlaceholderExampleBehavior
                        Identity="output-hotkey"
                        Options="Ctrl+Alt+O|Alt+Period|Ctrl+Alt+Right"
                        PreferredFamily="letter" />
                    <b:HoverInfoPopupBehavior Text="{Binding Hotkey.HoverText}" WarningKind="{Binding Hotkey.WarningKind}" />
                    <b:HotkeyCaptureBehavior Target="{Binding Hotkey}" />
                    <b:HotkeyWarningBorderBehavior HasWarning="{Binding Hotkey.HasWarning}" WarningKind="{Binding Hotkey.WarningKind}" />
                </i:Interaction.Behaviors>
            </TextBox>
            <CheckBox
                Grid.Column="1"
                AutomationProperties.Name="Enable output switching hotkey"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Content="Enabled"
                IsChecked="{Binding OutputHotkeysEnabled, Mode=TwoWay}">
                <i:Interaction.Behaviors>
                    <b:HoverInfoPopupBehavior
                        Text="Enable or disable saved forward and reverse output hotkeys immediately. Save to keep this choice after restarting, unless auto-save is on." />
                </i:Interaction.Behaviors>
            </CheckBox>
        </Grid>
    </StackPanel>
</UserControl>
