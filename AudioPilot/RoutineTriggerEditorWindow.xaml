<Window x:Class="AudioPilot.RoutineTriggerEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AudioPilot.Localization"
    xmlns:b="clr-namespace:AudioPilot.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    Title="{loc:LocBinding TriggerEditorHeading, Choice=True}" Width="520" Height="620" MinWidth="400" MinHeight="420"
    FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" ShowInTaskbar="False"
    ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual"
    FocusManager.FocusedElement="{Binding ElementName=TriggerTypeBox}"
    Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Help" Executed="OpenHelp_Executed" /></Window.CommandBindings>
    <Window.InputBindings><KeyBinding Key="F1" Command="ApplicationCommands.Help" /></Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary Source="Themes/RoutineEditorResources.xaml" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{loc:LocBinding TriggerEditorHeading, Choice=True}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Ui_ChooseWhenThisRoutineStartsSaveTheRoutine}"
                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <ScrollViewer x:Name="TriggerEditorScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <i:Interaction.Behaviors>
                <b:KeyboardFocusScrollBehavior />
                <b:KeepScrollOnLanguageChangeBehavior />
            </i:Interaction.Behaviors>
            <StackPanel x:Name="TriggerEditorPanel" Margin="0,0,12,0">
                <TextBlock Margin="0,0,0,4" Text="{loc:Loc Ui_TriggerType}" />
                <ComboBox
                    MaxWidth="450"
                    Height="32"
                    Margin="0,0,0,10"
                    x:Name="TriggerTypeBox"
                    AutomationProperties.Name="{loc:Loc Ui_AutomaticTrigger}"
                    ItemsSource="{Binding AvailableTriggerModes}"
                    SelectedItem="{Binding SelectedTriggerMode, Mode=TwoWay}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:LocBinding ., Choice=True}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                <Border
                    Margin="0,0,0,10"
                    Padding="0"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="6"
                    Visibility="{Binding IsApplicationTriggerSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" Text="{loc:Loc Ui_RunWhen}" />
                        <ComboBox
                            MaxWidth="450"
                            Height="32"
                            Margin="0,0,0,10"
                            AutomationProperties.Name="{loc:Loc Ui_ApplicationTriggerMode}"
                            ItemsSource="{Binding ApplicationTriggerModeOptions}"
                            SelectedItem="{Binding SelectedApplicationTriggerMode, Mode=TwoWay}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:LocBinding ., Choice=True}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock
                            Margin="0,0,0,4"
                            Text="{loc:Loc Ui_Application}"
                            Visibility="{Binding ShowApplicationTriggerPathInput, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Grid MaxWidth="450" Visibility="{Binding ShowApplicationTriggerPathInput, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBox
                                x:Name="ApplicationTargetTextBox"
                                Height="32"
                                b:TextBoxPlaceholderBehavior.Text="{loc:Loc Ui_EGCAppsGameGameExe}"
                                AutomationProperties.Name="{loc:Loc Ui_ApplicationTargetPathOrAUMID}"
                                VerticalContentAlignment="Center"
                                ContextMenu="{StaticResource EditableTextContextMenu}"
                                Text="{Binding TriggerAppPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Behaviors>
                                    <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_PasteAFullExePathOrPackagedApp}" />
                                </i:Interaction.Behaviors>
                            </TextBox>
                            <StackPanel x:Name="ApplicationPickerButtons" Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Button Height="32" MinWidth="72"
                                    Margin="0"
                                    Click="BrowseExecutable_Click"
                                    Content="{loc:Loc Ui_Browse}" />
                                <Button Height="32"
                                    MinWidth="84"
                                    Margin="8,0,0,0"
                                    AutomationProperties.HelpText="{loc:Loc Ui_PickAnInstalledMicrosoftStoreOrUWPApp}"
                                    Click="PickPackagedApp_Click"
                                    Content="{loc:Loc Ui_PickApp}">
                                    <i:Interaction.Behaviors>
                                        <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_PickAnInstalledMicrosoftStoreOrUWPApp}" />
                                    </i:Interaction.Behaviors>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            x:Name="ResolvedAppTargetText"
                            MaxWidth="450"
                            Margin="0,6,0,0"
                            Foreground="{DynamicResource MutedTextBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasResolvedTriggerAppTarget, Converter={StaticResource BoolToVisibilityConverter}}"><Run Text="{loc:Loc Ui_ResolvedApp}" /><Run x:Name="ResolvedAppName" Text="{Binding ResolvedTriggerAppTargetDisplayName, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" /></TextBlock>
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsProcessFocusModeSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Margin="0,0,0,4" Text="{loc:Loc Ui_WindowTitlePatternOptional}" />
                            <TextBox
                                MaxWidth="450"
                                Height="32"
                                Margin="0,0,0,10"
                                b:TextBoxPlaceholderBehavior.Text="{loc:Loc Ui_EGTwitch}"
                                AutomationProperties.Name="{loc:Loc Ui_WindowTitlePattern}"
                                VerticalContentAlignment="Center"
                                ContextMenu="{StaticResource EditableTextContextMenu}"
                                Text="{Binding ApplicationTriggerTitlePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Behaviors>
                                    <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_MatchesWhenTheAppGainsFocusOrIts}" />
                                </i:Interaction.Behaviors>
                            </TextBox>
                            <TextBlock Margin="0,0,0,4" Text="{loc:Loc Ui_TitleMatchMode}" />
                            <ComboBox
                                MaxWidth="450"
                                Height="32"
                                AutomationProperties.Name="{loc:Loc Ui_TitleMatchMode}"
                                ItemsSource="{Binding ApplicationTriggerTitleMatchModeOptions}"
                                SelectedItem="{Binding SelectedApplicationTriggerTitleMatchMode, Mode=TwoWay}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:LocBinding ., Choice=True}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        </StackPanel>
                        <TextBlock
                            MaxWidth="450"
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource MutedTextBrush}"
                            TextAlignment="Center"
                            Text="{loc:LocBinding ApplicationTriggerLifetimeDescription, Choice=True}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding IsSteamBigPictureTriggerSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        MaxWidth="450"
                        Foreground="{DynamicResource MutedTextBrush}"
                        Text="{loc:Loc Ui_ActivatesWhenSteamBigPictureOpensRestoreOn}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Margin="0,8,0,8" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{loc:LocBinding SystemEventTriggerDescription, Choice=True}"
                           Visibility="{Binding IsSystemEventTriggerSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                <StackPanel Margin="0,0,0,10" Visibility="{Binding IsAudioPilotStartupTriggerSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        MaxWidth="450"
                        Foreground="{DynamicResource MutedTextBrush}"
                        Text="{loc:Loc Ui_RunsThisRoutineOnceWhenTheAppFinishes}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding IsDeviceAvailabilityTriggerSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource MutedTextBrush}" Text="{loc:Loc Ui_RunWhenThisDeviceConnectsOrDisconnects}" TextWrapping="Wrap">
                        <i:Interaction.Behaviors>
                            <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_OpeningAudioPilotDoesNotCountAsConnectingA}" />
                        </i:Interaction.Behaviors>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,4" Text="{loc:Loc Ui_AudioDevice}" />
                    <ComboBox Height="32" Margin="0,0,0,10" AutomationProperties.Name="{loc:Loc Ui_AvailabilityTriggerDevice}"
                              ItemsSource="{Binding RoutineDeviceChoices}"
                              SelectedItem="{Binding SelectedAvailabilityDevice, Mode=TwoWay}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:LocBinding DisplayLabel}" /></DataTemplate></ComboBox.ItemTemplate>
                        <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{loc:LocBinding SelectedAvailabilityDevice.DisplayLabel}" /></i:Interaction.Behaviors>
                    </ComboBox>
                    <TextBlock Margin="0,0,0,4" Text="{loc:Loc Ui_RunOn}" />
                    <ComboBox Height="32" AutomationProperties.Name="{loc:Loc Ui_DeviceAvailabilityTransition}"
                              ItemsSource="{Binding DeviceTransitions}" SelectedItem="{Binding DeviceTransition, Mode=TwoWay}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:LocBinding .}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding IsDeviceChangeTriggerSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        MaxWidth="450"
                        Foreground="{DynamicResource MutedTextBrush}"
                        Text="{loc:Loc Ui_RunsAfterDeviceRefreshFinishesForAHotplug}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Border
                    Margin="0,0,0,10"
                    Padding="0"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="6"
                    Visibility="{Binding IsNetworkTriggerSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            FontWeight="SemiBold"
                            Text="{loc:Loc Ui_Network}" />
                        <TextBlock
                            MaxWidth="450"
                            Margin="0,0,0,10"
                            Foreground="{DynamicResource MutedTextBrush}"
                            Text="{loc:Loc Ui_RunsWhenThisPCConnectsToOrDisconnects}"
                            TextWrapping="Wrap" />
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Margin="0,0,0,4" Text="{loc:Loc Ui_TriggerDirection}" />
                            <ComboBox
                                MaxWidth="450"
                                Height="32"
                                AutomationProperties.Name="{loc:Loc Ui_NetworkTriggerDirection}"
                                ItemsSource="{Binding NetworkTriggerDirectionOptions}"
                                SelectedValue="{Binding NetworkTriggerDirection}"
                                SelectedValuePath="Key">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:LocBinding Value, Choice=True}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" Text="{loc:Loc Ui_NetworkNameOptionalForDisconnect}" />
                            <Grid MaxWidth="450">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Grid.Column="0"
                                    Height="32"
                                    x:Name="TriggerNetworkBox"
                                    b:TextBoxPlaceholderBehavior.Text="{loc:Loc Ui_SelectOrTypeANetworkName}"
                                    DropDownOpened="NetworkPicker_DropDownOpened"
                                    AutomationProperties.Name="{loc:Loc Ui_NetworkName}"
                                    IsEditable="True"
                                    ItemsSource="{Binding AvailableNetworkNames}"
                                    SelectedItem="{Binding SelectedAvailableNetworkName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Text="{Binding TriggerNetworkName, UpdateSourceTrigger=PropertyChanged}">
                                    <i:Interaction.Behaviors>
                                        <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_EnterANetworkNameOrSelectOneNames}" />
                                    </i:Interaction.Behaviors>
                                </ComboBox>
                                <Button x:Name="TriggerNetworkRefreshButton" Grid.Column="1" AutomationProperties.Name="{loc:Loc Ui_RefreshNetworks}" Style="{StaticResource NetworkRefreshButtonStyle}">
                                    <i:Interaction.Behaviors><b:HoverInfoPopupBehavior Text="{loc:Loc Ui_RefreshNetworks}" /></i:Interaction.Behaviors>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border
                    Margin="0,0,0,10"
                    Padding="0"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="6"
                    Visibility="{Binding IsScheduledTriggerSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            FontWeight="SemiBold"
                            Text="{loc:Loc Ui_Schedule}" />
                        <TextBlock
                            MaxWidth="450"
                            Margin="0,0,0,10"
                            Foreground="{DynamicResource MutedTextBrush}"
                            Text="{loc:Loc Ui_RunAtThisTimeOnTheSelectedDays}"
                            TextWrapping="Wrap">
                            <i:Interaction.Behaviors>
                                <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_TheRoutineKeepsTheDisplayedTimeZoneDuring}" />
                            </i:Interaction.Behaviors>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,4" Text="{loc:Loc Ui_Time}" />
                        <Grid MaxWidth="450" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Grid.Column="0"
                                Height="32"
                                MaxDropDownHeight="224"
                                AutomationProperties.Name="{loc:Loc Ui_ScheduledHour}"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding HourOptions}"
                                SelectedIndex="{Binding ScheduleHourIndex, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0,8,0"
                                VerticalAlignment="Center"
                                Text=":" />
                            <ComboBox
                                Grid.Column="2"
                                Height="32"
                                MaxDropDownHeight="224"
                                AutomationProperties.Name="{loc:Loc Ui_ScheduledMinute}"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding MinuteOptions}"
                                SelectedIndex="{Binding ScheduleMinuteIndex, Mode=TwoWay}" />
                            <ComboBox
                                Grid.Column="3"
                                Width="92"
                                Height="32"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="{loc:Loc Ui_ScheduledAMOrPM}"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding AmPmOptions}"
                                SelectedIndex="{Binding ScheduleAmPmIndex, Mode=TwoWay}"
                                Visibility="{Binding Is24HourFormat, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </Grid>
                        <TextBlock Margin="0,0,0,4" Text="{loc:Loc Ui_DayOfWeekLeaveBlankForDaily}" />
                        <UniformGrid MaxWidth="450" Columns="4">
                            <CheckBox
                                Margin="0,0,8,4"
                                Content="{loc:Loc Ui_Sun}"
                                IsChecked="{Binding IsSundaySelected, Mode=TwoWay}" />
                            <CheckBox
                                Margin="0,0,8,4"
                                Content="{loc:Loc Ui_Mon}"
                                IsChecked="{Binding IsMondaySelected, Mode=TwoWay}" />
                            <CheckBox
                                Margin="0,0,8,4"
                                Content="{loc:Loc Ui_Tue}"
                                IsChecked="{Binding IsTuesdaySelected, Mode=TwoWay}" />
                            <CheckBox
                                Margin="0,0,8,4"
                                Content="{loc:Loc Ui_Wed}"
                                IsChecked="{Binding IsWednesdaySelected, Mode=TwoWay}" />
                            <CheckBox
                                Margin="0,0,8,4"
                                Content="{loc:Loc Ui_Thu}"
                                IsChecked="{Binding IsThursdaySelected, Mode=TwoWay}" />
                            <CheckBox
                                Margin="0,0,8,4"
                                Content="{loc:Loc Ui_Fri}"
                                IsChecked="{Binding IsFridaySelected, Mode=TwoWay}" />
                            <CheckBox
                                Margin="0,0,0,4"
                                Content="{loc:Loc Ui_Sat}"
                                IsChecked="{Binding IsSaturdaySelected, Mode=TwoWay}" />
                        </UniformGrid>
                        <TextBlock
                            MaxWidth="450"
                            Margin="0,10,0,0"
                            AutomationProperties.Name="{loc:Loc Ui_ScheduledRoutineTimeZone}"
                            AutomationProperties.HelpText="{Binding ScheduleTimeZoneDetails}"
                            Foreground="{DynamicResource MutedTextBrush}"
                            Text="{loc:LocBinding ScheduleTimeZoneDisplayName, Format=Routine_TimeZone}"
                            TextTrimming="CharacterEllipsis">
                            <i:Interaction.Behaviors>
                                <b:HoverInfoPopupBehavior Text="{Binding ScheduleTimeZoneDetails}" />
                            </i:Interaction.Behaviors>
                        </TextBlock>
                        <CheckBox
                            Margin="0,10,0,0"
                            Content="{loc:Loc Ui_NotifyMe1MinuteBefore}"
                            AutomationProperties.HelpText="{loc:Loc Ui_ShowATrayReminderBeforeThisRoutineRuns}"
                            IsChecked="{Binding NotifyBeforeScheduledRun, Mode=TwoWay}">
                            <i:Interaction.Behaviors>
                                <b:HoverInfoPopupBehavior Text="{loc:Loc Ui_ShowATrayReminderBeforeThisRoutineRuns}" />
                            </i:Interaction.Behaviors>
                        </CheckBox>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="NetworkDiscoveryWarningText" Text="{loc:LocBinding NetworkDiscoveryWarning, Message=True}" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding NetworkDiscoveryWarning}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="TriggerValidationMessage" Text="{loc:LocBinding TriggerEditorErrorText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource DialogWarningBrush}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                    <DataTrigger Binding="{Binding TriggerEditorError}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="88" Content="{loc:Loc Ui_Cancel}" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="ConfirmTriggerButton" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="110" Content="{loc:LocBinding TriggerEditorConfirmText, Choice=True}"
                        IsDefault="True" Click="ConfirmTrigger_Click" AutomationProperties.Name="{loc:Loc Ui_ConfirmTrigger}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
