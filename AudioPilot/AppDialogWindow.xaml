<Window
    x:Class="AudioPilot.AppDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
    Title="AudioPilot"
    Width="440"
    MinWidth="340"
    MaxWidth="640"
    MaxHeight="560"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStyle="SingleBorderWindow"
    ShowInTaskbar="False"
    Icon="pack://application:,,,/AudioPilot;component/Images/sound.ico"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}"
    FontFamily="Segoe UI"
    FontSize="13"
    automation:AutomationProperties.Name="AudioPilot dialog"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="DialogActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogPrimaryActionForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSelectionHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentSelectionHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogDestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ResetButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ResetButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogDestructiveActionForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ResetButtonHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ResetButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ResetButtonPressedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ResetButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="34"
                Height="34"
                Margin="0,1,12,0"
                CornerRadius="17"
                Background="{DynamicResource DialogIconBackgroundBrush}"
                automation:AutomationProperties.IsOffscreenBehavior="Onscreen">
                <Path
                    x:Name="KindIcon"
                    Width="19"
                    Height="19"
                    Stretch="Uniform"
                    Fill="{DynamicResource DialogIconForegroundBrush}"
                    Data="M10,1 A9,9 0 1 1 9.99,1 M9,5 H11 V7 H9 Z M9,9 H11 V15 H9 Z" />
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock
                    x:Name="CaptionText"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextBrush}"
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="MessageText"
                    Margin="0,8,0,0"
                    Padding="0"
                    MaxHeight="390"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource TextBrush}"
                    IsReadOnly="True"
                    IsReadOnlyCaretVisible="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    automation:AutomationProperties.LiveSetting="Polite" />
                <TextBlock
                    x:Name="RepeatText"
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource MutedTextBrush}"
                    Visibility="Collapsed"
                    automation:AutomationProperties.LiveSetting="Polite" />
                <TextBlock
                    x:Name="CopyStatusText"
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource DialogInformationBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"
                    automation:AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,16,0,12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="CopyButton"
                MinWidth="76"
                MinHeight="32"
                Padding="12,5"
                Click="CopyButton_Click"
                Content="_Copy"
                Visibility="Collapsed"
                automation:AutomationProperties.Name="Copy dialog message"
                automation:AutomationProperties.HelpText="Copies only the displayed dialog message to the clipboard." />
            <WrapPanel
                x:Name="ActionsPanel"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal" />
        </Grid>
    </Grid>
</Window>
