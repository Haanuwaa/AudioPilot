<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AudioPilot</RootNamespace>
    <NeutralLanguage>en</NeutralLanguage>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Description>AudioPilot core audio, routines, settings, and CLI library</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DeploymentType" Value="Self-contained" Condition="'$(SelfContained)' == 'true'" />
    <AssemblyMetadata Include="DeploymentType" Value="Framework-dependent" Condition="'$(SelfContained)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioPilot.Updater\Protocol\AudioPilot.UpdateProtocol.csproj" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="System.Management" />
  </ItemGroup>
</Project>
