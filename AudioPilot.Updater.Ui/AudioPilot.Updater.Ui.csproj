<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationIcon>..\AudioPilot\Images\audiopilot.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AudioPilot\AudioPilot.csproj" />
    <ProjectReference Include="..\AudioPilot.Updater\AudioPilot.Updater.csproj" />
    <InternalsVisibleTo Include="AudioPilot.Tests" />
  </ItemGroup>
</Project>
