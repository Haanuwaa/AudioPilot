<Window x:Class="AudioPilot.Updater.Ui.UpdaterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AudioPilot Update" Width="550" Height="510" MinWidth="480" MinHeight="440"
    FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
    ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual"
    Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <DockPanel>
                <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeLabel" Text="Local test" Style="{DynamicResource AppSecondaryTextStyle}" />
                </Border>
                <TextBlock Text="AudioPilot Update" FontSize="20" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock x:Name="ModeDescription" Text="Local packages only. Live updates are disabled." Style="{DynamicResource AppSecondaryTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <StackPanel Margin="0,0,8,0">
                <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Installed" Style="{DynamicResource AppSecondaryTextStyle}" />
                        <TextBlock x:Name="InstalledText" Grid.Column="1" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Deployment" Style="{DynamicResource AppSecondaryTextStyle}" Margin="0,6,0,0" />
                        <TextBlock x:Name="DeploymentText" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="Update" Style="{DynamicResource AppSecondaryTextStyle}" Margin="0,6,0,0" />
                        <TextBlock x:Name="VersionText" Grid.Row="2" Grid.Column="1" Text="Not verified" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <Label x:Name="PackageLabel" Content="Local package" Target="{Binding ElementName=PackagePath}" Padding="0" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="PackagePath" IsReadOnly="True" IsReadOnlyCaretVisible="True" VerticalContentAlignment="Center" AutomationProperties.Name="Local update package" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="_Browse…" Click="Browse_Click" Margin="8,0,0,0" MinWidth="78" />
                </Grid>
                <TextBlock x:Name="StatusHeading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="StatusMessage" Margin="0,6,0,0" TextWrapping="Wrap" Style="{DynamicResource AppSecondaryTextStyle}" />
                <ProgressBar x:Name="PackageProgress" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="100"
                    Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBackgroundBrush}" BorderThickness="0"
                    AutomationProperties.Name="Update package progress" />
                <TextBlock x:Name="ProgressText" Margin="0,5,0,0" Style="{DynamicResource AppSecondaryTextStyle}" />
                <Expander x:Name="TechnicalDetails" Header="Details" IsExpanded="False" Style="{DynamicResource AppExpanderStyle}" Margin="0,16,0,0">
                    <TextBox x:Name="DetailsText" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="8" HorizontalScrollBarVisibility="Disabled" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="PauseButton" Content="_Pause" Click="Pause_Click" MinWidth="70" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="_Cancel" Click="Cancel_Click" Margin="8,0,0,0" MinWidth="70" />
            <Grid Grid.Column="3" Margin="8,0,0,0">
                <Button x:Name="VerifyButton" Content="_Verify package" Style="{DynamicResource AppPrimaryButtonStyle}" Click="Verify_Click" IsDefault="False" />
                <Button x:Name="InstallButton" Content="_Install and restart" Style="{DynamicResource AppPrimaryButtonStyle}" Click="Install_Click" IsDefault="False" Visibility="Collapsed" />
                <Button x:Name="RecoverButton" Content="_Retry recovery" Style="{DynamicResource AppPrimaryButtonStyle}" Click="Recover_Click" IsDefault="False" Visibility="Collapsed" />
            </Grid>
            <Button x:Name="CloseButton" Grid.Column="4" Content="Cl_ose" Click="Close_Click" Margin="8,0,0,0" MinWidth="65" IsDefault="False" />
        </Grid>
    </Grid>
</Window>
