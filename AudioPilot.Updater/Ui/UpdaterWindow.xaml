<Window x:Class="AudioPilot.Updater.Ui.UpdaterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AudioPilot.Localization;assembly=AudioPilot"
    Title="{loc:Loc Ui_AudioPilotUpdate}" Width="550" Height="480" MinWidth="480" MinHeight="440"
    FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
    ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual"
    Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <DockPanel>
                <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeLabel" Text="{loc:Loc Ui_LocalTest}" Style="{DynamicResource AppSecondaryTextStyle}" />
                </Border>
                <TextBlock Text="{loc:Loc Ui_AudioPilotUpdate}" FontSize="20" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock x:Name="ModeDescription" Text="{loc:Loc Ui_LocalPackagesOnlyLiveUpdatesAreDisabled}" Style="{DynamicResource AppSecondaryTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer x:Name="UpdateScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <StackPanel Margin="0,0,8,0">
                <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="InstalledLabel" Text="{loc:Loc Ui_Installed}" Style="{DynamicResource AppSecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="InstalledText" Grid.Column="1" Margin="12,0,0,0" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="{loc:Loc Ui_Deployment}" Style="{DynamicResource AppSecondaryTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="DeploymentText" Grid.Row="1" Grid.Column="1" Margin="12,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="{loc:Loc Ui_Update}" Style="{DynamicResource AppSecondaryTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="VersionText" Grid.Row="2" Grid.Column="1" Text="{loc:Loc Update_NotChecked}" Margin="12,6,0,0" TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <StackPanel x:Name="PackageSelectionPanel">
                    <Label x:Name="PackageLabel" Content="{loc:Loc Ui_LocalPackage}" Target="{Binding ElementName=PackagePath}" Padding="0" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="PackagePath" IsReadOnly="True" IsReadOnlyCaretVisible="False" ContextMenu="{x:Null}" VerticalContentAlignment="Center" AutomationProperties.Name="{loc:Loc Ui_LocalUpdatePackage}" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="{loc:Loc Ui_BrowseText}" Click="Browse_Click" Margin="8,0,0,0" MinWidth="78" />
                    </Grid>
                </StackPanel>
                <TextBlock x:Name="StatusHeading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="StatusMessage" Margin="0,6,0,0" TextWrapping="Wrap" Style="{DynamicResource AppSecondaryTextStyle}" />
                <ProgressBar x:Name="PackageProgress" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="100"
                    Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBackgroundBrush}" BorderThickness="0"
                    AutomationProperties.Name="{loc:Loc Ui_UpdatePackageProgress}" />
                <TextBlock x:Name="ProgressText" Margin="0,5,0,0" Style="{DynamicResource AppSecondaryTextStyle}" />
                <Expander x:Name="TechnicalDetails" Header="{loc:Loc Ui_Details}" IsExpanded="False" Style="{DynamicResource AppExpanderStyle}" Margin="0,16,0,0">
                    <TextBox x:Name="DetailsText" Style="{DynamicResource AppSelectableTextStyle}" Padding="8" AutomationProperties.Name="{loc:Loc Ui_Details}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="PauseButton" Content="{loc:Loc Ui_PauseText}" Click="Pause_Click" MinWidth="70" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="{loc:Loc Dialog_Cancel}" Click="Cancel_Click" Margin="8,0,0,0" MinWidth="70" />
            <TextBlock x:Name="ManualDownloadLink" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                <Hyperlink Click="ManualDownload_Click"><Run Text="{loc:Loc Ui_DownloadManually}" /></Hyperlink>
            </TextBlock>
            <Grid Grid.Column="3" Margin="8,0,0,0">
                <Button x:Name="VerifyButton" Content="{loc:Loc Ui_VerifyPackage}" Style="{DynamicResource AppPrimaryButtonStyle}" Click="Verify_Click" IsDefault="False" />
                <Button x:Name="InstallButton" Content="{loc:Loc Ui_UpdateAndRestart}" Style="{DynamicResource AppPrimaryButtonStyle}" Click="Install_Click" IsDefault="False" Visibility="Collapsed" />
                <Button x:Name="RecoverButton" Content="{loc:Loc Ui_RetryRecovery}" Style="{DynamicResource AppPrimaryButtonStyle}" Click="Recover_Click" IsDefault="False" Visibility="Collapsed" />
            </Grid>
            <Button x:Name="CloseButton" Grid.Column="4" Content="{loc:Loc Update_CloseButton}" Click="Close_Click" Margin="8,0,0,0" MinWidth="65" IsDefault="False" />
        </Grid>
    </Grid>
</Window>
