<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>AudioPilot.Updater.Core</AssemblyName>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);Ui\**;Protocol\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Protocol\AudioPilot.UpdateProtocol.csproj" />
    <InternalsVisibleTo Include="AudioPilot.Tests" />
    <InternalsVisibleTo Include="AudioPilot.Updater" />
  </ItemGroup>
</Project>
