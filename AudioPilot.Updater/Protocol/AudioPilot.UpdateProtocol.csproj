<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AudioPilot.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(AudioPilotUpdatePolicy)' != ''">
    <EmbeddedResource Include="$(AudioPilotUpdatePolicy)" LogicalName="AudioPilot.UpdateProtocol.PilotPolicy.json" />
  </ItemGroup>
  <Target Name="ValidateIsolatedUpdateBuild" BeforeTargets="CoreCompile" Condition="'$(AudioPilotUpdatePolicy)' != ''">
    <Error Condition="'$(BuildIsolationKey)' == ''" Text="Updater builds require an explicit BuildIsolationKey so ordinary outputs cannot inherit update authorization." />
    <Error Condition="!Exists('$(AudioPilotUpdatePolicy)')" Text="The explicit updater policy does not exist." />
  </Target>
</Project>
